animations {
    workspace-switch {
        spring damping-ratio=1.0 stiffness=2200 epsilon=0.001
    }

    horizontal-view-movement {
        spring damping-ratio=1.0 stiffness=2200 epsilon=0.001
    }

    window-movement {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-resize {
        spring damping-ratio=1.0 stiffness=800 epsilon=0.0001
    }

    window-open {
        duration-ms 70
        curve "linear"
    }

    window-close {
        duration-ms 70
        curve "linear"
    }

    overview-open-close {
        spring damping-ratio=1.0 stiffness=2200 epsilon=0.001
    }
}
