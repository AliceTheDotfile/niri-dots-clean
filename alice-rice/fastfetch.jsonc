{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
    "logo": {
        "type": "file",
        "source": "@HOME@/.config/alice-rice/fastfetch-logo.txt",
        "padding": {
            "top": 1,
            "right": 4
        },
        "color": {
            "1": "#EF6261",
            "2": "#B63A6C",
            "3": "#9B346B",
            "4": "#67315F"
        }
    },
    "display": {
        "separator": "  ",
        "color": {
            "title": "#EF6261",
            "keys": "#B63A6C",
            "output": "#C8C0CC"
        },
        "key": {
            "width": 6
        }
    },
    "modules": [
        {
            "type": "title",
            "format": "{user-name}@{host-name}"
        },
        {
            "type": "separator",
            "string": "──────────────────────────",
            "outputColor": "#5F295D"
        },
        {
            "type": "os",
            "key": "OS",
            "format": "{name}"
        },
        {
            "type": "wm",
            "key": "WM"
        },
        {
            "type": "cpu",
            "key": "CPU",
            "format": "{name}"
        },
        {
            "type": "gpu",
            "key": "GPU",
            "format": "{name}"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "uptime",
            "key": "UP"
        },
        {
            "type": "separator",
            "string": "──────────────────────────",
            "outputColor": "#5F295D"
        },
        {
            "type": "shell",
            "key": "SH"
        },
        {
            "type": "terminal",
            "key": "TERM"
        },
        {
            "type": "separator",
            "string": "──────────────────────────",
            "outputColor": "#5F295D"
        },
        "colors"
    ]
}
