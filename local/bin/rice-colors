                 "home/.local/share/color-schemes/AliceNight.colors", "kde_scheme", True),
        FileSpec(".config/kdeglobals", "home/.config/kdeglobals", "kdeglobals", True),
    ]),
    Target("kitty", "kitty terminal (+ ANSI 16)", [
        FileSpec(".config/alice-rice/kitty.conf", "alice-rice/kitty.conf", "remap", warp=True),
    ], ["kitty"]),
    Target("niri", "niri (focus ring, shadows)", [
        FileSpec(".config/niri/parts/colors.kdl", "niri/parts/colors.kdl"),
    ], ["niri"]),
    Target("waybar", "waybar", [
        FileSpec(".config/waybar/niri-left.css", "waybar/niri-left.css"),
    ], ["waybar"]),
    Target("swaync", "swaync notifications", [
        FileSpec(".config/swaync/style.css", "swaync/style.css"),
    ], ["swaync"]),
    Target("quickshell", "quickshell (bar + launcher)", [
        FileSpec(".config/quickshell/my-shell/TopBar.qml", "quickshell/my-shell/TopBar.qml"),
        FileSpec(".config/quickshell/my-shell/Launcher.qml", "quickshell/my-shell/Launcher.qml"),
