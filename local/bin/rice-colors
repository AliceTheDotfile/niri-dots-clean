#!/usr/bin/env python3
"""
rice-colors — palette editor + wallpaper color generator for alice's niri rice

A terminal UI that owns the rice's color palette and pushes it into every
themed app: GTK 3/4 (AliceNight), qt6ct, the KDE color scheme + kdeglobals,
kitty, niri, waybar, swaync, quickshell, fastfetch, btop and cava.

  * edit any role by hex, or nudge hue / saturation / lightness with the keys
  * generate a whole palette from your CURRENT wallpaper (awww / wallfliper)
  * live preview, save/load presets, apply with automatic backup + undo

Usage:
    rice-colors                       open the TUI
    rice-colors --wallpaper --apply   palette from current wallpaper, apply it
    rice-colors --image FILE --apply  palette from a specific image
    rice-colors --preset NAME --apply apply a saved preset ("AliceNight" = stock)
    rice-colors --restore             undo the last apply
    rice-colors --list-targets

Needs: python-textual, python-pillow   (sudo pacman -S python-textual python-pillow)
"""

from __future__ import annotations

import argparse
import colorsys
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "rice-colors"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "rice-colors"
PRESET_DIR = CONFIG / "rice-colors" / "palettes"
STATE_FILE = STATE / "state.json"
BACKUPS = STATE / "backups"
IMAGE_EXT = {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif", ".tif", ".tiff"}
VIDEO_EXT = {".mp4", ".mkv", ".webm", ".mov", ".avi", ".gif"}


def live_path(rel: str) -> Path:
    if rel.startswith(".config/"):
        return CONFIG / rel[len(".config/"):]
    if rel.startswith(".local/share/"):
        return DATA / rel[len(".local/share/"):]
    return HOME / rel


def norm_hex(s: str) -> str | None:
    s = s.strip().lstrip("#")
    if len(s) == 3 and re.fullmatch(r"[0-9a-fA-F]{3}", s):
        s = "".join(c * 2 for c in s)
    if re.fullmatch(r"[0-9a-fA-F]{6}", s):
        return "#" + s.upper()
    return None


def h2rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def rgb2h(rgb) -> str:
    r, g, b = (max(0, min(255, int(round(v)))) for v in rgb)
    return f"#{r:02X}{g:02X}{b:02X}"


def h2hsl(h: str) -> tuple[float, float, float]:
    r, g, b = (v / 255 for v in h2rgb(h))
    hh, ll, ss = colorsys.rgb_to_hls(r, g, b)
    return hh * 360.0, ss, ll


def hsl2h(h: float, s: float, l: float) -> str:
    r, g, b = colorsys.hls_to_rgb((h % 360.0) / 360.0, max(0.0, min(1.0, l)), max(0.0, min(1.0, s)))
    return rgb2h((r * 255, g * 255, b * 255))


def mix(a: str, b: str, t: float) -> str:
    ar, br = h2rgb(a), h2rgb(b)
    return rgb2h([ar[i] + (br[i] - ar[i]) * t for i in range(3)])


def lum(h: str) -> float:
    def f(c):
        c /= 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4
    r, g, b = h2rgb(h)
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b)


def contrast(a: str, b: str) -> float:
    la, lb = sorted((lum(a), lum(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def ensure_contrast(color: str, bg: str, ratio: float) -> str:
    h, s, l = h2hsl(color)
    up = lum(bg) < 0.4
    for _ in range(60):
        c = hsl2h(h, s, l)
        if contrast(c, bg) >= ratio:
            return c
        l += 0.012 if up else -0.012
        if l >= 0.98 or l <= 0.02:
            break
    return hsl2h(h, s, l)


def hue_dist(a: float, b: float) -> float:
    d = abs(a - b) % 360
    return min(d, 360 - d)


def hue_mix(a: float, b: float, t: float) -> float:
    d = ((b - a + 180) % 360) - 180
    return (a + d * t) % 360


BASE_ROLES = [
    ("bg", "background", "window / terminal bg"),
    ("navy", "navy", "panels, buttons"),
    ("selection", "selection", "selected / hover bg"),
    ("fg", "foreground", "normal text"),
    ("fg_bright", "fg bright", "headings, highlights"),
    ("accent", "accent", "focus ring, cursor"),
    ("pink", "pink", "secondary accent"),
    ("rose", "rose", "tertiary accent"),
    ("violet", "violet", "borders, dim accents"),
    ("purple", "purple", "dim accents"),
    ("success", "success", "ok / positive"),
    ("warning", "warning", "caution"),
]
DERIVED_ROLES = [
    ("bg_deep", "bg deep", "views, inputs"),
    ("surface", "surface", "raised surfaces"),
    ("border_soft", "border soft", "hairlines"),
    ("fg_dim", "fg dim", "secondary text"),
]
ROLE_KEYS = [k for k, _, _ in BASE_ROLES] + [k for k, _, _ in DERIVED_ROLES]
ROLE_LABEL = {k: (lbl, hint) for k, lbl, hint in BASE_ROLES + DERIVED_ROLES}

STOCK_ROLES = {
    "bg": "#09152F", "navy": "#0F183D", "selection": "#2C1F4E",
    "fg": "#D9CFE0", "fg_bright": "#F3EAF2", "accent": "#EF6261",
    "pink": "#B63A6C", "rose": "#9B346B", "violet": "#5F295D",
    "purple": "#67315F", "success": "#7FA68A", "warning": "#D8B45F",
    "bg_deep": "#0D1730", "surface": "#2F2940", "border_soft": "#2C3454",
    "fg_dim": "#C8C0CC",
}
STOCK_ANSI = [
    "#3A2850", "#B63A6C", "#7A3A70", "#EF6261", "#33468A", "#9B346B", "#79416F", "#D9CFE0",
    "#523B69", "#FF6470", "#D24B78", "#FF746F", "#5268A8", "#B95C98", "#986090", "#F3EAF2",
]
ANSI_NAMES = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]


@dataclass
class Palette:
    name: str = "AliceNight"
    roles: dict[str, str] = field(default_factory=lambda: dict(STOCK_ROLES))
    ansi: list[str] = field(default_factory=lambda: list(STOCK_ANSI))
    extras: dict = field(default_factory=dict)

    def copy(self) -> "Palette":
        return Palette(self.name, dict(self.roles), list(self.ansi), dict(self.extras))

    def to_dict(self) -> dict:
        d = {"name": self.name, "roles": self.roles, "ansi": self.ansi}
        if self.extras:
            d["extras"] = self.extras
        return d

    @staticmethod
    def from_dict(d: dict) -> "Palette":
        p = Palette()
        p.name = str(d.get("name", "custom"))
        for k in ROLE_KEYS:
            v = norm_hex(str(d.get("roles", {}).get(k, ""))) or p.roles[k]
            p.roles[k] = v
        ans = d.get("ansi") or []
        if len(ans) == 16:
            p.ansi = [norm_hex(str(a)) or STOCK_ANSI[i] for i, a in enumerate(ans)]
        if isinstance(d.get("extras"), dict):
            p.extras = {k: v for k, v in d["extras"].items() if isinstance(v, str)}
        return p

    def __getitem__(self, k: str) -> str:
        return self.roles[k]

    def shade1(self) -> str:
        return mix(self["bg"], "#000000", 0.57)

    def shade2(self) -> str:
        return mix(self["bg"], "#000000", 0.27)


def derive(p: Palette) -> None:
    r = p.roles
    r["bg_deep"] = mix(r["bg"], r["navy"], 0.30)
    r["surface"] = mix(mix(r["selection"], r["bg"], 0.45), r["fg"], 0.05)
    r["border_soft"] = mix(r["navy"], r["fg"], 0.15)
    r["fg_dim"] = mix(r["fg"], r["bg"], 0.08)


def all_colors(p: Palette) -> list[tuple[str, str]]:
    out = [(k, p.roles[k]) for k in ROLE_KEYS]
    out += [("shade1", p.shade1()), ("shade2", p.shade2())]
    return out


def finalize(p: Palette, rederive: bool = True) -> Palette:
    for k in ROLE_KEYS:
        p.roles[k] = norm_hex(p.roles[k]) or STOCK_ROLES[k]
    p.ansi = [norm_hex(a) or STOCK_ANSI[i] for i, a in enumerate(p.ansi)]
    if rederive:
        derive(p)
    seen: set[tuple[int, int, int]] = set()
    for k in ROLE_KEYS:
        rgb = list(h2rgb(p.roles[k]))
        for _ in range(8):
            if tuple(rgb) not in seen:
                break
            rgb[2] = rgb[2] + 1 if rgb[2] < 255 else rgb[2] - 1
        seen.add(tuple(rgb))
        p.roles[k] = rgb2h(rgb)
    return p


DEFAULT_FILE = "palette.json"
_DEFAULT: Palette | None = None


def default_file_candidates() -> list[Path]:
    here = Path(__file__).resolve()
    c = [CONFIG / "alice-rice" / DEFAULT_FILE]
    if len(here.parents) > 2:
        c.append(here.parents[2] / "alice-rice" / DEFAULT_FILE)
    return c


def default_palette() -> Palette:
    global _DEFAULT
    if _DEFAULT is None:
        _DEFAULT = Palette()
        for f in default_file_candidates():
            try:
                _DEFAULT = Palette.from_dict(json.loads(f.read_text()))
                _DEFAULT.name = "AliceNight"
                break
            except (OSError, ValueError):
                continue
    return _DEFAULT.copy()


def builtin_presets() -> dict[str, Palette]:
    return {"AliceNight": default_palette()}


def list_presets() -> dict[str, Palette]:
    out = builtin_presets()
    if PRESET_DIR.is_dir():
        for f in sorted(PRESET_DIR.glob("*.json")):
            try:
                p = Palette.from_dict(json.loads(f.read_text()))
                p.name = p.name or f.stem
                out[f.stem] = p
            except (OSError, ValueError):
                continue
    return out


def save_preset(p: Palette, name: str) -> Path:
    name = re.sub(r"[^\w.\- ]", "", name).strip() or "custom"
    PRESET_DIR.mkdir(parents=True, exist_ok=True)
    q = p.copy()
    q.name = name
    f = PRESET_DIR / f"{name}.json"
    f.write_text(json.dumps(q.to_dict(), indent=2))
    return f


def wrap180(d: float) -> float:
    return ((d + 180.0) % 360.0) - 180.0


class Warp:
    def __init__(self, old: Palette, new: Palette):
        rows = []
        for k, _, _ in BASE_ROLES:
            ho, so, lo = h2hsl(old[k])
            hn, sn, ln = h2hsl(new[k])
            if so < 0.08 or sn < 0.02:
                continue
            rows.append((ho, wrap180(hn - ho), max(0.3, min(2.5, sn / so)), ln - lo))
        rows.sort()
        groups: list[list] = []
        for r in rows:
            if groups and abs(r[0] - groups[-1][-1][0]) < 3:
                groups[-1].append(r)
            else:
                groups.append([r])
        self.pts = [tuple(sum(c) / len(g) for c in zip(*g)) for g in groups]
        self.identity = all(abs(p[1]) < 0.01 and abs(p[2] - 1) < 0.002 and abs(p[3]) < 0.002 for p in self.pts)

    def __call__(self, hx: str) -> str:
        if self.identity or not self.pts:
            return hx
        h, s, l = h2hsl(hx)
        if s < 0.04:
            return hx
        pts = self.pts
        ext = [(pts[-1][0] - 360, *pts[-1][1:])] + list(pts) + [(pts[0][0] + 360, *pts[0][1:])]
        for i in range(len(ext) - 1):
            a, b = ext[i], ext[i + 1]
            if a[0] <= h <= b[0]:
                t = (h - a[0]) / max(1e-6, b[0] - a[0])
                dh = a[1] + (b[1] - a[1]) * t
                sr = a[2] + (b[2] - a[2]) * t
                dl = a[3] + (b[3] - a[3]) * t
                break
        else:
            dh, sr, dl = 0.0, 1.0, 0.0
        f = min(1.0, s / 0.2)
        return hsl2h(h + dh, min(1.0, max(0.0, s * (1 + (sr - 1) * f))), min(0.98, max(0.0, l + dl * f)))


QT_ARGB = re.compile(r"#([0-9a-fA-F]{2})([0-9a-fA-F]{6})(?![0-9a-fA-F])")
KDE_RGB = re.compile(r"(?m)^(\s*[A-Za-z]\w*\s*=\s*)(\d{1,3}),(\d{1,3}),(\d{1,3})[ \t]*$")


def warp_qt6ct(text: str, w: Warp) -> str:
    def f(mo):
        lo = mo.group(2) == mo.group(2).lower()
        n = w("#" + mo.group(2)).lstrip("#")
        return "#" + mo.group(1) + (n.lower() if lo else n.upper())
    return QT_ARGB.sub(f, text)


def warp_kde(text: str, w: Warp) -> str:
    def f(mo):
        rgb = (int(mo.group(2)), int(mo.group(3)), int(mo.group(4)))
        if max(rgb) > 255:
            return mo.group(0)
        n = h2rgb(w(rgb2h(rgb)))
        return f"{mo.group(1)}{n[0]},{n[1]},{n[2]}"
    return KDE_RGB.sub(f, text)


@dataclass
class Cluster:
    h: float
    s: float
    l: float
    w: float
    hex: str
    pop: bool = False
    corner: float = 0.0
    edge: float = 0.0
    center: float = 0.0


STYLES = ["balanced", "vibrant", "muted"]
SAT_SCALE = {"balanced": 1.0, "vibrant": 1.22, "muted": 0.72}


def _pil():
    try:
        from PIL import Image, ImageOps
        return Image, ImageOps
    except ImportError:
        raise SystemExit("missing Pillow. install it with: sudo pacman -S python-pillow")


def _clamp(v: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, v))


def _rgb_weighted(items: list[tuple[str, float]]) -> str:
    if not items:
        return "#000000"
    total = sum(max(0.0, w) for _, w in items) or 1.0
    rgb = [0.0, 0.0, 0.0]
    for hx, weight in items:
        r, g, b = h2rgb(hx)
        q = max(0.0, weight) / total
        rgb[0] += r * q
        rgb[1] += g * q
        rgb[2] += b * q
    return rgb2h(rgb)


def _tune(hx: str, *, sat: float | None = None, light: float | None = None,
          sat_mul: float = 1.0, light_shift: float = 0.0) -> str:
    h, s, l = h2hsl(hx)
    if sat is None:
        s *= sat_mul
    else:
        s = sat
    l = l + light_shift if light is None else light
    return hsl2h(h, _clamp(s, 0.0, 0.95), _clamp(l, 0.02, 0.97))


def _palette_distance(a: Palette, b: Palette) -> float:
    """Approximate how much the generated palette differs from another one."""
    total = 0.0
    count = 0
    for k in ("bg", "navy", "selection", "fg", "fg_bright", "accent", "pink", "rose", "violet", "purple"):
        ah, ass, al = h2hsl(a[k])
        bh, bss, bl = h2hsl(b[k])
        total += min(hue_dist(ah, bh), 180.0) / 180.0
        total += abs(ass - bss)
        total += abs(al - bl)
        count += 3
    return total / max(1, count)


def extract_clusters(path: Path, k: int = 24) -> list[Cluster]:
    """Extract color clusters while retaining spatial information.

    Plain global quantisation is surprisingly bad for wallpaper theming:
    a tiny neon sign can dominate an accent, while black borders can become
    the "background".  We therefore keep corner/edge/center prevalence and
    use a second pass for bright saturated feature colors.
    """
    Image, ImageOps = _pil()
    im = Image.open(path)
    im = ImageOps.exif_transpose(im)

    # Composite transparency over black; transparent wallpaper pixels should
    # behave like the dark background rather than random RGB garbage.
    if "A" in im.getbands():
        rgba = im.convert("RGBA")
        bg = Image.new("RGBA", rgba.size, (0, 0, 0, 255))
        im = Image.alpha_composite(bg, rgba).convert("RGB")
    else:
        im = im.convert("RGB")

    # A slightly larger working image gives the spatial statistics enough
    # resolution without turning this into an expensive image processor.
    resampling = getattr(Image, "Resampling", Image)
    im.thumbnail((320, 320), resampling.LANCZOS)
    q = im.quantize(colors=max(8, k), method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette() or []
    qpx = list(q.getdata())
    width, height = q.size

    stats: dict[int, dict[str, float]] = {}
    for idx in set(qpx):
        stats[idx] = {"count": 0.0, "corner": 0.0, "edge": 0.0, "center": 0.0}

    for pos, idx in enumerate(qpx):
        y, x = divmod(pos, width)
        nx = x / max(1, width - 1)
        ny = y / max(1, height - 1)
        edge_dist = min(nx, ny, 1.0 - nx, 1.0 - ny)
        st = stats[idx]
        st["count"] += 1.0
        if (nx <= 0.28 or nx >= 0.72) and (ny <= 0.28 or ny >= 0.72):
            st["corner"] += 1.0
        if edge_dist <= 0.18:
            st["edge"] += 1.0
        if 0.30 <= nx <= 0.70 and 0.30 <= ny <= 0.70:
            st["center"] += 1.0

    total = float(len(qpx)) or 1.0
    out: list[Cluster] = []
    for idx, st in stats.items():
        rgb = pal[idx * 3: idx * 3 + 3]
        if len(rgb) != 3:
            continue
        hx = rgb2h(rgb)
        h, s, l = h2hsl(hx)
        out.append(Cluster(
            h=h,
            s=s,
            l=l,
            w=st["count"] / total,
            hex=hx,
            pop=False,
            corner=st["corner"] / max(1.0, st["count"]),
            edge=st["edge"] / max(1.0, st["count"]),
            center=st["center"] / max(1.0, st["count"]),
        ))

    out.sort(key=lambda c: -c.w)

    # Second pass: preserve small, bright, saturated features that median-cut
    # can otherwise bury inside a large dark cluster.
    px = list(im.getdata())
    bins: dict[tuple[int, int], list[tuple[int, int, int]]] = {}
    stride = max(1, len(px) // 90000)
    for r, g, b in px[::stride]:
        hh, ss, vv = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        _, _, ll = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)
        if ss >= 0.45 and vv >= 0.58 and ll >= 0.30:
            hbin = int(hh * 24) % 24
            lbin = 0 if ll < 0.50 else 1 if ll < 0.72 else 2
            bins.setdefault((hbin, lbin), []).append((r, g, b))

    sample_total = max(1, len(px[::stride]))
    for items in bins.values():
        frac = len(items) / sample_total
        if frac < 0.0025:
            continue
        avg = [sum(c[i] for c in items) / len(items) for i in range(3)]
        hx = rgb2h(avg)
        h, s, l = h2hsl(hx)
        out.append(Cluster(h, s, l, frac, hx, True, 0.0, 0.0, 0.0))

    return out


def _chroma(clusters: list[Cluster]) -> list[Cluster]:
    return [c for c in clusters if c.s >= 0.16 and 0.06 <= c.l <= 0.95]


def _circ_mean(items: list[tuple[float, float]]) -> float:
    import math
    x = sum(math.cos(math.radians(h)) * w for h, w in items)
    y = sum(math.sin(math.radians(h)) * w for h, w in items)
    return math.degrees(math.atan2(y, x)) % 360


def _greenish(c: Cluster) -> bool:
    return c.s >= 0.24 and 75.0 <= c.h <= 170.0 and c.l >= 0.28


def _warm(c: Cluster) -> bool:
    return c.s >= 0.24 and (c.h <= 72.0 or c.h >= 332.0) and c.l >= 0.30


def _family_representatives(clusters: list[Cluster], max_families: int = 4) -> list[dict]:
    """Group the wallpaper's *actual* colors into hue families.

    A family is a group of observed colors whose hues are already close. The
    sensor never creates a complementary/analogous hue just to fill a role.
    Different lightness values remain tones inside the same family.
    """
    chroma = [
        c for c in clusters
        if c.s >= 0.18 and 0.12 <= c.l <= 0.96
    ]
    if not chroma:
        return []

    remaining = list(chroma)
    total_weight = sum(c.w * max(c.s, 0.12) for c in remaining) or 1.0
    families: list[dict] = []

    while remaining and len(families) < max_families:
        # Dominant family first: prevalence matters much more than brightness.
        # This keeps a tiny bright feature from becoming the background family.
        seed = max(
            remaining,
            key=lambda c: c.w * max(c.s, 0.12) * (0.72 + 0.28 * c.s),
        )

        members = [c for c in remaining if hue_dist(c.h, seed.h) <= 26.0]
        if not members:
            members = [seed]

        weight = sum(c.w * max(c.s, 0.12) for c in members)
        hue = _circ_mean([
            (c.h, c.w * max(c.s, 0.12))
            for c in members
        ])

        darkest = min(members, key=lambda c: c.l)
        lightest = max(members, key=lambda c: c.l)
        strongest = max(
            members,
            key=lambda c: c.w * c.s * (1.7 if c.pop else 1.0),
        )

        # Actual observed background candidate from this family. Spatial
        # coverage wins over pure darkness so a dark foreground object does not
        # automatically become the desktop background.
        bg_member = max(
            members,
            key=lambda c: (
                (0.52 - c.l) * (0.55 + 1.9 * c.corner + 0.55 * c.edge)
                * (0.55 + 1.4 * min(1.0, c.w * 6.0))
            ),
        )

        families.append({
            "h": hue,
            "weight": weight / total_weight,
            "members": members,
            "dark": darkest.hex,
            "light": lightest.hex,
            "strong": strongest.hex,
            "bg": bg_member.hex,
        })
        remaining = [c for c in remaining if c not in members]

    families.sort(key=lambda f: -f["weight"])
    return families


def _observed_hue_tone(seed: str, lightness: float, sat_scale: float = 1.0) -> str:
    """Change only lightness/saturation while retaining an observed hue."""
    h, s, _ = h2hsl(seed)
    return hsl2h(
        h,
        _clamp(s * sat_scale, 0.0, 0.95),
        _clamp(lightness, 0.02, 0.97),
    )


def _source_hue(seed: str) -> float:
    return h2hsl(seed)[0]


def analyze_wallpaper(clusters: list[Cluster], base: Palette, variant: int = 0) -> dict:
    """Find the wallpaper's real hue families and usable tone anchors.

    Hue is treated as data, not a design suggestion. A one-family wallpaper
    therefore produces a one-hue rice; a two-family wallpaper produces a
    two-hue rice; and so on. Variants only choose another *observed* family.
    """
    base_bg_h, _, _ = h2hsl(base["bg"])
    source = clusters or []
    families = _family_representatives(source, max_families=4)

    if not families:
        return {
            "mode": "grayscale",
            "families": [],
            "usable_families": [],
            "primary_family": None,
            "h_bg": base_bg_h,
            "s_bg": 0.18,
            "l_bg_raw": h2hsl(base["bg"])[2],
            "bg_hex": base["bg"],
            "tone_dark": base["bg"],
            "tone_light": base["accent"],
            "accent_seed": base["accent"],
            "secondary_seed": base["accent"],
            "tertiary_seed": base["accent"],
            "green": None,
            "warm": None,
            "chroma_mass": 0.0,
            "family_count": 0,
            "primary_mass": 0.0,
        }

    # A family must have enough chromatic mass to become a real theme family.
    # Tiny quantisation noise is ignored; a real small feature can still pass
    # because its saturation-weighted mass is retained by the extractor.
    significant = [f for f in families if f["weight"] >= 0.045]
    if len(significant) <= 1:
        mode = "monochrome"
    elif len(significant) == 2:
        mode = "two-family"
    else:
        mode = "multi-family"

    usable = significant[:1] if mode == "monochrome" else significant[:2] if mode == "two-family" else significant[:4]
    primary = significant[0]

    # Background always comes from the dominant family. This is what prevents
    # a mostly-red wallpaper with a few dark-blue pixels from becoming purple.
    bg_seed = primary["bg"]
    bg_h, bg_s, bg_l = h2hsl(bg_seed)

    # Variants choose another actual family when one exists. No hue rotation.
    accent_family = usable[variant % len(usable)]
    other = [f for f in usable if f is not accent_family]
    secondary_family = other[0] if other else accent_family
    tertiary_family = usable[(usable.index(accent_family) + 1) % len(usable)]

    if mode == "monochrome":
        # For a true one-family wallpaper, the lightest/darkest observed colors
        # are the anchors. This gives a two-tone/simple image a two-tone/simple
        # rice rather than fabricating extra hues.
        accent_seed = accent_family["light"]
        secondary_seed = accent_seed
        tertiary_seed = accent_seed
    else:
        accent_seed = accent_family["strong"]
        secondary_seed = secondary_family["strong"]
        tertiary_seed = tertiary_family["strong"]

    return {
        "mode": mode,
        "families": families,
        "usable_families": usable,
        "primary_family": primary,
        "h_bg": bg_h,
        "s_bg": _clamp(bg_s, 0.0, 0.82),
        "l_bg_raw": bg_l,
        "bg_hex": bg_seed,
        "tone_dark": primary["dark"],
        "tone_light": primary["light"],
        "accent_seed": accent_seed,
        "secondary_seed": secondary_seed,
        "tertiary_seed": tertiary_seed,
        "green": next((
            c.hex
            for f in significant[1:]
            for c in f["members"]
            if _greenish(c)
        ), None),
        "warm": next((
            c.hex
            for f in significant[1:]
            for c in f["members"]
            if _warm(c)
        ), None),
        "chroma_mass": sum(c.w * c.s for c in source if c.s >= 0.12),
        "family_count": len(significant),
        "primary_mass": primary["weight"],
    }


def build_palette(clusters: list[Cluster], style: str = "balanced", variant: int = 0,
                  name: str = "wallpaper") -> Palette:
    """Build the rice from observed wallpaper colors only.

    The design may change lightness and saturation for readability, but it does
    not invent hue families. This is intentional: a monochrome blue wallpaper
    should produce blue tones, not blue + purple + pink because the stock rice
    happened to contain those colors.
    """
    base = default_palette()
    a = analyze_wallpaper(clusters, base, variant)
    sat_scale = SAT_SCALE.get(style, 1.0)
    mode = a["mode"]

    # ------------------------------------------------------------
    # Background family
    # ------------------------------------------------------------
    bg_seed = a["bg_hex"] if mode != "grayscale" else base["bg"]
    _, bg_s_seed, bg_l_seed = h2hsl(bg_seed)
    bg_h = a["h_bg"] if mode != "grayscale" else h2hsl(base["bg"])[0]

    # Keep the sampled hue exactly. Only darkness/saturation are adjusted.
    bg = hsl2h(
        bg_h,
        _clamp(max(bg_s_seed * (1.05 if style == "vibrant" else 0.94), 0.30), 0.30, 0.78),
        _clamp(0.055 + bg_l_seed * 0.42, 0.055, 0.24),
    )
    # Preserve the analyzed hue explicitly. Very dark colors can have unstable
    # RGB-derived HSL hues after saturation/lightness adjustment, so do not
    # recalculate the hue from the newly generated background.
    _, bg_s, bg_l = h2hsl(bg)
    bg_h = a["h_bg"] if mode != "grayscale" else bg_h

    # ------------------------------------------------------------
    # Actual wallpaper hue sources
    # ------------------------------------------------------------
    accent_seed = a["accent_seed"]
    secondary_seed = a["secondary_seed"]
    tertiary_seed = a["tertiary_seed"]

    acc_h, acc_s_seed, acc_l_seed = h2hsl(accent_seed)
    sec_h, sec_s_seed, sec_l_seed = h2hsl(secondary_seed)
    ter_h, ter_s_seed, ter_l_seed = h2hsl(tertiary_seed)

    if mode == "monochrome":
        # One observed hue family means ONE hue family everywhere.
        sec_h = ter_h = acc_h
        sec_s_seed = ter_s_seed = acc_s_seed

    # ------------------------------------------------------------
    # Dark surface structure
    # ------------------------------------------------------------
    navy = hsl2h(
        bg_h,
        _clamp(bg_s * 0.94, 0.04, 0.70),
        _clamp(bg_l + 0.048, 0.075, 0.29),
    )
    bg_deep = hsl2h(
        bg_h,
        _clamp(bg_s * 0.96, 0.04, 0.72),
        _clamp(bg_l - 0.022, 0.025, 0.18),
    )

    # Accent uses the actual light/strong observed member and gets only enough
    # lightness/saturation adjustment to remain legible.
    acc_s = _clamp(acc_s_seed * sat_scale, 0.26, 0.94)
    acc_l = _clamp(max(acc_l_seed, 0.50) + (0.03 if style == "vibrant" else 0.0), 0.46, 0.80)
    accent = ensure_contrast(hsl2h(acc_h, acc_s, acc_l), bg, 4.5)

    selection = hsl2h(
        acc_h,
        _clamp(acc_s * 0.36, 0.10, 0.45),
        _clamp((bg_l + acc_l) * 0.46, bg_l + 0.045, 0.32),
    )

    # ------------------------------------------------------------
    # Supporting roles
    # ------------------------------------------------------------
    pink = ensure_contrast(
        hsl2h(sec_h, _clamp(sec_s_seed * 0.82 * sat_scale, 0.16, 0.84), 0.57),
        bg,
        3.0,
    )
    rose = ensure_contrast(
        hsl2h(ter_h, _clamp(ter_s_seed * 0.72 * sat_scale, 0.14, 0.78), 0.49),
        bg,
        3.0,
    )

    # These are intentionally named by the rice API, not by hue. In a
    # monochrome wallpaper they are simply darker tones of that same hue.
    violet = hsl2h(
        ter_h,
        _clamp(ter_s_seed * 0.58 * sat_scale, 0.10, 0.68),
        _clamp(bg_l + 0.20, 0.20, 0.44),
    )
    purple = hsl2h(
        sec_h,
        _clamp(sec_s_seed * 0.46 * sat_scale, 0.08, 0.60),
        _clamp(bg_l + 0.15, 0.18, 0.38),
    )

    surface_h = bg_h if mode == "monochrome" else sec_h
    surface_s_seed = bg_s if mode == "monochrome" else sec_s_seed
    surface = hsl2h(
        surface_h,
        _clamp(surface_s_seed * 0.64, 0.05, 0.44),
        _clamp(bg_l + 0.10, 0.13, 0.31),
    )

    # ------------------------------------------------------------
    # Semantic colors
    # ------------------------------------------------------------
    # Never inject unrelated green/yellow hues into a monochrome wallpaper.
    # For multicolor wallpapers, use those hues only when the wallpaper itself
    # actually contains them.
    if mode != "monochrome" and a["green"]:
        success = ensure_contrast(_observed_hue_tone(a["green"], 0.60, 0.92), bg, 3.0)
    else:
        success = ensure_contrast(
            hsl2h(acc_h, _clamp(acc_s * 0.78, 0.20, 0.70), 0.62),
            bg,
            3.0,
        )

    if mode != "monochrome" and a["warm"]:
        warning = ensure_contrast(_observed_hue_tone(a["warm"], 0.66, 0.92), bg, 3.0)
    else:
        warning = ensure_contrast(
            hsl2h(acc_h, _clamp(acc_s * 0.68, 0.18, 0.66), 0.68),
            bg,
            3.0,
        )

    # Text is neutral-ish but keeps the wallpaper's background hue rather than
    # inheriting the stock pink/purple tint.
    fg = ensure_contrast(
        hsl2h(bg_h, min(0.16, bg_s * 0.30), 0.82),
        bg,
        7.0,
    )
    fg_bright = ensure_contrast(
        hsl2h(bg_h, min(0.11, bg_s * 0.22), 0.94),
        bg,
        10.0,
    )
    fg_dim = ensure_contrast(
        hsl2h(bg_h, min(0.14, bg_s * 0.28), 0.70),
        bg,
        4.5,
    )
    border_soft = hsl2h(
        acc_h,
        _clamp(acc_s * 0.28, 0.06, 0.38),
        _clamp(bg_l + 0.105, 0.12, 0.34),
    )

    p = Palette(name=name)
    p.roles.update({
        "bg": bg,
        "navy": navy,
        "selection": selection,
        "fg": fg,
        "fg_bright": fg_bright,
        "accent": accent,
        "pink": pink,
        "rose": rose,
        "violet": violet,
        "purple": purple,
        "success": success,
        "warning": warning,
        "bg_deep": bg_deep,
        "surface": surface,
        "border_soft": border_soft,
        "fg_dim": fg_dim,
    })

    # ------------------------------------------------------------
    # ANSI
    # ------------------------------------------------------------
    if mode == "monochrome":
        h = acc_h
        s = acc_s_seed
        normal = [
            hsl2h(h, _clamp(s * 0.36, 0.06, 0.40), 0.20),
            hsl2h(h, _clamp(s * 0.66, 0.10, 0.70), 0.52),
            hsl2h(h, _clamp(s * 0.58, 0.08, 0.64), 0.58),
            hsl2h(h, _clamp(s * 0.60, 0.08, 0.70), 0.68),
            hsl2h(h, _clamp(s * 0.44, 0.06, 0.54), 0.40),
            hsl2h(h, _clamp(s * 0.70, 0.10, 0.74), 0.60),
            hsl2h(h, _clamp(s * 0.52, 0.08, 0.60), 0.48),
            fg,
        ]
    else:
        normal = [
            mix(bg, "#000000", 0.25),
            rose,
            success,
            warning,
            _observed_hue_tone(accent_seed, 0.44, 0.82),
            pink,
            _observed_hue_tone(tertiary_seed, 0.58, 0.72),
            fg,
        ]

    p.ansi = normal + [
        _observed_hue_tone(c, _clamp(h2hsl(c)[2] + 0.10, 0.02, 0.96), 1.02)
        for c in normal
    ]

    finalize(p, rederive=False)
    return p


def _run(cmd: list[str], timeout: float = 3) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def video_frame(path: Path) -> Path | None:
    if not shutil.which("ffmpeg"):
        return None
    CACHE.mkdir(parents=True, exist_ok=True)
    out = CACHE / "frame.png"
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", "1", "-i", str(path), "-frames:v", "1", str(out)], capture_output=True, timeout=30)
    if not out.exists() or out.stat().st_size == 0:
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(path), "-frames:v", "1", str(out)], capture_output=True, timeout=30)
    return out if out.exists() else None


def detect_wallpaper() -> tuple[Path | None, str]:
    state = {}
    try:
        state = json.loads((CONFIG / "wallfliper" / "state.json").read_text())
    except (OSError, ValueError):
        pass
    sp = Path(str(state.get("path", ""))).expanduser() if state.get("path") else None
    if sp and sp.is_file() and (state.get("kind") == "video" or sp.suffix.lower() in VIDEO_EXT - {".gif"}):
        fr = video_frame(sp)
        if fr:
            return fr, f"frame of video wallpaper {sp.name}"
    for tool in ("awww", "swww"):
        if shutil.which(tool):
            for line in _run([tool, "query"]).splitlines():
                m = re.search(r"image:\s*(\S.*?)\s*$", line)
                if m and Path(m.group(1)).is_file():
                    return Path(m.group(1)), f"{tool} query"
    if sp and sp.is_file() and sp.suffix.lower() in IMAGE_EXT:
        return sp, "wallfliper state"
    wd = HOME / "Wallpapers"
    if wd.is_dir():
        imgs = [f for f in wd.iterdir() if f.suffix.lower() in IMAGE_EXT]
        if imgs:
            f = max(imgs, key=lambda x: x.stat().st_mtime)
            return f, "newest file in ~/Wallpapers (no wallpaper daemon answered)"
    return None, "no wallpaper found"


def list_wallpapers() -> list[Path]:
    wd = HOME / "Wallpapers"
    if not wd.is_dir():
        return []
    return sorted(f for f in wd.iterdir() if f.suffix.lower() in IMAGE_EXT)


HEX_RE = re.compile(r"#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?(?![0-9a-fA-F])")
RGB_RE = re.compile(r"(rgba?\(\s*)(\d{1,3})(\s*,\s*)(\d{1,3})(\s*,\s*)(\d{1,3})")


def build_map(old: Palette, new: Palette) -> dict[tuple[int, int, int], tuple[int, int, int]]:
    o, n = dict(all_colors(old)), dict(all_colors(new))
    m: dict = {}
    for k, ov in o.items():
        key, val = h2rgb(ov), h2rgb(n[k])
        if key not in m:
            m[key] = val
    for ov, nv in zip(old.ansi, new.ansi):
        m.setdefault(h2rgb(ov), h2rgb(nv))
    return {k: v for k, v in m.items() if k != v}


def remap_text(text: str, m: dict, warp: "Warp | None" = None) -> tuple[str, int]:
    count = 0
    def target(rgb):
        if rgb in m:
            return m[rgb]
        if warp is not None:
            w = h2rgb(warp(rgb2h(rgb)))
            return w if w != rgb else None
        return None
    def hexsub(mo):
        nonlocal count
        rgb = h2rgb(mo.group(1))
        tg = target(rgb)
        if tg is not None:
            count += 1
            new = "{:02x}{:02x}{:02x}".format(*tg)
            if not re.search(r"[a-f]", mo.group(1)):
                low = bool(mo.group(2) and re.search(r"[a-f]", mo.group(2)))
            else:
                low = mo.group(1) == mo.group(1).lower()
            if not low:
                new = new.upper()
            return "#" + new + (mo.group(2) or "")
        return mo.group(0)
    def rgbsub(mo):
        nonlocal count
        rgb = (int(mo.group(2)), int(mo.group(4)), int(mo.group(6)))
        if rgb in m:
            count += 1
            n = m[rgb]
            return f"{mo.group(1)}{n[0]}{mo.group(3)}{n[1]}{mo.group(5)}{n[2]}"
        return mo.group(0)
    text = HEX_RE.sub(hexsub, text)
    text = RGB_RE.sub(rgbsub, text)
    return text, count


def score_palette(text: str, p: Palette) -> int:
    found = {h2rgb(mo.group(1)) for mo in HEX_RE.finditer(text)}
    for mo in RGB_RE.finditer(text):
        found.add((int(mo.group(2)), int(mo.group(4)), int(mo.group(6))))
    return sum(1 for _, v in all_colors(p) if h2rgb(v) in found)


def conf_set(text: str, kv: dict[str, str]) -> str:
    lines = text.split("\n")
    done = set()
    for i, ln in enumerate(lines):
        mo = re.match(r"^(\s*)([A-Za-z_][\w]*)(\s+)(\S.*)$", ln)
        if mo and mo.group(2) in kv and not ln.lstrip().startswith("#"):
            k = mo.group(2)
            lines[i] = f"{mo.group(1)}{k}{mo.group(3)}{kv[k]}"
            done.add(k)
    missing = [k for k in kv if k not in done]
    if missing:
        if lines and lines[-1] == "":
            lines.pop()
        lines += ["", "# added by rice-colors"] + [f"{k} {kv[k]}" for k in missing] + [""]
    return "\n".join(lines)


def ini_set(text: str, section: str, kv: dict[str, str], sep: str = "=", uncomment: bool = True) -> str:
    lines = text.split("\n")
    start = None
    for i, ln in enumerate(lines):
        if ln.strip() == f"[{section}]":
            start = i
            break
    if start is None:
        if lines and lines[-1].strip() != "":
            lines.append("")
        lines.append(f"[{section}]")
        lines += [f"{k}{sep}{v}" for k, v in kv.items()]
        return "\n".join(lines) + ("" if lines[-1] == "" else "\n")
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if re.match(r"^\s*\[.+\]\s*$", lines[j]):
            end = j
            break
    for k, v in kv.items():
        pat = re.compile(rf"^\s*{'[;#]?' if uncomment else ''}\s*{re.escape(k)}\s*=")
        hit = None
        for j in range(start + 1, end):
            if pat.match(lines[j]):
                hit = j
                if not lines[j].lstrip().startswith((";", "#")):
                    break
        if hit is not None:
            lines[hit] = f"{k}{sep}{v}"
        else:
            ins = end
            while ins > start + 1 and lines[ins - 1].strip() == "":
                ins -= 1
            lines.insert(ins, f"{k}{sep}{v}")
            end += 1
    return "\n".join(lines)


def _rgbs(h: str) -> str:
    return "{},{},{}".format(*h2rgb(h))


def _kde_generated_sections(p: Palette) -> dict[str, dict[str, str]]:
    r = p.roles
    def block(bg, alt, fg=None, active=None):
        fg = fg or r["fg"]
        return {
            "BackgroundAlternate": _rgbs(alt), "BackgroundNormal": _rgbs(bg),
            "DecorationFocus": _rgbs(r["accent"]), "DecorationHover": _rgbs(r["accent"]),
            "ForegroundActive": _rgbs(active or r["fg_bright"]),
            "ForegroundInactive": _rgbs(mix(fg, bg, 0.38)),
            "ForegroundLink": _rgbs(r["accent"]), "ForegroundNegative": _rgbs(r["accent"]),
            "ForegroundNeutral": _rgbs(r["warning"]), "ForegroundNormal": _rgbs(fg),
            "ForegroundPositive": _rgbs(r["success"]), "ForegroundVisited": _rgbs(mix(r["rose"], r["fg"], 0.45)),
        }
    sel = block(r["selection"], mix(r["selection"], r["fg"], 0.10), r["fg_bright"])
    win = block(r["bg"], mix(r["bg"], "#000000", 0.12))
    return {
        "ColorEffects:Disabled": {"Color": "128,128,128"},
        "ColorEffects:Inactive": {"ChangeSelectionColor": "true", "ChangeSelectionColorAmount": "10", "Color": _rgbs(r["violet"]), "ColorAmount": "10", "ColorEffect": "0", "ContrastAmount": "0.1", "IntensityAmount": "0.2"},
        "Colors:Button": block(r["navy"], r["bg_deep"]), "Colors:Complementary": block(r["bg_deep"], r["bg"]),
        "Colors:Header": block(r["bg"], mix(r["bg"], "#000000", 0.12)), "Colors:Selection": sel,
        "Colors:Tooltip": block(r["navy"], r["navy"]), "Colors:View": block(r["bg_deep"], r["bg"]),
        "Colors:Window": win,
        "WM": {"activeBackground": _rgbs(r["bg"]), "activeBlend": _rgbs(r["accent"]), "activeForeground": _rgbs(r["fg"]), "inactiveBackground": _rgbs(r["bg_deep"]), "inactiveBlend": _rgbs(r["violet"]), "inactiveForeground": _rgbs(r["fg_dim"])},
    }


def parse_ini(text: str) -> dict[str, dict[str, str]]:
    d: dict[str, dict[str, str]] = {}
    sec = None
    for ln in text.splitlines():
        mo = re.match(r"^\[(.+)\]\s*$", ln)
        if mo:
            sec = mo.group(1)
            d[sec] = {}
        elif sec is not None and "=" in ln:
            k, v = ln.split("=", 1)
            d[sec][k] = v
    return d


def kde_scheme_sections(p: Palette) -> dict[str, dict[str, str]]:
    base = default_palette()
    if base.extras.get("kde"):
        text = warp_kde(base.extras["kde"], Warp(base, p))
        secs = parse_ini(text)
        secs.pop("General", None)
        return secs
    return _kde_generated_sections(p)


def kde_scheme_text(p: Palette) -> str:
    base = default_palette()
    if base.extras.get("kde"):
        return warp_kde(base.extras["kde"], Warp(base, p))
    out = []
    secs = _kde_generated_sections(p)
    for name in sorted(secs):
        out.append(f"[{name}]")
        out += [f"{k}={v}" for k, v in sorted(secs[name].items())]
        out.append("")
    out += ["[General]", "ColorScheme=AliceNight", "Name=AliceNight", "shadeSortColumn=true", ""]
    return "\n".join(out)


def kdeglobals_text(text: str, p: Palette) -> str:
    for name, kv in kde_scheme_sections(p).items():
        text = ini_set(text, name, kv, uncomment=False)
    text = ini_set(text, "General", {"ColorScheme": "AliceNight"}, uncomment=False)
    return text if text.endswith("\n") else text + "\n"


def _qt6ct_generated(p: Palette) -> str:
    r = p.roles
    def a(h, alpha="ff"):
        return "#" + alpha + h.lstrip("#").lower()
    def scheme(fg, fg_b, bg, dim=False):
        base = r["bg_deep"]
        if dim:
            fg = fg_b = r["violet"]
        return [a(fg), a(r["navy"]), a(r["surface"]), a(mix(r["navy"], r["fg"], 0.10)), a(p.shade2()), a(r["border_soft"]), a(fg), a(fg_b), a(fg), a(base), a(bg), a(p.shade1()), a(r["accent"] if not dim else r["violet"]), a(r["bg"]), a(r["accent"]), a(r["rose"]), a(r["bg"]), a(bg), a(r["navy"]), a(r["fg"]), "#80" + fg.lstrip("#").lower(), a(r["accent"])]
    active = scheme(r["fg"], r["fg_bright"], r["bg"])
    inactive = scheme(r["fg_dim"], r["fg_bright"], r["bg"])
    disabled = scheme(r["violet"], r["violet"], r["bg_deep"], dim=True)
    return "[ColorScheme]\nactive_colors=%s\n\ninactive_colors=%s\n\ndisabled_colors=%s\n" % (",".join(active), ",".join(inactive), ",".join(disabled))


def qt6ct_text(p: Palette) -> str:
    base = default_palette()
    if base.extras.get("qt6ct"):
        return warp_qt6ct(base.extras["qt6ct"], Warp(base, p))
    return _qt6ct_generated(p)


def btop_theme_text(p: Palette) -> str:
    r = p.roles
    g = lambda a, b, c: (a, b, c)
    lines = {"main_bg": r["bg"], "main_fg": r["fg"], "title": r["fg_bright"], "hi_fg": r["accent"], "selected_bg": r["selection"], "selected_fg": r["accent"], "inactive_fg": r["violet"], "graph_text": r["fg_dim"], "meter_bg": r["surface"], "proc_misc": r["pink"], "cpu_box": r["violet"], "mem_box": r["violet"], "net_box": r["violet"], "proc_box": r["violet"], "div_line": r["border_soft"]}
    grads = {"temp": g(r["success"], r["warning"], r["accent"]), "cpu": g(r["rose"], r["pink"], r["accent"]), "free": g(r["violet"], r["purple"], r["pink"]), "cached": g(r["violet"], r["rose"], r["pink"]), "available": g(r["purple"], r["rose"], r["accent"]), "used": g(r["rose"], r["pink"], r["accent"]), "download": g(r["violet"], r["pink"], r["accent"]), "upload": g(r["purple"], r["rose"], r["accent"]), "process": g(r["violet"], r["rose"], r["accent"])}
    out = ["# generated by rice-colors"]
    out += [f'theme[{k}]="{v}"' for k, v in lines.items()]
    for k, (s, m_, e) in grads.items():
        out += [f'theme[{k}_start]="{s}"', f'theme[{k}_mid]="{m_}"', f'theme[{k}_end]="{e}"']
    return "\n".join(out) + "\n"


def kitty_kv(p: Palette) -> dict[str, str]:
    r = p.roles
    kv = {"background": r["bg"], "foreground": r["fg"], "selection_background": r["selection"], "selection_foreground": r["accent"], "cursor": r["accent"], "cursor_text_color": r["bg"], "cursor_trail_color": r["accent"], "active_border_color": r["accent"], "inactive_border_color": r["selection"], "bell_border_color": r["pink"], "active_tab_foreground": r["accent"], "active_tab_background": r["bg_deep"], "inactive_tab_foreground": r["rose"], "inactive_tab_background": r["bg"], "tab_bar_background": r["bg"]}
    for i, c in enumerate(p.ansi):
        kv[f"color{i}"] = c
    return kv


def cava_kv(p: Palette) -> dict[str, str]:
    r = p.roles
    stops = [r["violet"], r["purple"], r["rose"], r["pink"], r["accent"]]
    cols = []
    for i in range(8):
        t = i / 7 * (len(stops) - 1)
        lo = min(int(t), len(stops) - 2)
        cols.append(mix(stops[lo], stops[lo + 1], t - lo))
    kv = {"gradient": "1"}
    kv.update({f"gradient_color_{i + 1}": f"'{c.lower()}'" for i, c in enumerate(cols)})
    return kv


@dataclass
class FileSpec:
    live: str
    repo: str
    kind: str = "remap"
    create: bool = False
    warp: bool = False
    canonical_source: bool = True


@dataclass
class Target:
    key: str
    label: str
    files: list[FileSpec]
    hooks: list[str] = field(default_factory=list)
    default: bool = True


GTK_THEME = ".local/share/themes/AliceNight"
TARGETS: list[Target] = [
    Target("gtk", "GTK 3 + 4 (AliceNight theme)", [
        FileSpec(f"{GTK_THEME}/gtk-3.0/gtk.css", "home/.local/share/themes/AliceNight/gtk-3.0/gtk.css"),
        FileSpec(f"{GTK_THEME}/gtk-3.0/gtk-dark.css", "home/.local/share/themes/AliceNight/gtk-3.0/gtk-dark.css"),
        FileSpec(f"{GTK_THEME}/gtk-4.0/gtk.css", "home/.local/share/themes/AliceNight/gtk-4.0/gtk.css"),
        FileSpec(f"{GTK_THEME}/gtk-4.0/gtk-dark.css", "home/.local/share/themes/AliceNight/gtk-4.0/gtk-dark.css"),
        FileSpec(".config/gtk-4.0/gtk.css", "gtk-4.0/gtk.css"),
    ], ["gtk"]),
    Target("qt6ct", "Qt apps (qt6ct palette)", [FileSpec(".config/qt6ct/colors/AliceNight.conf", "qt6ct/colors/AliceNight.conf", "qt6ct", True)]),
    Target("kde", "KDE color scheme + kdeglobals", [
        FileSpec(".local/share/color-schemes/AliceNight.colors", "home/.local/share/color-schemes/AliceNight.colors", "kde_scheme", True),
        FileSpec(".config/kdeglobals", "home/.config/kdeglobals", "kdeglobals", True),
    ]),
    Target("kitty", "kitty terminal (+ ANSI 16)", [FileSpec(".config/alice-rice/kitty.conf", "alice-rice/kitty.conf", "remap", warp=True)], ["kitty"]),
    Target("niri", "niri (focus ring, shadows)", [FileSpec(".config/niri/parts/colors.kdl", "niri/parts/colors.kdl")], ["niri"]),
    Target("waybar", "waybar", [FileSpec(".config/waybar/niri-left.css", "waybar/niri-left.css")], ["waybar"]),
    Target("swaync", "swaync notifications", [FileSpec(".config/swaync/style.css", "swaync/style.css")], ["swaync"]),
    Target("quickshell", "quickshell (bar + launcher)", [
        FileSpec(".config/quickshell/my-shell/TopBar.qml", "quickshell/my-shell/TopBar.qml"),
        FileSpec(".config/quickshell/my-shell/Launcher.qml", "quickshell/my-shell/Launcher.qml"),
        FileSpec(".config/quickshell/my-shell/TimeWidget.qml", "quickshell/my-shell/TimeWidget.qml"),
    ]),
    Target("fastfetch", "fastfetch", [FileSpec(".config/alice-rice/fastfetch.jsonc", "alice-rice/fastfetch.jsonc")]),
    Target("btop", "btop theme (rice uses TTY today)", [FileSpec(".config/btop/themes/alice-rice.theme", "btop/themes/alice-rice.theme", "btop_theme", True), FileSpec(".config/btop/btop.conf", "btop/btop.conf", "btop_conf")], ["btop"], default=False),
    Target("cava", "cava gradient (not used by the rice yet)", [FileSpec(".config/cava/config", "cava/config", "cava")], ["cava"], default=False),
]
TARGETS.append(Target("auto", "auto-found files (anything else using the palette)", []))
TARGET_BY_KEY = {t.key: t for t in TARGETS}

DISCOVER_EXT = {"", ".css", ".scss", ".qml", ".kdl", ".conf", ".toml", ".ini", ".jsonc", ".json", ".theme", ".rasi", ".lua", ".yml", ".yaml", ".colors", ".rc", ".vibe"}
DISCOVER_SKIP = {".git", "wallfliper", "rice-colors", "gtk-3.0/assets", "gtk-4.0/assets", "node_modules", "__pycache__", "Wallpapers"}


def discover_files(covered: set[Path], pals: list[Palette]) -> list[FileSpec]:
    roots = [(CONFIG, ""), (DATA / "themes", "home/.local/share/themes"), (DATA / "color-schemes", "home/.local/share/color-schemes")]
    out: list[FileSpec] = []
    for root, _ in roots:
        if not root.is_dir():
            continue
        for dp, dns, fns in os.walk(root):
            rel_dir = Path(dp).relative_to(root).as_posix()
            dns[:] = [d for d in dns if d not in DISCOVER_SKIP and f"{rel_dir}/{d}".lstrip("./") not in DISCOVER_SKIP]
            for fn in fns:
                f = Path(dp) / fn
                if f.suffix.lower() not in DISCOVER_EXT or f.resolve() in covered or fn == DEFAULT_FILE:
                    continue
                try:
                    if f.stat().st_size > 600_000:
                        continue
                    text = f.read_text(errors="strict")
                except (OSError, UnicodeDecodeError):
                    continue
                if max(score_palette(text, q) for q in pals) >= 3:
                    out.append(FileSpec(str(f.relative_to(HOME)) if f.is_relative_to(HOME) else str(f), "", "remap", canonical_source=False))
    return out


def repo_rel(live: Path) -> str:
    if live.is_relative_to(CONFIG):
        return live.relative_to(CONFIG).as_posix()
    if live.is_relative_to(DATA):
        return "home/.local/share/" + live.relative_to(DATA).as_posix()
    return live.relative_to(HOME).as_posix()


def find_repo(hint: str | None = None) -> Path | None:
    here = Path(__file__).resolve()
    cands = [hint, os.environ.get("RICE_REPO"), str(here.parents[2]) if len(here.parents) > 2 else None, os.popen("git -C %s rev-parse --show-toplevel 2>/dev/null" % str(here.parent)).read().strip() or None, str(HOME / "Projects/niri-dots-clean"), str(HOME / "niri-dots-clean"), str(HOME / "dotfiles"), str(HOME / ".dotfiles")]
    for c in cands:
        if c:
            p = Path(c).expanduser()
            if (p / "install.sh").is_file() and (p / "niri").is_dir():
                return p
    return None


# ───────────────────────────── state / backup ─────────────────────────────


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(st: dict) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=2))
    os.replace(tmp, STATE_FILE)


def palette_signature(p: Palette) -> dict:
    """The palette actually used to render a particular file."""
    return {"name": p.name, "roles": dict(p.roles), "ansi": list(p.ansi)}


def text_hash(text: str) -> str:
    """Stable content hash used to tell an untouched tracked file from a manual edit."""
    return hashlib.sha256(text.encode("utf-8", errors="replace")).hexdigest()


def file_palette_record(p: Palette, text: str) -> dict:
    return {
        "sha256": text_hash(text),
        "palette": palette_signature(p),
    }


def palette_from_signature(d: dict) -> Palette | None:
    try:
        if not isinstance(d, dict):
            return None
        # New state format nests the palette. Accept the old flat format too.
        payload = d.get("palette", d)
        if not isinstance(payload, dict):
            return None
        return finalize(
            Palette.from_dict({
                "name": payload.get("name", "tracked"),
                "roles": payload.get("roles", {}),
                "ansi": payload.get("ansi", []),
            }),
            rederive=False,
        )
    except Exception:
        return None


def known_palettes(st: dict) -> list[Palette]:
    out = [default_palette()]
    for d in st.get("history", []):
        try:
            out.append(Palette.from_dict(d))
        except Exception:
            pass
    if st.get("applied"):
        out.append(Palette.from_dict(st["applied"]))
    # Per-file palettes are real candidates too. They are especially useful
    # after a partial apply where there is no single global palette.
    tracked = st.get("file_palettes", {})
    if isinstance(tracked, dict):
        for d in tracked.values():
            p = palette_from_signature(d)
            if p is not None:
                out.append(p)
    return out


def atomic_write(path: Path, text: str) -> None:
    real = path.resolve() if path.is_symlink() else path
    real.parent.mkdir(parents=True, exist_ok=True)
    mode = real.stat().st_mode & 0o7777 if real.exists() else 0o644
    tmp = real.with_name(f".{real.name}.rice-tmp")
    tmp.write_text(text)
    os.chmod(tmp, mode)
    os.replace(tmp, real)


@dataclass
class Result:
    target: str
    path: str
    status: str
    detail: str = ""


def render_file(
    spec: FileSpec,
    text: str | None,
    pal: Palette,
    st_pals: list[Palette],
    known_source: Palette | None = None,
    tracked_hash: str | None = None,
) -> tuple[str | None, str, Palette | None]:
    """Return (new text | None, note, source palette used for remapping)."""
    k = spec.kind

    if k == "qt6ct":
        return qt6ct_text(pal), "generated", pal
    if k == "kde_scheme":
        return kde_scheme_text(pal), "generated", pal
    if k == "btop_theme":
        return btop_theme_text(pal), "generated", pal
    if text is None:
        return None, "missing", None
    if k == "kdeglobals":
        return kdeglobals_text(text, pal), "merged", pal
    if k == "btop_conf":
        new = re.sub(r'(?m)^(\s*color_theme\s*=\s*).*$', r'\1"alice-rice"', text)
        return new, "color_theme = alice-rice", pal
    if k == "kitty":
        return conf_set(text, kitty_kv(pal)), "keys set", pal
    if k == "cava":
        return ini_set(text, "color", cava_kv(pal)), "gradient set", pal

    # A content hash is much stronger than color scoring. If the file has not
    # changed since rice-colors last wrote it, the recorded source palette is
    # authoritative even when the file contains only one or two role colors.
    if known_source is not None and tracked_hash and tracked_hash == text_hash(text):
        new, n = remap_text(
            text,
            build_map(known_source, pal),
            Warp(known_source, pal) if spec.warp else None,
        )
        return new, f"{n} colors (tracked {known_source.name})", known_source

    # Backward-compatible tracking from the pre-hash state format.
    if known_source is not None and score_palette(text, known_source) >= 3:
        new, n = remap_text(
            text,
            build_map(known_source, pal),
            Warp(known_source, pal) if spec.warp else None,
        )
        return new, f"{n} colors (tracked {known_source.name})", known_source

    # Explicit rice files were authored against the stock palette. On first
    # application, prefer that known canonical source instead of guessing from
    # a tie between multiple historical wallpaper palettes. Auto-discovered
    # files opt out via spec.canonical_source=False.
    if spec.canonical_source:
        canonical = default_palette()
        canonical_score = score_palette(text, canonical)
        if canonical_score > 0:
            new, n = remap_text(
                text,
                build_map(canonical, pal),
                Warp(canonical, pal) if spec.warp else None,
            )
            return new, f"{n} colors (default source)", canonical

    # The file has been manually edited or is auto-discovered. Detect its
    # current palette. Ties prefer later candidates, which are newer tracked
    # palettes, not the built-in default.
    scored = [(score_palette(text, q), i, q) for i, q in enumerate(st_pals)]
    if not scored:
        return text, "no known palettes", None
    score, _, best = max(scored, key=lambda item: (item[0], item[1]))
    if score == 0:
        return text, "no known palette colors found", None

    new, n = remap_text(
        text,
        build_map(best, pal),
        Warp(best, pal) if spec.warp else None,
    )
    return new, f"{n} colors (detected {best.name})", best


def run_hooks(keys: set[str], log) -> None:
    def sh(cmd: list[str], note: str) -> None:
        if not shutil.which(cmd[0]):
            log(f"reload skipped: {note} ({cmd[0]} not found)")
            return
        try:
            r = subprocess.run(
                cmd,
                capture_output=True,
                text=True,
                timeout=8,
                check=False,
            )
        except (OSError, subprocess.SubprocessError) as exc:
            log(f"reload failed: {note}: {exc}")
            return

        if r.returncode == 0:
            log(f"reload: {note}")
            return

        detail = (r.stderr or r.stdout or "command failed").strip().replace("\n", " ")
        log(f"reload failed: {note}: {detail}")

    if "waybar" in keys:
        sh(["pkill", "-SIGUSR2", "-x", "waybar"], "waybar")
    if "swaync" in keys:
        sh(["swaync-client", "-rs"], "swaync css")
    if "kitty" in keys:
        sh(["pkill", "-SIGUSR1", "-x", "kitty"], "kitty (all windows)")
    if "cava" in keys:
        sh(["pkill", "-SIGUSR2", "-x", "cava"], "cava")
    if "btop" in keys:
        sh(["pkill", "-SIGUSR2", "-x", "btop"], "btop")
    if "niri" in keys:
        sh(["niri", "msg", "action", "load-config-file"], "niri config")

    if "gtk" in keys and shutil.which("gsettings"):
        cur = _run(
            ["gsettings", "get", "org.gnome.desktop.interface", "gtk-theme"]
        ).strip().strip("'")
        if cur:
            other = "Adwaita" if cur != "Adwaita" else "AliceNight"
            first = subprocess.run(
                ["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", other],
                capture_output=True,
                text=True,
                check=False,
            )
            time.sleep(0.25)
            second = subprocess.run(
                ["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", cur],
                capture_output=True,
                text=True,
                check=False,
            )
            if first.returncode == 0 and second.returncode == 0:
                log("reload: GTK theme re-set (open GTK apps refresh)")
            else:
                detail = (first.stderr or second.stderr or "gsettings failed").strip().replace("\n", " ")
                log(f"reload failed: GTK theme re-set: {detail}")


def apply_palette(pal: Palette, target_keys: list[str], repo: Path | None = None, dry_run: bool = False, reload: bool = True, log=print) -> list[Result]:
    pal = finalize(pal.copy(), rederive=False)
    st = load_state()
    st_pals = known_palettes(st)
    file_palettes = st.get("file_palettes", {})
    if not isinstance(file_palettes, dict):
        file_palettes = {}
    prev_file_palettes = json.loads(json.dumps(file_palettes))

    roots: list[tuple[str, Path | None]] = [("live", None)]
    if repo:
        roots.append(("repo", repo))
    stamp = time.strftime("%Y%m%d-%H%M%S")
    bdir = BACKUPS / stamp
    manifest = {"files": [], "prev_applied": st.get("applied"), "prev_file_palettes": prev_file_palettes}
    results: list[Result] = []
    seen: set[Path] = set()
    touched: set[str] = set()
    tracking_changed = False

    if "auto" in target_keys:
        covered = {(live_path(sp.live)).resolve() for t in TARGETS for sp in t.files}
        TARGET_BY_KEY["auto"].files = discover_files(covered, st_pals)
        for sp in TARGET_BY_KEY["auto"].files:
            sp.repo = repo_rel(live_path(sp.live))

    for key in target_keys:
        tgt = TARGET_BY_KEY.get(key)
        if not tgt:
            continue
        for root_name, root in roots:
            for spec in tgt.files:
                path = live_path(spec.live) if root is None else root / spec.repo
                shown = ("~/" + str(path.relative_to(HOME))) if path.is_relative_to(HOME) else str(path)
                if root is not None:
                    shown = f"[repo] {spec.repo}"
                real = path.resolve()
                if real in seen:
                    continue
                exists = path.is_file()
                text = path.read_text(errors="replace") if exists else None
                if not exists and not spec.create:
                    results.append(Result(key, shown, "missing"))
                    if str(real) in file_palettes:
                        del file_palettes[str(real)]
                        tracking_changed = True
                    continue

                record = file_palettes.get(str(real))
                known_source = palette_from_signature(record) if isinstance(record, dict) else None
                tracked_hash = record.get("sha256") if isinstance(record, dict) else None
                try:
                    new, note, source_used = render_file(
                        spec, text, pal, st_pals, known_source, tracked_hash
                    )
                except Exception as exc:
                    results.append(Result(key, shown, "error", str(exc)))
                    continue

                if new is None:
                    results.append(Result(key, shown, "unchanged", note))
                    seen.add(real)
                    continue

                if new == text:
                    # Generated/merged targets were deterministically rendered
                    # from `pal`; record that fact even when the bytes were
                    # already current. For remaps, only record when a source was
                    # actually identified.
                    if source_used is not None or spec.kind in {"qt6ct", "kde_scheme", "kdeglobals", "btop_theme", "btop_conf", "cava"}:
                        record = file_palette_record(pal, new)
                        if file_palettes.get(str(real)) != record:
                            file_palettes[str(real)] = record
                            tracking_changed = True
                    elif spec.kind == "remap" and str(real) in file_palettes:
                        del file_palettes[str(real)]
                        tracking_changed = True
                    results.append(Result(key, shown, "unchanged", note))
                    seen.add(real)
                    continue

                if not dry_run:
                    if exists:
                        bpath = bdir / str(real).lstrip("/")
                        bpath.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(real, bpath)
                        manifest["files"].append({"path": str(real), "backup": str(bpath)})
                    else:
                        manifest["files"].append({"path": str(real), "backup": None})
                    atomic_write(path, new)

                    # Verify the write and record the exact resulting content.
                    # This also makes future remapping independent of heuristic
                    # color detection.
                    try:
                        written = path.read_text(errors="replace")
                    except OSError as exc:
                        results.append(Result(key, shown, "error", f"write verification failed: {exc}"))
                        continue

                    if text_hash(written) != text_hash(new):
                        results.append(Result(key, shown, "error", "write verification failed: file content differs after write"))
                        continue

                    file_palettes[str(real)] = file_palette_record(pal, written)
                    tracking_changed = True
                    touched.add(key)
                seen.add(real)
                results.append(Result(key, shown, "ok", note))

    if not dry_run:
        st["file_palettes"] = file_palettes
        errors = [r for r in results if r.status == "error"]
        actionable = [r for r in results if r.status in {"ok", "unchanged"}]

        if touched:
            bdir.mkdir(parents=True, exist_ok=True)
            (bdir / "manifest.json").write_text(json.dumps(manifest, indent=2))

            hist = st.get("history", [])
            if not isinstance(hist, list):
                hist = []
            # Keep the requested palette in history even for a partial apply;
            # per-file tracking remains the source of truth for individual files.
            if st.get("applied"):
                hist.append(st["applied"])
            hist.append(pal.to_dict())
            uniq, sig = [], set()
            for d in hist[-30:]:
                s = json.dumps(d.get("roles", {}), sort_keys=True)
                if s not in sig:
                    sig.add(s)
                    uniq.append(d)
            st["history"] = uniq[-12:]

            # `applied` means the last fully successful palette application.
            # During a partial apply, the per-file records above are authoritative.
            if not errors:
                st["applied"] = pal.to_dict()

            dirs = sorted(d for d in BACKUPS.iterdir() if d.is_dir()) if BACKUPS.is_dir() else []
            for d in dirs[:-15]:
                shutil.rmtree(d, ignore_errors=True)

            if reload:
                hk = {h for k in touched for h in TARGET_BY_KEY[k].hooks}
                run_hooks(hk, log)

        if touched or tracking_changed:
            save_state(st)

    return results


def restore_last(reload: bool = True, log=print) -> str:
    dirs = sorted(d for d in BACKUPS.iterdir() if d.is_dir() and (d / "manifest.json").exists()) if BACKUPS.is_dir() else []
    if not dirs:
        return "nothing to restore"
    d = dirs[-1]
    man = json.loads((d / "manifest.json").read_text())
    n = 0
    for f in man["files"]:
        p = Path(f["path"])
        if f["backup"] and Path(f["backup"]).exists():
            p.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(f["backup"], p)
            n += 1
        elif f["backup"] is None and p.exists():
            p.unlink()
            n += 1
    st = load_state()
    if man.get("prev_applied"):
        st["applied"] = man["prev_applied"]
    else:
        st.pop("applied", None)
    if "prev_file_palettes" in man:
        st["file_palettes"] = man["prev_file_palettes"]
    save_state(st)
    shutil.rmtree(d, ignore_errors=True)
    if reload:
        run_hooks({"waybar", "swaync", "kitty", "cava", "btop", "niri", "gtk"}, log)
    return f"restored {n} files from {d.name}"


def save_default(repo: Path) -> tuple[Path, list[str]]:
    notes: list[str] = []
    p = Palette()
    kitty = repo / "alice-rice" / "kitty.conf"
    if kitty.is_file():
        kt = kitty.read_text()
        def kget(key: str) -> str | None:
            mo = re.search(rf"(?m)^{key}\s+(#[0-9a-fA-F]{{6}})\b", kt)
            return norm_hex(mo.group(1)) if mo else None
        for role, key in (("bg", "background"), ("fg", "foreground"), ("selection", "selection_background"), ("accent", "cursor")):
            v = kget(key)
            if v:
                if v != p.roles[role]:
                    notes.append(f"{role} changed in kitty.conf: {p.roles[role]} → {v}")
                p.roles[role] = v
        for i in range(16):
            v = kget(f"color{i}")
            if v:
                p.ansi[i] = v
    blob = ""
    for f in repo.rglob("*"):
        if f.is_file() and ".git" not in f.parts and f.suffix.lower() in DISCOVER_EXT | {".qml", ".kdl", ".jsonc", ".colors", ".conf", ".css"} and f.name not in (DEFAULT_FILE, "rice-colors") and f.stat().st_size < 3_000_000:
            try:
                blob += f.read_text(errors="ignore").lower() + "\n"
            except OSError:
                pass
    rgbs = set(re.findall(r"#([0-9a-f]{6})", blob))
    trip = {tuple(map(int, m)) for m in re.findall(r"(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})", blob)}
    for k, v in all_colors(p):
        if v.lstrip("#").lower() not in rgbs and h2rgb(v) not in trip:
            notes.append(f"role '{k}' ({v}) isn't used anywhere in the repo any more")
    qt = repo / "qt6ct" / "colors" / "AliceNight.conf"
    kde = repo / "home" / ".local" / "share" / "color-schemes" / "AliceNight.colors"
    if qt.is_file():
        p.extras["qt6ct"] = qt.read_text()
    else:
        notes.append("qt6ct/colors/AliceNight.conf not found — Qt colors will be generated instead")
    if kde.is_file():
        p.extras["kde"] = kde.read_text()
    else:
        notes.append("home/.local/share/color-schemes/AliceNight.colors not found — KDE colors will be generated")
    out = repo / "alice-rice" / DEFAULT_FILE
    out.parent.mkdir(parents=True, exist_ok=True)
    d = p.to_dict()
    d["_comment"] = "default theme of the rice — written by `rice-colors --save-default`; the app maps every palette from this"
    out.write_text(json.dumps(d, indent=2) + "\n")
    return out, notes


def cli_palette(args) -> Palette | None:
    if args.preset:
        pres = list_presets()
        if args.preset not in pres:
            raise SystemExit(f"no preset '{args.preset}'. have: {', '.join(pres)}")
        return finalize(pres[args.preset].copy(), rederive=False)
    if args.wallpaper or args.image:
        if args.image:
            img = Path(args.image).expanduser()
            note = "given image"
        else:
            img, note = detect_wallpaper()
        if not img or not img.is_file():
            raise SystemExit(f"could not find a wallpaper ({note})")
        if img.suffix.lower() in VIDEO_EXT - {".gif"}:
            img = video_frame(img) or img
        print(f"wallpaper: {img}  ({note})")
        return build_palette(extract_clusters(img), args.style, args.variant, name=img.stem)
    return None


def main_cli(args) -> int:
    if args.list_targets:
        for t in TARGETS:
            print(f"{t.key:11} {'on ' if t.default else 'off'} {t.label}")
        return 0
    if args.restore:
        print(restore_last(not args.no_reload))
        return 0
    if args.show_default:
        d = default_palette()
        src = next((str(f) for f in default_file_candidates() if f.is_file()), "built-in")
        print(f"default theme from {src}")
        for k, lbl, _ in BASE_ROLES + DERIVED_ROLES:
            print(f"  {lbl:12} {d[k]}")
        print("  ansi        ", " ".join(d.ansi))
        print("  verbatim files:", ", ".join(d.extras) or "none (qt/KDE are generated)")
        return 0
    if args.save_default:
        repo = find_repo(args.repo)
        if not repo:
            raise SystemExit("dotfiles repo not found (use --repo PATH)")
        out, notes = save_default(repo)
        print(f"wrote {out}")
        for n in notes:
            print(f"  note: {n}")
        return 0
    pal = cli_palette(args)
    if pal is None:
        return 1
    for k, lbl, _ in BASE_ROLES + DERIVED_ROLES:
        print(f"  {lbl:12} {pal[k]}")
    if args.apply:
        keys = args.targets.split(",") if args.targets else [t.key for t in TARGETS if t.default]
        bad = [k for k in keys if k not in TARGET_BY_KEY]
        if bad:
            raise SystemExit(f"unknown target(s): {', '.join(bad)}  (see --list-targets)")
        repo = find_repo(args.repo) if (args.repo or args.with_repo) else None
        if (args.repo or args.with_repo) and not repo:
            print("warning: dotfiles repo not found; only updating live files")
        for r in apply_palette(pal, keys, repo, args.dry_run, not args.no_reload):
            print(f"  {r.status:9} {r.target:10} {r.path}  {r.detail}")
        if args.dry_run:
            print("(dry run — nothing written)")
    return 0


def run_tui(args) -> int:
    try:
        from rich.text import Text
        from textual import on, work
        from textual.app import App, ComposeResult
        from textual.binding import Binding
        from textual.containers import Horizontal, Vertical, VerticalScroll
        from textual.theme import Theme
        from textual.widgets import (Button, DataTable, Footer, Header, Input, Label, RichLog, SelectionList, Static, TabbedContent, TabPane)
        from textual.widgets.selection_list import Selection
    except ImportError:
        print("missing textual. install it with: sudo pacman -S python-textual python-pillow")
        return 1

    def sw(h: str, n: int = 3) -> Text:
        return Text("█" * n, style=h)

    class RoleTable(DataTable):
        BINDINGS = [
            Binding("j", "cursor_down", "down", show=False), Binding("k", "cursor_up", "up", show=False),
            Binding("h", "nudge('h',-6)", "hue−", key_display="h/H"), Binding("H", "nudge('h',6)", "hue+", show=False),
            Binding("s", "nudge('s',-0.04)", "sat−", key_display="s/S"), Binding("S", "nudge('s',0.04)", "sat+", show=False),
            Binding("l", "nudge('l',-0.02)", "light−", key_display="l/L"), Binding("L", "nudge('l',0.02)", "light+", show=False),
            Binding("e", "edit", "edit hex"), Binding("x", "reset_role", "reset role"),
        ]
        def action_nudge(self, ch: str, amt: float) -> None:
            self.app.nudge(ch, amt)
        def action_edit(self) -> None:
            self.app.query_one("#hex", Input).focus()
        def action_reset_role(self) -> None:
            self.app.reset_role()

    class RiceColors(App):
        TITLE = "rice-colors"
        SUB_TITLE = "alice's palette studio"
        CSS = """
        Screen { background: $surface; }
        #roles { width: 46; height: 1fr; border: round $primary 50%; }
        #right { width: 1fr; padding: 0 1; }
        #preview { height: auto; padding: 0 0 1 0; }
        #editbar { height: 3; }
        #hex { width: 16; }
        #info { width: 1fr; padding: 1 1; }
        #presets { height: 3; }
        #preset-name { width: 24; }
        #wp-info { padding: 1 1; height: auto; }
        #wp-path { margin: 0 1; }
        .buttons { height: 3; margin: 0 1; }
        .buttons Button { margin-right: 1; }
        #wp-list { height: 1fr; margin: 0 1; border: round $primary 50%; }
        #clusters { padding: 0 2; height: auto; }
        #targets { width: 44; height: 1fr; border: round $primary 50%; }
        #apply-side { width: 1fr; padding: 0 1; }
        #log { height: 1fr; border: round $primary 50%; }
        #status { dock: bottom; height: 1; padding: 0 1; background: $boost; }
        """
        BINDINGS = [Binding("q", "quit", "quit"), Binding("1", "tab('palette')", "palette"), Binding("2", "tab('wallpaper')", "wallpaper"), Binding("3", "tab('apply')", "apply"), Binding("g", "generate", "from wallpaper"), Binding("n", "next_variant", "next variant"), Binding("A", "apply_now", "APPLY"), Binding("u", "undo", "undo last apply")]

        def rice_theme(self, pal: Palette, name: str) -> "Theme":
            r = pal.roles
            return Theme(name=name, dark=True, primary=r["accent"], secondary=r["pink"], accent=r["accent"], warning=r["warning"], error=r["accent"], success=r["success"], foreground=r["fg"], background=r["bg"], surface=r["bg_deep"], panel=r["navy"], boost=r["selection"] + "55")

        def wear_theme(self) -> None:
            self._theme_flip = not getattr(self, "_theme_flip", False)
            name = "rice-a" if self._theme_flip else "rice-b"
            self.register_theme(self.rice_theme(self.pal, name))
            self.theme = name

        def check_external(self) -> None:
            try:
                m = STATE_FILE.stat().st_mtime
            except OSError:
                return
            if m == self._state_mtime:
                return
            self._state_mtime = m
            st = load_state()
            if not st.get("applied"):
                return
            new = finalize(Palette.from_dict(st["applied"]), rederive=False)
            if new.roles == self.applied.roles and new.ansi == self.applied.ansi:
                return
            dirty = self.pal.roles != self.applied.roles or self.pal.ansi != self.applied.ansi
            self.applied = new.copy()
            if not dirty:
                self.pal = new
                self.refresh_all()
                self.status("the rice changed outside the app — following it")
            else:
                self.status("the rice changed outside the app (your unsaved edits are kept)")

        def __init__(self) -> None:
            super().__init__()
            st = load_state()
            base = Palette.from_dict(st["applied"]) if st.get("applied") else default_palette()
            self.pal: Palette = finalize(base.copy(), rederive=False)
            self.applied: Palette = self.pal.copy()
            self.style_i = 0
            self.variant = 0
            self.img: Path | None = None
            self.repo = find_repo(args.repo)
            self.busy = False
            try:
                self._state_mtime = STATE_FILE.stat().st_mtime
            except OSError:
                self._state_mtime = 0.0

        def compose(self) -> ComposeResult:
            yield Header()
            with TabbedContent(initial="palette"):
                with TabPane("1 Palette", id="palette"):
                    with Horizontal():
                        yield RoleTable(id="roles", cursor_type="row", zebra_stripes=True)
                        with Vertical(id="right"):
                            yield Static(id="preview")
                            with Horizontal(id="editbar"):
                                yield Input(placeholder="#RRGGBB", id="hex", max_length=7)
                                yield Static(id="info")
                            with Horizontal(id="presets"):
                                yield Input(placeholder="preset name", id="preset-name")
                                yield Button("save preset", id="save-preset")
                                yield Button("next preset", id="next-preset")
                                yield Button("reset all", id="reset-all")
                with TabPane("2 Wallpaper", id="wallpaper"):
                    with VerticalScroll():
                        yield Static(id="wp-info")
                        yield Input(placeholder="image path (Enter to load)", id="wp-path")
                        with Horizontal(classes="buttons"):
                            yield Button("use current wallpaper", id="wp-current", variant="primary")
                            yield Button("generate palette", id="wp-gen", variant="success")
                            yield Button("apply to rice", id="wp-apply", variant="warning")
                            yield Button("style: balanced", id="wp-style")
                            yield Button("next variant", id="wp-variant")
                        yield Static(id="clusters")
                        yield DataTable(id="wp-list", cursor_type="row")
                with TabPane("3 Apply", id="apply"):
                    with Horizontal():
                        yield SelectionList(*[Selection(t.label, t.key, t.default) for t in TARGETS], id="targets")
                        with Vertical(id="apply-side"):
                            yield Static(id="apply-info")
                            with Horizontal(classes="buttons"):
                                yield Button("APPLY", id="do-apply", variant="success")
                                yield Button("dry run", id="do-dry")
                                yield Button("undo last", id="do-undo", variant="warning")
                            with Horizontal(classes="buttons"):
                                yield Button("repo: off", id="tog-repo")
                                yield Button("reload: on", id="tog-reload")
                            yield RichLog(id="log", wrap=True, markup=False, highlight=False)
            yield Static(id="status")
            yield Footer()

        def on_mount(self) -> None:
            self.do_reload = True
            self.use_repo = False
            t = self.query_one("#roles", RoleTable)
            t.add_columns("role", "", "hex", "cr")
            self.fill_roles()
            wl = self.query_one("#wp-list", DataTable)
            wl.add_columns("wallpapers in ~/Wallpapers")
            for f in list_wallpapers():
                wl.add_row(f.name, key=str(f))
            self.refresh_all()
            self.set_interval(1.5, self.check_external)
            self.status("ready — h/s/l nudge the selected color, e edits the hex, g pulls a palette from your wallpaper")
            t.focus()
            self.query_one("#log", RichLog).write("nothing applied this session yet")

        def status(self, msg: str) -> None:
            self.query_one("#status", Static).update(msg)

        def row_keys(self) -> list[str]:
            return ROLE_KEYS + [f"ansi:{i}" for i in range(16)]
        def get_color(self, key: str) -> str:
            return self.pal.ansi[int(key[5:])] if key.startswith("ansi:") else self.pal.roles[key]
        def set_color(self, key: str, val: str) -> None:
            if key.startswith("ansi:"):
                self.pal.ansi[int(key[5:])] = val
            else:
                self.pal.roles[key] = val
                if key in dict((k, 0) for k, _, _ in BASE_ROLES):
                    derive(self.pal)
        def label_for(self, key: str) -> str:
            if key.startswith("ansi:"):
                i = int(key[5:])
                return f"ansi {i:>2} {'bright ' if i >= 8 else ''}{ANSI_NAMES[i % 8]}"
            lbl = ROLE_LABEL[key][0]
            return lbl if key in dict((k, 0) for k, _, _ in BASE_ROLES) else f"· {lbl}"
        def fill_roles(self) -> None:
            t = self.query_one("#roles", RoleTable)
            for k in self.row_keys():
                c = self.get_color(k)
                t.add_row(self.label_for(k), sw(c), c, f"{contrast(c, self.pal['bg']):.1f}", key=k)
        def refresh_roles(self) -> None:
            t = self.query_one("#roles", RoleTable)
            for k in self.row_keys():
                c = self.get_color(k)
                t.update_cell(k, t.ordered_columns[1].key, sw(c))
                t.update_cell(k, t.ordered_columns[2].key, c)
                t.update_cell(k, t.ordered_columns[3].key, f"{contrast(c, self.pal['bg']):.1f}")
        def cur_key(self) -> str | None:
            t = self.query_one("#roles", RoleTable)
            if t.row_count == 0:
                return None
            try:
                return t.coordinate_to_cell_key(t.cursor_coordinate).row_key.value
            except Exception:
                return None
        def refresh_all(self) -> None:
            self.wear_theme()
            self.refresh_roles()
            self.refresh_preview()
            self.refresh_info()
            dirty = json.dumps(self.pal.roles, sort_keys=True) != json.dumps(self.applied.roles, sort_keys=True) or self.pal.ansi != self.applied.ansi
            self.sub_title = f"{self.pal.name}{' *' if dirty else ''}  ·  A applies"
            self.query_one("#apply-info", Static).update(f"palette: {self.pal.name}{'  (unsaved changes)' if dirty else ''}\n" f"dotfiles repo: {self.repo if self.repo else 'not found (set RICE_REPO or --repo)'}\n" "APPLY backs up every file first — 'undo last' brings them back.")
        def refresh_info(self) -> None:
            k = self.cur_key()
            if not k:
                return
            c = self.get_color(k)
            h, s, l = h2hsl(c)
            lbl, hint = (self.label_for(k), "") if k.startswith("ansi:") else ROLE_LABEL[k]
            self.query_one("#info", Static).update(f"{lbl}  {hint}\nH {h:5.1f}°  S {s * 100:3.0f}%  L {l * 100:3.0f}%   " f"contrast vs bg {contrast(c, self.pal['bg']):.1f}:1")
            inp = self.query_one("#hex", Input)
            if not inp.has_focus:
                inp.value = c
        def refresh_preview(self) -> None:
            r = self.pal.roles
            W = 52
            T = Text()
            def line(segs, bg, pad=True):
                used = 0
                for txt, fg, *rest in segs:
                    st = f"{fg} on {rest[0] if rest else bg}" + (" bold" if len(rest) > 1 else "")
                    T.append(txt, style=st)
                    used += len(txt)
                if pad:
                    T.append(" " * max(0, W - used), style=f"on {bg}")
                T.append("\n")
            line([("  ", r["fg"]), (" 1 ", r["accent"], r["selection"]), (" 2 ", r["fg_dim"]), (" 3 ", r["fg_dim"]), ("      alice-rice         ", r["fg"]), (" 100% ", r["success"]), (" 12:30 ", r["fg_bright"])], r["navy"])
            line([(" ~/rice ", r["pink"]), ("❯ ", r["accent"]), ("rice-colors --wallpaper", r["fg"])], r["bg"])
            line([(" selected line looks like this        ", r["fg_bright"], r["selection"])], r["bg"])
            line([(" ok ", r["success"]), ("all good   ", r["fg"]), (" warn ", r["warning"]), ("careful   ", r["fg"]), (" err ", r["accent"]), ("uh oh", r["fg"])], r["bg"])
            line([(" dim text · borders · ", r["fg_dim"]), ("violet", r["violet"]), (" purple", r["purple"]), (" rose", r["rose"]), (" pink", r["pink"])], r["bg"])
            ans = [(" ", r["fg"])]
            for i in range(8): ans.append(("██", self.pal.ansi[i]))
            ans.append(("  ", r["fg"]))
            for i in range(8, 16): ans.append(("██", self.pal.ansi[i]))
            line(ans, r["bg"])
            line([(" ", r["fg"]), (" Notification ", r["fg_bright"], r["surface"], 1), ("  ", r["fg"]), (" Accent ", r["bg"], r["accent"], 1), (" ", r["fg"]), (" Pink ", r["fg_bright"], r["pink"], 1)], r["bg_deep"])
            self.query_one("#preview", Static).update(T)

        @on(DataTable.RowHighlighted, "#roles")
        def _hl(self, _e) -> None:
            self.refresh_info()
        @on(Input.Submitted, "#hex")
        def _hex_submit(self, e: Input.Submitted) -> None:
            k = self.cur_key(); v = norm_hex(e.value)
            if not k or not v:
                self.status(f"'{e.value}' isn't a hex color — try #RRGGBB"); return
            self.set_color(k, v); self.refresh_all(); self.query_one("#roles", RoleTable).focus(); self.status(f"{self.label_for(k)} → {v}")
        @on(Input.Submitted, "#wp-path")
        def _wp_path(self, e: Input.Submitted) -> None:
            self.load_image(Path(e.value).expanduser())
        @on(DataTable.RowSelected, "#wp-list")
        def _wp_pick(self, e: DataTable.RowSelected) -> None:
            self.load_image(Path(e.row_key.value)); self.generate()
        @on(Button.Pressed)
        def _btn(self, e: Button.Pressed) -> None:
            bid = e.button.id
            if bid == "save-preset":
                nm = self.query_one("#preset-name", Input).value.strip() or self.pal.name
                f = save_preset(self.pal, nm); self.pal.name = f.stem; self.refresh_all(); self.status(f"saved preset → {f}")
            elif bid == "next-preset":
                pres = list(list_presets().items()); names = [n for n, _ in pres]; i = (names.index(self.pal.name) + 1) % len(names) if self.pal.name in names else 0
                self.pal = finalize(pres[i][1].copy(), rederive=False); self.pal.name = names[i]; self.refresh_all(); self.status(f"loaded preset {names[i]}")
            elif bid == "reset-all":
                self.pal = default_palette(); self.refresh_all(); self.status("reset to the rice's default theme")
            elif bid == "wp-current": self.use_current()
            elif bid == "wp-gen": self.generate()
            elif bid == "wp-style":
                self.style_i = (self.style_i + 1) % len(STYLES); e.button.label = f"style: {STYLES[self.style_i]}";
                if self.img: self.generate()
            elif bid == "wp-variant": self.action_next_variant()
            elif bid in ("do-apply", "wp-apply"): self.action_apply_now()
            elif bid == "do-dry": self.run_apply(dry=True)
            elif bid == "do-undo": self.action_undo()
            elif bid == "tog-repo":
                if not self.repo: self.status("no dotfiles repo found — start with --repo PATH or set RICE_REPO"); return
                self.use_repo = not self.use_repo; e.button.label = f"repo: {'ON' if self.use_repo else 'off'}"
            elif bid == "tog-reload": self.do_reload = not self.do_reload; e.button.label = f"reload: {'on' if self.do_reload else 'OFF'}"

        def action_tab(self, name: str) -> None:
            self.set_focus(None); self.query_one(TabbedContent).active = name; first = {"palette": "#roles", "wallpaper": "#wp-current", "apply": "#do-apply"}.get(name)
            if first: self.call_after_refresh(lambda: self.query_one(first).focus())
        @on(TabbedContent.TabActivated)
        def _tab_changed(self, e: TabbedContent.TabActivated) -> None:
            pane = e.pane.id; first = {"palette": "#roles", "wallpaper": "#wp-current", "apply": "#do-apply"}.get(pane or "")
            if first and (self.focused is None or not any(a is e.pane for a in self.focused.ancestors)):
                self.call_after_refresh(lambda: self.query_one(first).focus())
        def nudge(self, ch: str, amt: float) -> None:
            k = self.cur_key()
            if not k: return
            h, s, l = h2hsl(self.get_color(k))
            if ch == "h": h += amt
            elif ch == "s": s = max(0.0, min(1.0, s + amt))
            else: l = max(0.0, min(1.0, l + amt))
            self.set_color(k, hsl2h(h, s, l)); self.refresh_all()
        def reset_role(self) -> None:
            k = self.cur_key()
            if not k: return
            if k.startswith("ansi:"): self.set_color(k, self.applied.ansi[int(k[5:])])
            else: self.set_color(k, self.applied.roles[k])
            self.refresh_all(); self.status(f"{self.label_for(k)} reset to the last applied value")
        def use_current(self) -> None:
            img, note = detect_wallpaper()
            if not img: self.status("couldn't find your wallpaper — type a path below"); return
            self.load_image(img, note); self.generate()
        def load_image(self, p: Path, note: str = "") -> None:
            if not p.is_file(): self.status(f"not a file: {p}"); return
            if p.suffix.lower() in VIDEO_EXT - {".gif"}:
                fr = video_frame(p)
                if not fr: self.status("video wallpaper but ffmpeg couldn't grab a frame"); return
                note = note or f"frame of {p.name}"; p = fr
            self.img = p; self.query_one("#wp-path", Input).value = str(p); self.query_one("#wp-info", Static).update(f"source image: {p}\n{note}")
        def action_generate(self) -> None:
            self.action_tab("wallpaper")
            if self.img is None: self.use_current()
            else: self.generate()
        def action_next_variant(self) -> None:
            self.variant += 1
            if self.img: self.generate()
            else: self.use_current()
        def generate(self) -> None:
            if self.img is None or self.busy: return
            self.busy = True; self.status("reading colors from the image…"); self.gen_worker(self.img, STYLES[self.style_i], self.variant)
        @work(thread=True, exclusive=True)
        def gen_worker(self, img: Path, style: str, variant: int) -> None:
            try:
                cl = extract_clusters(img); pal = build_palette(cl, style, variant, name=img.stem); self.call_from_thread(self.gen_done, cl, pal, style, variant)
            except Exception as exc:
                self.call_from_thread(self.gen_fail, str(exc))
        def gen_fail(self, msg: str) -> None:
            self.busy = False; self.status(f"couldn't read image: {msg}")
        def gen_done(self, cl, pal, style, variant) -> None:
            self.busy = False; self.pal = pal; t = Text(); t.append("dominant colors: ")
            for c in cl[:12]: t.append("██", style=c.hex)
            self.query_one("#clusters", Static).update(t); self.refresh_all(); self.status(f"palette from {pal.name} · style {style} · variant {variant} — click apply-to-rice or press A to apply, n for another take")
        def selected_targets(self) -> list[str]:
            return list(self.query_one("#targets", SelectionList).selected)
        def action_apply_now(self) -> None:
            if self.busy:
                self.status("palette generation is still running…"); return
            self.run_apply(dry=False)
        def run_apply(self, dry: bool) -> None:
            if self.busy:
                self.status("palette generation is still running…"); return
            keys = self.selected_targets()
            if not keys: self.status("no targets selected (tab 3)"); return
            self.action_tab("apply"); log = self.query_one("#log", RichLog); log.clear(); repo = self.repo if self.use_repo else None
            hook_msgs: list[str] = []
            results = apply_palette(self.pal, keys, repo, dry, self.do_reload, hook_msgs.append)
            for r in results: log.write(f"{r.status:9} {r.target:10} {r.path}  {r.detail}")
            for m in hook_msgs: log.write(m)
            ok = sum(1 for r in results if r.status == "ok")
            errors = sum(1 for r in results if r.status == "error")
            if dry:
                log.write("— dry run, nothing written —")
            else:
                if errors == 0 and any(r.status in {"ok", "unchanged"} for r in results):
                    self.applied = self.pal.copy()
                self.refresh_all()
                try: self._state_mtime = STATE_FILE.stat().st_mtime
                except OSError: pass
            status = f"{'would change' if dry else 'changed'} {ok} files"
            if errors: status += f" · {errors} failed"
            self.status(status)
        def action_undo(self) -> None:
            log = self.query_one("#log", RichLog); msg = restore_last(self.do_reload, lambda m: log.write(m)); log.write(msg); st = load_state()
            self.pal = finalize(Palette.from_dict(st["applied"]) if st.get("applied") else default_palette(), rederive=False); self.applied = self.pal.copy(); self.refresh_all()
            try: self._state_mtime = STATE_FILE.stat().st_mtime
            except OSError: pass
            self.status(msg)

    RiceColors().run()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="rice-colors", description="palette editor + wallpaper color generator")
    ap.add_argument("--wallpaper", action="store_true", help="build a palette from the current wallpaper")
    ap.add_argument("--image", metavar="FILE", help="build a palette from this image")
    ap.add_argument("--preset", metavar="NAME", help="use a saved preset (AliceNight = stock)")
    ap.add_argument("--style", choices=STYLES, default="balanced")
    ap.add_argument("--variant", type=int, default=0, help="alternate take on the same image (0,1,2…)")
    ap.add_argument("--apply", action="store_true", help="write the palette into the rice")
    ap.add_argument("--targets", metavar="a,b,c", help="only these targets (see --list-targets)")
    ap.add_argument("--repo", metavar="PATH", help="dotfiles repo checkout; also updates it")
    ap.add_argument("--with-repo", action="store_true", help="also update the auto-detected dotfiles repo")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--no-reload", action="store_true", help="don't signal running apps to reload")
    ap.add_argument("--restore", action="store_true", help="undo the last apply")
    ap.add_argument("--list-targets", action="store_true")
    ap.add_argument("--save-default", action="store_true", help="snapshot the repo's current rice as the default theme (alice-rice/palette.json)")
    ap.add_argument("--show-default", action="store_true", help="print the default theme")
    args = ap.parse_args()
    if args.wallpaper or args.image or args.preset or args.restore or args.list_targets or args.save_default or args.show_default:
        return main_cli(args)
    return run_tui(args)


if __name__ == "__main__":
    sys.exit(main())
