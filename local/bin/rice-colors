#!/usr/bin/env python3
"""
rice-colors — palette editor + wallpaper color generator for alice's niri rice

A terminal UI that owns the rice's color palette and pushes it into every
themed app: GTK 3/4 (AliceNight), qt6ct, the KDE color scheme + kdeglobals,
kitty, niri, waybar, swaync, quickshell, fastfetch, btop and cava.

  * edit any role by hex, or nudge hue / saturation / lightness with the keys
  * generate a whole palette from your CURRENT wallpaper (awww / wallfliper)
  * live preview, save/load presets, apply with automatic backup + undo

Usage:
    rice-colors                       open the TUI
    rice-colors --wallpaper --apply   palette from current wallpaper, apply it
    rice-colors --image FILE --apply  palette from a specific image
    rice-colors --preset NAME --apply apply a saved preset ("AliceNight" = stock)
    rice-colors --restore             undo the last apply
    rice-colors --list-targets

Needs: python-textual, python-pillow   (sudo pacman -S python-textual python-pillow)
"""

from __future__ import annotations

import argparse
import colorsys
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

# ───────────────────────────── paths ─────────────────────────────

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "rice-colors"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "rice-colors"
PRESET_DIR = CONFIG / "rice-colors" / "palettes"
STATE_FILE = STATE / "state.json"
BACKUPS = STATE / "backups"
IMAGE_EXT = {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif", ".tif", ".tiff"}
VIDEO_EXT = {".mp4", ".mkv", ".webm", ".mov", ".avi", ".gif"}


def live_path(rel: str) -> Path:
    """Map a '~'-relative path to the live location (honours XDG dirs)."""
    if rel.startswith(".config/"):
        return CONFIG / rel[len(".config/"):]
    if rel.startswith(".local/share/"):
        return DATA / rel[len(".local/share/"):]
    return HOME / rel


# ───────────────────────────── color math ─────────────────────────────


def norm_hex(s: str) -> str | None:
    s = s.strip().lstrip("#")
    if len(s) == 3 and re.fullmatch(r"[0-9a-fA-F]{3}", s):
        s = "".join(c * 2 for c in s)
    if re.fullmatch(r"[0-9a-fA-F]{6}", s):
        return "#" + s.upper()
    return None


def h2rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def rgb2h(rgb) -> str:
    r, g, b = (max(0, min(255, int(round(v)))) for v in rgb)
    return f"#{r:02X}{g:02X}{b:02X}"


def h2hsl(h: str) -> tuple[float, float, float]:
    r, g, b = (v / 255 for v in h2rgb(h))
    hh, ll, ss = colorsys.rgb_to_hls(r, g, b)
    return hh * 360.0, ss, ll


def hsl2h(h: float, s: float, l: float) -> str:
    r, g, b = colorsys.hls_to_rgb((h % 360.0) / 360.0, max(0.0, min(1.0, l)), max(0.0, min(1.0, s)))
    return rgb2h((r * 255, g * 255, b * 255))


def mix(a: str, b: str, t: float) -> str:
    ar, br = h2rgb(a), h2rgb(b)
    return rgb2h([ar[i] + (br[i] - ar[i]) * t for i in range(3)])


def lum(h: str) -> float:
    def f(c):
        c /= 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4

    r, g, b = h2rgb(h)
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b)


def contrast(a: str, b: str) -> float:
    la, lb = sorted((lum(a), lum(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def ensure_contrast(color: str, bg: str, ratio: float) -> str:
    """Move `color`'s lightness away from `bg` until it reaches `ratio`."""
    h, s, l = h2hsl(color)
    up = lum(bg) < 0.4
    for _ in range(60):
        c = hsl2h(h, s, l)
        if contrast(c, bg) >= ratio:
            return c
        l += 0.012 if up else -0.012
        if l >= 0.98 or l <= 0.02:
            break
    return hsl2h(h, s, l)


def hue_dist(a: float, b: float) -> float:
    d = abs(a - b) % 360
    return min(d, 360 - d)


def hue_mix(a: float, b: float, t: float) -> float:
    d = ((b - a + 180) % 360) - 180
    return (a + d * t) % 360


# ───────────────────────────── palette model ─────────────────────────────

# (key, label, hint) — editable base roles
BASE_ROLES = [
    ("bg", "background", "window / terminal bg"),
    ("navy", "navy", "panels, buttons"),
    ("selection", "selection", "selected / hover bg"),
    ("fg", "foreground", "normal text"),
    ("fg_bright", "fg bright", "headings, highlights"),
    ("accent", "accent", "focus ring, cursor"),
    ("pink", "pink", "secondary accent"),
    ("rose", "rose", "tertiary accent"),
    ("violet", "violet", "borders, dim accents"),
    ("purple", "purple", "dim accents"),
    ("success", "success", "ok / positive"),
    ("warning", "warning", "caution"),
]
# derived from the base roles (recomputed when a base role is edited)
DERIVED_ROLES = [
    ("bg_deep", "bg deep", "views, inputs"),
    ("surface", "surface", "raised surfaces"),
    ("border_soft", "border soft", "hairlines"),
    ("fg_dim", "fg dim", "secondary text"),
]
ROLE_KEYS = [k for k, _, _ in BASE_ROLES] + [k for k, _, _ in DERIVED_ROLES]
ROLE_LABEL = {k: (lbl, hint) for k, lbl, hint in BASE_ROLES + DERIVED_ROLES}

# stock AliceNight — exactly what is hard-coded in the repo today
STOCK_ROLES = {
    "bg": "#09152F", "navy": "#0F183D", "selection": "#2C1F4E",
    "fg": "#D9CFE0", "fg_bright": "#F3EAF2", "accent": "#EF6261",
    "pink": "#B63A6C", "rose": "#9B346B", "violet": "#5F295D",
    "purple": "#67315F", "success": "#7FA68A", "warning": "#D8B45F",
    "bg_deep": "#0D1730", "surface": "#2F2940", "border_soft": "#2C3454",
    "fg_dim": "#C8C0CC",
}
STOCK_ANSI = [
    "#3A2850", "#B63A6C", "#7A3A70", "#EF6261", "#33468A", "#9B346B", "#79416F", "#D9CFE0",
    "#523B69", "#FF6470", "#D24B78", "#FF746F", "#5268A8", "#B95C98", "#986090", "#F3EAF2",
]
ANSI_NAMES = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]


@dataclass
class Palette:
    name: str = "AliceNight"
    roles: dict[str, str] = field(default_factory=lambda: dict(STOCK_ROLES))
    ansi: list[str] = field(default_factory=lambda: list(STOCK_ANSI))
    # verbatim snapshot of hand-tuned files of the default theme (qt6ct / KDE scheme);
    # only the default palette carries these, every other palette derives them by warping
    extras: dict = field(default_factory=dict)

    def copy(self) -> "Palette":
        return Palette(self.name, dict(self.roles), list(self.ansi), self.extras)

    def to_dict(self) -> dict:
        return {"name": self.name, "roles": self.roles, "ansi": self.ansi}

    @staticmethod
    def from_dict(d: dict) -> "Palette":
        p = Palette()
        p.name = str(d.get("name", "custom"))
        for k in ROLE_KEYS:
            v = norm_hex(str(d.get("roles", {}).get(k, ""))) or p.roles[k]
            p.roles[k] = v
        ans = d.get("ansi") or []
        if len(ans) == 16:
            p.ansi = [norm_hex(str(a)) or STOCK_ANSI[i] for i, a in enumerate(ans)]
        if isinstance(d.get("extras"), dict):
            p.extras = {k: v for k, v in d["extras"].items() if isinstance(v, str)}
        return p

    def __getitem__(self, k: str) -> str:
        return self.roles[k]

    # rgb-only pseudo roles that appear as rgba(...) in the GTK / waybar css
    def shade1(self) -> str:
        return mix(self["bg"], "#000000", 0.57)

    def shade2(self) -> str:
        return mix(self["bg"], "#000000", 0.27)


def derive(p: Palette) -> None:
    r = p.roles
    r["bg_deep"] = mix(r["bg"], r["navy"], 0.30)
    r["surface"] = mix(mix(r["selection"], r["bg"], 0.45), r["fg"], 0.05)
    r["border_soft"] = mix(r["navy"], r["fg"], 0.15)
    r["fg_dim"] = mix(r["fg"], r["bg"], 0.08)


def all_colors(p: Palette) -> list[tuple[str, str]]:
    out = [(k, p.roles[k]) for k in ROLE_KEYS]
    out += [("shade1", p.shade1()), ("shade2", p.shade2())]
    return out


def finalize(p: Palette, rederive: bool = True) -> Palette:
    """Normalise hexes and make every remap-relevant color unique.

    Remapping works by exact color match, so two roles sharing one hex would
    merge irreversibly. Duplicates get a 1-step nudge (invisible to the eye).
    """
    for k in ROLE_KEYS:
        p.roles[k] = norm_hex(p.roles[k]) or STOCK_ROLES[k]
    p.ansi = [norm_hex(a) or STOCK_ANSI[i] for i, a in enumerate(p.ansi)]
    if rederive:
        derive(p)
    seen: set[tuple[int, int, int]] = set()
    for k in ROLE_KEYS:
        rgb = list(h2rgb(p.roles[k]))
        for _ in range(8):
            if tuple(rgb) not in seen:
                break
            rgb[2] = rgb[2] + 1 if rgb[2] < 255 else rgb[2] - 1
        seen.add(tuple(rgb))
        p.roles[k] = rgb2h(rgb)
    return p


DEFAULT_FILE = "palette.json"
_DEFAULT: Palette | None = None


def default_file_candidates() -> list[Path]:
    here = Path(__file__).resolve()
    c = [CONFIG / "alice-rice" / DEFAULT_FILE]
    if len(here.parents) > 2:
        c.append(here.parents[2] / "alice-rice" / DEFAULT_FILE)
    return c


def default_palette() -> Palette:
    """The rice's own default theme: alice-rice/palette.json (a snapshot of the
    dotfiles repo), falling back to the built-in copy of the same colors."""
    global _DEFAULT
    if _DEFAULT is None:
        _DEFAULT = Palette()
        for f in default_file_candidates():
            try:
                _DEFAULT = Palette.from_dict(json.loads(f.read_text()))
                _DEFAULT.name = "AliceNight"
                break
            except (OSError, ValueError):
                continue
    return _DEFAULT.copy()


def builtin_presets() -> dict[str, Palette]:
    return {"AliceNight": default_palette()}


def list_presets() -> dict[str, Palette]:
    out = builtin_presets()
    if PRESET_DIR.is_dir():
        for f in sorted(PRESET_DIR.glob("*.json")):
            try:
                p = Palette.from_dict(json.loads(f.read_text()))
                p.name = p.name or f.stem
                out[f.stem] = p
            except (OSError, ValueError):
                continue
    return out


def save_preset(p: Palette, name: str) -> Path:
    name = re.sub(r"[^\w.\- ]", "", name).strip() or "custom"
    PRESET_DIR.mkdir(parents=True, exist_ok=True)
    q = p.copy()
    q.name = name
    f = PRESET_DIR / f"{name}.json"
    f.write_text(json.dumps(q.to_dict(), indent=2))
    return f


def wrap180(d: float) -> float:
    return ((d + 180.0) % 360.0) - 180.0


class Warp:
    """Moves any color the same way the palette's base roles moved (old → new).

    Exact role colors are handled by exact remapping elsewhere; this carries the
    colors in between (qt6ct's dimmed shades, KDE's inactive/alternate variants, ...)
    along, interpolating hue shift / saturation / lightness between the nearest roles.
    """

    def __init__(self, old: Palette, new: Palette):
        rows = []
        for k, _, _ in BASE_ROLES:
            ho, so, lo = h2hsl(old[k])
            hn, sn, ln = h2hsl(new[k])
            if so < 0.08 or sn < 0.02:
                continue
            rows.append((ho, wrap180(hn - ho), max(0.3, min(2.5, sn / so)), ln - lo))
        rows.sort()
        groups: list[list] = []
        for r in rows:
            if groups and abs(r[0] - groups[-1][-1][0]) < 3:
                groups[-1].append(r)
            else:
                groups.append([r])
        self.pts = [tuple(sum(c) / len(g) for c in zip(*g)) for g in groups]
        self.identity = all(abs(p[1]) < 0.01 and abs(p[2] - 1) < 0.002 and abs(p[3]) < 0.002 for p in self.pts)

    def __call__(self, hx: str) -> str:
        if self.identity or not self.pts:
            return hx
        h, s, l = h2hsl(hx)
        if s < 0.04:
            return hx
        pts = self.pts
        ext = [(pts[-1][0] - 360, *pts[-1][1:])] + list(pts) + [(pts[0][0] + 360, *pts[0][1:])]
        for i in range(len(ext) - 1):
            a, b = ext[i], ext[i + 1]
            if a[0] <= h <= b[0]:
                t = (h - a[0]) / max(1e-6, b[0] - a[0])
                dh = a[1] + (b[1] - a[1]) * t
                sr = a[2] + (b[2] - a[2]) * t
                dl = a[3] + (b[3] - a[3]) * t
                break
        else:
            dh, sr, dl = 0.0, 1.0, 0.0
        f = min(1.0, s / 0.2)  # near-greys follow hue but barely change in sat/light
        return hsl2h(h + dh, min(1.0, max(0.0, s * (1 + (sr - 1) * f))), min(0.98, max(0.0, l + dl * f)))


QT_ARGB = re.compile(r"#([0-9a-fA-F]{2})([0-9a-fA-F]{6})(?![0-9a-fA-F])")
KDE_RGB = re.compile(r"(?m)^(\s*[A-Za-z]\w*\s*=\s*)(\d{1,3}),(\d{1,3}),(\d{1,3})[ \t]*$")


def warp_qt6ct(text: str, w: Warp) -> str:
    def f(mo):
        lo = mo.group(2) == mo.group(2).lower()
        n = w("#" + mo.group(2)).lstrip("#")
        return "#" + mo.group(1) + (n.lower() if lo else n.upper())
    return QT_ARGB.sub(f, text)


def warp_kde(text: str, w: Warp) -> str:
    def f(mo):
        rgb = (int(mo.group(2)), int(mo.group(3)), int(mo.group(4)))
        if max(rgb) > 255:
            return mo.group(0)
        n = h2rgb(w(rgb2h(rgb)))
        return f"{mo.group(1)}{n[0]},{n[1]},{n[2]}"
    return KDE_RGB.sub(f, text)


# ───────────────────────────── wallpaper → palette ─────────────────────────────


@dataclass
class Cluster:
    h: float
    s: float
    l: float
    w: float
    hex: str
    pop: bool = False   # a small, bright, saturated feature (sun, moon, neon sign)


STYLES = ["balanced", "vibrant", "muted"]
SAT_SCALE = {"balanced": 1.0, "vibrant": 1.25, "muted": 0.68}


def _pil():
    try:
        from PIL import Image  # noqa: WPS433

        return Image
    except ImportError:
        raise SystemExit("missing Pillow. install it with: sudo pacman -S python-pillow")


def extract_clusters(path: Path, k: int = 16) -> list[Cluster]:
    Image = _pil()
    im = Image.open(path)
    try:
        im.draft("RGB", (400, 400))
    except Exception:  # noqa: BLE001
        pass
    im = im.convert("RGB")
    im.thumbnail((220, 220))
    q = im.quantize(colors=k, method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette() or []
    counts = q.getcolors() or []
    total = sum(c for c, _ in counts) or 1
    out = []
    for cnt, idx in counts:
        hx = rgb2h(pal[idx * 3: idx * 3 + 3])
        h, s, l = h2hsl(hx)
        out.append(Cluster(h, s, l, cnt / total, hx))
    out.sort(key=lambda c: -c.w)
    # small bright saturated features get lost in a 16-colour quantise — find them separately
    _rgbim = im.convert("RGB")
    px = list((getattr(_rgbim, "get_flattened_data", None) or _rgbim.getdata)())
    bins: dict[int, list] = {}
    for r, g, b in px:
        hh, ss, vv = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        if ss >= 0.45 and vv >= 0.62:
            bins.setdefault(int(hh * 360 // 30), []).append((r, g, b))
    for items in bins.values():
        if len(items) / len(px) >= 0.004:
            m = [sum(c[i] for c in items) / len(items) for i in range(3)]
            hx = rgb2h(m)
            h, s_, l = h2hsl(hx)
            out.append(Cluster(h, s_, l, len(items) / len(px), hx, pop=True))
    return out


class HueMap:
    """Lays the rice's own hue arc (bg → pink → purple → accent) onto the wallpaper's arc."""

    def __init__(self, old_bg: float, old_acc: float, new_bg: float, new_delta: float):
        self.ob, self.nb, self.nd = old_bg % 360, new_bg % 360, new_delta
        self.l0 = (old_acc - old_bg) % 360 or 1.0
        self.slope = new_delta / self.l0
        self.off_acc = wrap180((self.nb + self.nd) - (self.ob + self.l0))
        self.off_bg = wrap180(self.nb - self.ob)

    def __call__(self, h: float) -> float:
        u = (h - self.ob) % 360
        if u <= self.l0:
            return (self.nb + self.slope * u) % 360
        wa = max(0.0, 1 - (u - self.l0) / 45)   # just past the accent end
        wb = max(0.0, 1 - (360 - u) / 45)       # just before the bg end
        return (h + self.off_acc * wa + self.off_bg * wb) % 360   # greens / golds stay put


def _chroma(clusters: list[Cluster]) -> list[Cluster]:
    return [c for c in clusters if c.s >= 0.18 and 0.10 <= c.l <= 0.93]


def _circ_mean(items: list[tuple[float, float]]) -> float:
    import math

    x = sum(math.cos(math.radians(h)) * w for h, w in items)
    y = sum(math.sin(math.radians(h)) * w for h, w in items)
    return math.degrees(math.atan2(y, x)) % 360


def analyze_wallpaper(clusters: list[Cluster], base: Palette, variant: int = 0) -> dict:
    """Decide the wallpaper's bg hue, accent hue and the arc between them."""
    bh = h2hsl(base["bg"])[0]
    ch = _chroma(clusters)
    clusters = [c for c in clusters if not c.pop] if any(not c.pop for c in clusters) else clusters
    dark = [c for c in clusters if c.l < 0.40 and c.s > 0.12]
    if dark:
        h_bg = _circ_mean([(c.h, c.w * c.s) for c in dark])
        s_bg = sum(c.s * c.w for c in dark) / sum(c.w for c in dark)
    elif ch:
        h_bg = _circ_mean([(c.h, c.w * c.s) for c in ch])
        s_bg = sum(c.s * c.w for c in ch) / sum(c.w for c in ch)
    else:  # greyscale picture: keep the rice's own navy
        h_bg, s_bg = bh, 0.3
    # accent = the most eye-catching colour that isn't the background itself
    # (small bright things — a sun, a moon, neon — beat big dull areas)
    cand = [c for c in ch if c.l >= 0.34 and hue_dist(c.h, h_bg) >= 45]
    cand.sort(key=lambda c: -((c.w ** 0.35) * c.s * (0.45 + c.l) * (1.7 if c.pop else 1.0)))
    picks: list[Cluster] = []
    for c in cand:
        if all(hue_dist(c.h, q.h) >= 28 for q in picks):
            picks.append(c)
        if len(picks) >= 5:
            break
    acc = picks[variant % len(picks)] if picks else None
    if acc is not None:
        h_acc = acc.h
        d_short = wrap180(h_acc - h_bg)
        d_long = d_short - (360 if d_short > 0 else -360)

        def coverage(delta: float) -> float:
            tot = 0.0
            for c in ch:
                u = wrap180(c.h - h_bg) if abs(delta) <= 180 else (c.h - h_bg) % 360
                if delta >= 0:
                    inside = 0 <= ((c.h - h_bg) % 360) <= delta
                else:
                    inside = 0 <= ((h_bg - c.h) % 360) <= -delta
                if inside:
                    tot += c.w * c.s
            return tot

        delta = d_short
        if abs(d_long) <= 250 and coverage(d_long) > 1.6 * coverage(d_short):
            delta = d_long
        if abs(delta) < 30:  # near-monochrome picture: a tight analogous arc
            delta = 45.0 if delta >= 0 else -45.0
            h_acc = (h_bg + delta) % 360
        acc_s, acc_l = acc.s, acc.l
    else:  # nothing stands out: analogous accent
        delta = 45.0
        h_acc = (h_bg + delta) % 360
        acc_s, acc_l = 0.6, 0.66
    wall_sat = (sum(c.s * c.w for c in ch) / sum(c.w for c in ch)) if ch else 0.3
    return dict(h_bg=h_bg, s_bg=s_bg, h_acc=h_acc, delta=delta, acc_s=acc_s, acc_l=acc_l, wall_sat=wall_sat)


def build_palette(clusters: list[Cluster], style: str = "balanced", variant: int = 0,
                  name: str = "wallpaper") -> Palette:
    """Palette for a wallpaper. Starts from the rice's own default theme and carries it
    onto the wallpaper: same lightness/contrast structure, same role layout, but the hue
    arc between background and accent follows the picture's own colors."""
    base = default_palette()
    a = analyze_wallpaper(clusters, base, variant)
    hm = HueMap(h2hsl(base["bg"])[0], h2hsl(base["accent"])[0], a["h_bg"], a["delta"])
    # saturation follows the picture (stock rice ≈ 0.6 average) and the chosen style
    sat_f = SAT_SCALE.get(style, 1.0) * max(0.62, min(1.12, 0.55 + a["wall_sat"] * 0.75))

    def carry(hx: str, keep_hue: bool = False) -> str:
        h, s, l = h2hsl(hx)
        mute = 0.55 + 0.45 * sat_f if s < 0.3 else sat_f   # whites stay whitish
        return hsl2h(h if keep_hue else hm(h), min(0.95, s * mute), l)

    p = Palette(name=name)
    for k in ROLE_KEYS:
        p.roles[k] = carry(base.roles[k], keep_hue=k in ("success", "warning"))
    # background saturation: don't exceed what the picture's dark regions actually have
    h_b, s_b, l_b = h2hsl(base["bg"])
    bg_s = min(0.9, max(0.30, s_b * sat_f, min(0.62, a["s_bg"] * 1.1)))
    ratio = bg_s / max(0.01, s_b)
    for k in ("bg", "navy", "bg_deep", "selection", "border_soft"):
        h, s, l = h2hsl(base.roles[k])
        p.roles[k] = hsl2h(hm(h), min(0.9, s * ratio), l)
    # accent: the picture's hero color, kept bright enough to read on the background
    acc_s = max(0.50, min(0.92, (0.82 + a["acc_s"]) / 2 * min(1.1, sat_f + 0.05)))
    acc_l = max(0.60, min(0.72, (h2hsl(base["accent"])[2] + a["acc_l"]) / 2 + 0.02))
    p.roles["accent"] = ensure_contrast(hsl2h(a["h_acc"], acc_s, acc_l), p.roles["bg"], 5.0)
    p.ansi = [carry(c) for c in base.ansi]
    p.ansi[0] = mix(p.roles["bg"], p.roles["fg"], 0.20)
    finalize(p, rederive=False)
    return p


# ───────────────────────────── wallpaper detection ─────────────────────────────


def _run(cmd: list[str], timeout: float = 3.0) -> str:
    try:
        r = subprocess.run(cmd, capture_output=True, text=True, timeout=timeout)
        return r.stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def video_frame(path: Path) -> Path | None:
    if not shutil.which("ffmpeg"):
        return None
    CACHE.mkdir(parents=True, exist_ok=True)
    out = CACHE / "frame.png"
    subprocess.run(
        ["ffmpeg", "-y", "-loglevel", "error", "-ss", "1", "-i", str(path), "-frames:v", "1", str(out)],
        capture_output=True, timeout=30,
    )
    if not out.exists() or out.stat().st_size == 0:  # very short clip
        subprocess.run(
            ["ffmpeg", "-y", "-loglevel", "error", "-i", str(path), "-frames:v", "1", str(out)],
            capture_output=True, timeout=30,
        )
    return out if out.exists() else None


def detect_wallpaper() -> tuple[Path | None, str]:
    """Best guess at the wallpaper on screen right now → (image path, source note)."""
    # 1. wallfliper says it's a video wallpaper → theme from a frame of it
    state = {}
    try:
        state = json.loads((CONFIG / "wallfliper" / "state.json").read_text())
    except (OSError, ValueError):
        pass
    sp = Path(str(state.get("path", ""))).expanduser() if state.get("path") else None
    if sp and sp.is_file() and (state.get("kind") == "video" or sp.suffix.lower() in VIDEO_EXT - {".gif"}):
        fr = video_frame(sp)
        if fr:
            return fr, f"frame of video wallpaper {sp.name}"
    # 2. what awww/swww is actually displaying
    for tool in ("awww", "swww"):
        if shutil.which(tool):
            for line in _run([tool, "query"]).splitlines():
                m = re.search(r"image:\s*(\S.*?)\s*$", line)
                if m and Path(m.group(1)).is_file():
                    return Path(m.group(1)), f"{tool} query"
    # 3. wallfliper's last applied image
    if sp and sp.is_file() and sp.suffix.lower() in IMAGE_EXT:
        return sp, "wallfliper state"
    # 4. newest file in ~/Wallpapers
    wd = HOME / "Wallpapers"
    if wd.is_dir():
        imgs = [f for f in wd.iterdir() if f.suffix.lower() in IMAGE_EXT]
        if imgs:
            f = max(imgs, key=lambda x: x.stat().st_mtime)
            return f, "newest file in ~/Wallpapers (no wallpaper daemon answered)"
    return None, "no wallpaper found"


def list_wallpapers() -> list[Path]:
    wd = HOME / "Wallpapers"
    if not wd.is_dir():
        return []
    return sorted(f for f in wd.iterdir() if f.suffix.lower() in IMAGE_EXT)


# ───────────────────────────── file rewriting ─────────────────────────────

HEX_RE = re.compile(r"#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?(?![0-9a-fA-F])")
RGB_RE = re.compile(r"(rgba?\(\s*)(\d{1,3})(\s*,\s*)(\d{1,3})(\s*,\s*)(\d{1,3})")


def build_map(old: Palette, new: Palette) -> dict[tuple[int, int, int], tuple[int, int, int]]:
    o, n = dict(all_colors(old)), dict(all_colors(new))
    m: dict = {}
    for k, ov in o.items():
        key, val = h2rgb(ov), h2rgb(n[k])
        if key not in m:
            m[key] = val
    for ov, nv in zip(old.ansi, new.ansi):   # terminal colors (roles above win on a tie)
        m.setdefault(h2rgb(ov), h2rgb(nv))
    return {k: v for k, v in m.items() if k != v}


def remap_text(text: str, m: dict, warp: "Warp | None" = None) -> tuple[str, int]:
    count = 0

    def target(rgb):
        if rgb in m:
            return m[rgb]
        if warp is not None:  # a shade between the roles → move it the way its neighbours moved
            w = h2rgb(warp(rgb2h(rgb)))
            return w if w != rgb else None
        return None

    def hexsub(mo):
        nonlocal count
        rgb = h2rgb(mo.group(1))
        tg = target(rgb)
        if tg is not None:
            count += 1
            new = "{:02x}{:02x}{:02x}".format(*tg)
            if not re.search(r"[a-f]", mo.group(1)):  # digits only — follow the alpha's case
                low = bool(mo.group(2) and re.search(r"[a-f]", mo.group(2)))
            else:
                low = mo.group(1) == mo.group(1).lower()
            if not low:
                new = new.upper()
            return "#" + new + (mo.group(2) or "")
        return mo.group(0)

    def rgbsub(mo):
        nonlocal count
        rgb = (int(mo.group(2)), int(mo.group(4)), int(mo.group(6)))
        if rgb in m:
            count += 1
            n = m[rgb]
            return f"{mo.group(1)}{n[0]}{mo.group(3)}{n[1]}{mo.group(5)}{n[2]}"
        return mo.group(0)

    text = HEX_RE.sub(hexsub, text)
    text = RGB_RE.sub(rgbsub, text)
    return text, count


def score_palette(text: str, p: Palette) -> int:
    """How many of p's colors appear in text — picks which palette a file is on."""
    found = {h2rgb(mo.group(1)) for mo in HEX_RE.finditer(text)}
    for mo in RGB_RE.finditer(text):
        found.add((int(mo.group(2)), int(mo.group(4)), int(mo.group(6))))
    return sum(1 for _, v in all_colors(p) if h2rgb(v) in found)


def conf_set(text: str, kv: dict[str, str]) -> str:
    """`key value` style config (kitty). Replaces existing lines, appends missing."""
    lines = text.split("\n")
    done = set()
    for i, ln in enumerate(lines):
        mo = re.match(r"^(\s*)([A-Za-z_][\w]*)(\s+)(\S.*)$", ln)
        if mo and mo.group(2) in kv and not ln.lstrip().startswith("#"):
            k = mo.group(2)
            lines[i] = f"{mo.group(1)}{k}{mo.group(3)}{kv[k]}"
            done.add(k)
    missing = [k for k in kv if k not in done]
    if missing:
        if lines and lines[-1] == "":
            lines.pop()
        lines += ["", "# added by rice-colors"] + [f"{k} {kv[k]}" for k in missing] + [""]
    return "\n".join(lines)


def ini_set(text: str, section: str, kv: dict[str, str], sep: str = "=", uncomment: bool = True) -> str:
    """Set keys inside [section] of an ini-ish file, keeping everything else."""
    lines = text.split("\n")
    start = None
    for i, ln in enumerate(lines):
        if ln.strip() == f"[{section}]":
            start = i
            break
    if start is None:
        if lines and lines[-1].strip() != "":
            lines.append("")
        lines.append(f"[{section}]")
        start = len(lines) - 1
        lines += [f"{k}{sep}{v}" for k, v in kv.items()]
        return "\n".join(lines) + ("" if lines[-1] == "" else "\n")
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if re.match(r"^\s*\[.+\]\s*$", lines[j]):
            end = j
            break
    for k, v in kv.items():
        pat = re.compile(rf"^\s*{'[;#]?' if uncomment else ''}\s*{re.escape(k)}\s*=")
        hit = None
        for j in range(start + 1, end):
            if pat.match(lines[j]):
                hit = j
                if not lines[j].lstrip().startswith((";", "#")):
                    break  # prefer a live line over a commented one
        if hit is not None:
            lines[hit] = f"{k}{sep}{v}"
        else:
            ins = end
            while ins > start + 1 and lines[ins - 1].strip() == "":
                ins -= 1
            lines.insert(ins, f"{k}{sep}{v}")
            end += 1
    return "\n".join(lines)


# ── generators for files that are built from the palette rather than remapped ──


def _rgbs(h: str) -> str:
    return "{},{},{}".format(*h2rgb(h))


def _kde_generated_sections(p: Palette) -> dict[str, dict[str, str]]:
    r = p.roles

    def block(bg, alt, fg=None, active=None):
        fg = fg or r["fg"]
        return {
            "BackgroundAlternate": _rgbs(alt), "BackgroundNormal": _rgbs(bg),
            "DecorationFocus": _rgbs(r["accent"]), "DecorationHover": _rgbs(r["accent"]),
            "ForegroundActive": _rgbs(active or r["fg_bright"]),
            "ForegroundInactive": _rgbs(mix(fg, bg, 0.38)),
            "ForegroundLink": _rgbs(r["accent"]),
            "ForegroundNegative": _rgbs(r["accent"]),
            "ForegroundNeutral": _rgbs(r["warning"]),
            "ForegroundNormal": _rgbs(fg),
            "ForegroundPositive": _rgbs(r["success"]),
            "ForegroundVisited": _rgbs(mix(r["rose"], r["fg"], 0.45)),
        }

    sel = block(r["selection"], mix(r["selection"], r["fg"], 0.10), r["fg_bright"])
    win = block(r["bg"], mix(r["bg"], "#000000", 0.12))
    return {
        "ColorEffects:Disabled": {"Color": "128,128,128"},
        "ColorEffects:Inactive": {
            "ChangeSelectionColor": "true", "ChangeSelectionColorAmount": "10",
            "Color": _rgbs(r["violet"]), "ColorAmount": "10", "ColorEffect": "0",
            "ContrastAmount": "0.1", "IntensityAmount": "0.2",
        },
        "Colors:Button": block(r["navy"], r["bg_deep"]),
        "Colors:Complementary": block(r["bg_deep"], r["bg"]),
        "Colors:Header": block(r["bg"], mix(r["bg"], "#000000", 0.12)),
        "Colors:Selection": sel,
        "Colors:Tooltip": block(r["navy"], r["navy"]),
        "Colors:View": block(r["bg_deep"], r["bg"]),
        "Colors:Window": win,
        "WM": {
            "activeBackground": _rgbs(r["bg"]), "activeBlend": _rgbs(r["accent"]),
            "activeForeground": _rgbs(r["fg"]), "inactiveBackground": _rgbs(r["bg_deep"]),
            "inactiveBlend": _rgbs(r["violet"]), "inactiveForeground": _rgbs(r["fg_dim"]),
        },
    }


def parse_ini(text: str) -> dict[str, dict[str, str]]:
    d: dict[str, dict[str, str]] = {}
    sec = None
    for ln in text.splitlines():
        mo = re.match(r"^\[(.+)\]\s*$", ln)
        if mo:
            sec = mo.group(1)
            d[sec] = {}
        elif sec is not None and "=" in ln:
            k, v = ln.split("=", 1)
            d[sec][k] = v
    return d


def kde_scheme_sections(p: Palette) -> dict[str, dict[str, str]]:
    base = default_palette()
    if base.extras.get("kde"):
        text = warp_kde(base.extras["kde"], Warp(base, p))
        secs = parse_ini(text)
        secs.pop("General", None)
        return secs
    return _kde_generated_sections(p)


def kde_scheme_text(p: Palette) -> str:
    base = default_palette()
    if base.extras.get("kde"):
        return warp_kde(base.extras["kde"], Warp(base, p))
    out = []
    secs = _kde_generated_sections(p)
    for name in sorted(secs):
        out.append(f"[{name}]")
        out += [f"{k}={v}" for k, v in sorted(secs[name].items())]
        out.append("")
    out += ["[General]", "ColorScheme=AliceNight", "Name=AliceNight", "shadeSortColumn=true", ""]
    return "\n".join(out)


def kdeglobals_text(text: str, p: Palette) -> str:
    for name, kv in kde_scheme_sections(p).items():
        text = ini_set(text, name, kv, uncomment=False)
    text = ini_set(text, "General", {"ColorScheme": "AliceNight"}, uncomment=False)
    return text if text.endswith("\n") else text + "\n"


def _qt6ct_generated(p: Palette) -> str:
    r = p.roles

    def a(h, alpha="ff"):
        return "#" + alpha + h.lstrip("#").lower()

    def scheme(fg, fg_b, bg, dim=False):
        base = r["bg_deep"]
        if dim:  # disabled
            fg = fg_b = r["violet"]
        return [
            a(fg), a(r["navy"]), a(r["surface"]), a(mix(r["navy"], r["fg"], 0.10)),
            a(p.shade2()), a(r["border_soft"]), a(fg), a(fg_b), a(fg),
            a(base), a(bg), a(p.shade1()),
            a(r["accent"] if not dim else r["violet"]), a(r["bg"]),
            a(r["accent"]), a(r["rose"]), a(r["bg"]), a(bg), a(r["navy"]), a(r["fg"]),
            "#80" + fg.lstrip("#").lower(), a(r["accent"]),
        ]

    active = scheme(r["fg"], r["fg_bright"], r["bg"])
    inactive = scheme(r["fg_dim"], r["fg_bright"], r["bg"])
    disabled = scheme(r["violet"], r["violet"], r["bg_deep"], dim=True)
    return "[ColorScheme]\nactive_colors=%s\n\ninactive_colors=%s\n\ndisabled_colors=%s\n" % (
        ",".join(active), ",".join(inactive), ",".join(disabled))


def qt6ct_text(p: Palette) -> str:
    base = default_palette()
    if base.extras.get("qt6ct"):
        return warp_qt6ct(base.extras["qt6ct"], Warp(base, p))
    return _qt6ct_generated(p)


def btop_theme_text(p: Palette) -> str:
    r = p.roles
    g = lambda a, b, c: (a, b, c)  # noqa: E731
    lines = {
        "main_bg": r["bg"], "main_fg": r["fg"], "title": r["fg_bright"], "hi_fg": r["accent"],
        "selected_bg": r["selection"], "selected_fg": r["accent"], "inactive_fg": r["violet"],
        "graph_text": r["fg_dim"], "meter_bg": r["surface"], "proc_misc": r["pink"],
        "cpu_box": r["violet"], "mem_box": r["violet"], "net_box": r["violet"], "proc_box": r["violet"],
        "div_line": r["border_soft"],
    }
    grads = {
        "temp": g(r["success"], r["warning"], r["accent"]),
        "cpu": g(r["rose"], r["pink"], r["accent"]),
        "free": g(r["violet"], r["purple"], r["pink"]),
        "cached": g(r["violet"], r["rose"], r["pink"]),
        "available": g(r["purple"], r["rose"], r["accent"]),
        "used": g(r["rose"], r["pink"], r["accent"]),
        "download": g(r["violet"], r["pink"], r["accent"]),
        "upload": g(r["purple"], r["rose"], r["accent"]),
        "process": g(r["violet"], r["rose"], r["accent"]),
    }
    out = ["# generated by rice-colors"]
    out += [f'theme[{k}]="{v}"' for k, v in lines.items()]
    for k, (s, m_, e) in grads.items():
        out += [f'theme[{k}_start]="{s}"', f'theme[{k}_mid]="{m_}"', f'theme[{k}_end]="{e}"']
    return "\n".join(out) + "\n"


def kitty_kv(p: Palette) -> dict[str, str]:
    r = p.roles
    kv = {
        "background": r["bg"], "foreground": r["fg"],
        "selection_background": r["selection"], "selection_foreground": r["accent"],
        "cursor": r["accent"], "cursor_text_color": r["bg"], "cursor_trail_color": r["accent"],
        "active_border_color": r["accent"], "inactive_border_color": r["selection"],
        "bell_border_color": r["pink"], "active_tab_foreground": r["accent"],
        "active_tab_background": r["bg_deep"], "inactive_tab_foreground": r["rose"],
        "inactive_tab_background": r["bg"], "tab_bar_background": r["bg"],
    }
    for i, c in enumerate(p.ansi):
        kv[f"color{i}"] = c
    return kv


def cava_kv(p: Palette) -> dict[str, str]:
    r = p.roles
    stops = [r["violet"], r["purple"], r["rose"], r["pink"], r["accent"]]
    cols = []
    for i in range(8):  # 8 evenly spaced samples along violet→…→accent
        t = i / 7 * (len(stops) - 1)
        lo = min(int(t), len(stops) - 2)
        cols.append(mix(stops[lo], stops[lo + 1], t - lo))
    kv = {"gradient": "1"}
    kv.update({f"gradient_color_{i + 1}": f"'{c.lower()}'" for i, c in enumerate(cols)})
    return kv


# ───────────────────────────── targets ─────────────────────────────


@dataclass
class FileSpec:
    live: str            # path relative to $HOME (".config/..." honours XDG)
    repo: str            # path relative to the dotfiles repo root
    kind: str = "remap"  # remap | qt6ct | kde_scheme | kdeglobals | btop_theme | btop_conf | cava
    create: bool = False
    warp: bool = False   # also carry non-role shades along (only for files that are fully rice-colored)


@dataclass
class Target:
    key: str
    label: str
    files: list[FileSpec]
    hooks: list[str] = field(default_factory=list)
    default: bool = True   # included unless told otherwise


GTK_THEME = ".local/share/themes/AliceNight"
TARGETS: list[Target] = [
    Target("gtk", "GTK 3 + 4 (AliceNight theme)", [
        FileSpec(f"{GTK_THEME}/gtk-3.0/gtk.css", "home/.local/share/themes/AliceNight/gtk-3.0/gtk.css"),
        FileSpec(f"{GTK_THEME}/gtk-3.0/gtk-dark.css", "home/.local/share/themes/AliceNight/gtk-3.0/gtk-dark.css"),
        FileSpec(f"{GTK_THEME}/gtk-4.0/gtk.css", "home/.local/share/themes/AliceNight/gtk-4.0/gtk.css"),
        FileSpec(f"{GTK_THEME}/gtk-4.0/gtk-dark.css", "home/.local/share/themes/AliceNight/gtk-4.0/gtk-dark.css"),
        FileSpec(".config/gtk-4.0/gtk.css", "gtk-4.0/gtk.css"),
    ], ["gtk"]),
    Target("qt6ct", "Qt apps (qt6ct palette)", [
        FileSpec(".config/qt6ct/colors/AliceNight.conf", "qt6ct/colors/AliceNight.conf", "qt6ct", True),
    ]),
    Target("kde", "KDE color scheme + kdeglobals", [
