#!/usr/bin/env python3
"""
theme settings — one place for the rice's colors

A terminal UI that owns the rice's palette and pushes it into every themed app:
GTK 3/4 (AliceNight), qt6ct, the KDE color scheme + kdeglobals, kitty, niri,
waybar, swaync, quickshell, fastfetch, hyprlock (and btop / cava if you want).

  * edit any role by hex, or nudge hue / saturation / lightness with the keys
  * generate a palette from your CURRENT wallpaper — only hues that are really
    in the picture are ever used (roles, terminal colors, qt/KDE shades, all of it)
  * save/load presets, apply with automatic backup + undo

Usage:
    theme-settings                       open the TUI
    theme-settings --wallpaper --apply   palette from current wallpaper, apply it
    theme-settings --image FILE --apply  palette from a specific image
    theme-settings --preset NAME --apply apply a saved preset ("AliceNight" = default)
    theme-settings --restore             undo the last apply
    theme-settings --list-targets | --save-default | --show-default

(`rice-colors` still works — it is a thin wrapper around this.)
Needs: python-textual, python-pillow   (sudo pacman -S python-textual python-pillow)
"""

from __future__ import annotations

import argparse
import colorsys
import hashlib
import json
import os
import re
import shutil
import subprocess
import sys
import time
from dataclasses import dataclass, field
from pathlib import Path

APP_NAME = "Theme Settings"

HOME = Path.home()
CONFIG = Path(os.environ.get("XDG_CONFIG_HOME") or HOME / ".config")
DATA = Path(os.environ.get("XDG_DATA_HOME") or HOME / ".local/share")
# state/preset directories keep their historical name so nothing gets orphaned
STATE = Path(os.environ.get("XDG_STATE_HOME") or HOME / ".local/state") / "rice-colors"
CACHE = Path(os.environ.get("XDG_CACHE_HOME") or HOME / ".cache") / "rice-colors"
PRESET_DIR = CONFIG / "rice-colors" / "palettes"
STATE_FILE = STATE / "state.json"
BACKUPS = STATE / "backups"
IMAGE_EXT = {".png", ".jpg", ".jpeg", ".webp", ".bmp", ".gif", ".tif", ".tiff"}
VIDEO_EXT = {".mp4", ".mkv", ".webm", ".mov", ".avi", ".gif"}


def live_path(rel: str) -> Path:
    """Map a '~'-relative path to the live location (honours XDG dirs)."""
    if rel.startswith(".config/"):
        return CONFIG / rel[len(".config/"):]
    if rel.startswith(".local/share/"):
        return DATA / rel[len(".local/share/"):]
    return HOME / rel


# ───────────────────────────── color math ─────────────────────────────


def norm_hex(s: str) -> str | None:
    s = s.strip().lstrip("#")
    if len(s) == 3 and re.fullmatch(r"[0-9a-fA-F]{3}", s):
        s = "".join(c * 2 for c in s)
    if re.fullmatch(r"[0-9a-fA-F]{6}", s):
        return "#" + s.upper()
    return None


def h2rgb(h: str) -> tuple[int, int, int]:
    h = h.lstrip("#")
    return int(h[0:2], 16), int(h[2:4], 16), int(h[4:6], 16)


def rgb2h(rgb) -> str:
    r, g, b = (max(0, min(255, int(round(v)))) for v in rgb)
    return f"#{r:02X}{g:02X}{b:02X}"


def h2hsl(h: str) -> tuple[float, float, float]:
    r, g, b = (v / 255 for v in h2rgb(h))
    hh, ll, ss = colorsys.rgb_to_hls(r, g, b)
    return hh * 360.0, ss, ll


def hsl2h(h: float, s: float, l: float) -> str:
    r, g, b = colorsys.hls_to_rgb((h % 360.0) / 360.0, max(0.0, min(1.0, l)), max(0.0, min(1.0, s)))
    return rgb2h((r * 255, g * 255, b * 255))


def mix(a: str, b: str, t: float) -> str:
    ar, br = h2rgb(a), h2rgb(b)
    return rgb2h([ar[i] + (br[i] - ar[i]) * t for i in range(3)])


def lum(h: str) -> float:
    def f(c):
        c /= 255
        return c / 12.92 if c <= 0.03928 else ((c + 0.055) / 1.055) ** 2.4

    r, g, b = h2rgb(h)
    return 0.2126 * f(r) + 0.7152 * f(g) + 0.0722 * f(b)


def contrast(a: str, b: str) -> float:
    la, lb = sorted((lum(a), lum(b)), reverse=True)
    return (la + 0.05) / (lb + 0.05)


def ensure_contrast(color: str, bg: str, ratio: float) -> str:
    """Move only the lightness of `color` (hue and saturation stay) until it reads on `bg`."""
    h, s, l = h2hsl(color)
    up = lum(bg) < 0.4
    for _ in range(70):
        c = hsl2h(h, s, l)
        if contrast(c, bg) >= ratio:
            return c
        l += 0.012 if up else -0.012
        if l >= 0.98 or l <= 0.02:
            break
    return hsl2h(h, s, l)


def hue_dist(a: float, b: float) -> float:
    d = abs(a - b) % 360
    return min(d, 360 - d)


def hue_mix(a: float, b: float, t: float) -> float:
    d = ((b - a + 180) % 360) - 180
    return (a + d * t) % 360


def wrap180(d: float) -> float:
    return ((d + 180.0) % 360.0) - 180.0


def _clamp(v: float, lo: float, hi: float) -> float:
    return max(lo, min(hi, v))


def _circ_mean(items: list[tuple[float, float]]) -> float:
    import math

    x = sum(math.cos(math.radians(h)) * w for h, w in items)
    y = sum(math.sin(math.radians(h)) * w for h, w in items)
    return math.degrees(math.atan2(y, x)) % 360


# ───────────────────────────── observed-hue rule ─────────────────────────────
# The wallpaper decides which hues exist. A palette carries the list of hues that
# were really observed in the picture (`hues`), and everything that is derived
# from it afterwards — roles, terminal colors, qt/KDE/kitty shades — is held to it.

HUE_TOL = 6.0        # a color may sit this close to an observed hue without being moved
GREY_SAT = 0.06      # below this a color is a neutral grey: no hue to police


def snap_to_hues(hx: str, hues: list[float], neutral: bool = False) -> str:
    """Pull a color's hue onto the nearest observed hue (lightness/saturation untouched)."""
    h, s, l = h2hsl(hx)
    if neutral:
        return hsl2h(0.0, 0.0, l)
    if not hues or s < GREY_SAT:
        return hx
    best = min(hues, key=lambda o: hue_dist(h, o))
    if hue_dist(h, best) <= HUE_TOL:
        return hx
    return hsl2h(best, s, l)


# ───────────────────────────── palette model ─────────────────────────────

BASE_ROLES = [
    ("bg", "background", "window / terminal bg"),
    ("navy", "navy", "panels, buttons"),
    ("selection", "selection", "selected / hover bg"),
    ("fg", "foreground", "normal text"),
    ("fg_bright", "fg bright", "headings, highlights"),
    ("accent", "accent", "focus ring, cursor"),
    ("pink", "pink", "secondary accent"),
    ("rose", "rose", "tertiary accent"),
    ("violet", "violet", "borders, dim accents"),
    ("purple", "purple", "dim accents"),
    ("success", "success", "ok / positive"),
    ("warning", "warning", "caution"),
]
DERIVED_ROLES = [
    ("bg_deep", "bg deep", "views, inputs"),
    ("surface", "surface", "raised surfaces"),
    ("border_soft", "border soft", "hairlines"),
    ("fg_dim", "fg dim", "secondary text"),
]
ROLE_KEYS = [k for k, _, _ in BASE_ROLES] + [k for k, _, _ in DERIVED_ROLES]
ROLE_LABEL = {k: (lbl, hint) for k, lbl, hint in BASE_ROLES + DERIVED_ROLES}
BASE_KEYS = {k for k, _, _ in BASE_ROLES}

STOCK_ROLES = {
    "bg": "#09152F", "navy": "#0F183D", "selection": "#2C1F4E",
    "fg": "#D9CFE0", "fg_bright": "#F3EAF2", "accent": "#EF6261",
    "pink": "#B63A6C", "rose": "#9B346B", "violet": "#5F295D",
    "purple": "#67315F", "success": "#7FA68A", "warning": "#D8B45F",
    "bg_deep": "#0D1730", "surface": "#2F2940", "border_soft": "#2C3454",
    "fg_dim": "#C8C0CC",
}
STOCK_ANSI = [
    "#3A2850", "#B63A6C", "#7A3A70", "#EF6261", "#33468A", "#9B346B", "#79416F", "#D9CFE0",
    "#523B69", "#FF6470", "#D24B78", "#FF746F", "#5268A8", "#B95C98", "#986090", "#F3EAF2",
]
ANSI_NAMES = ["black", "red", "green", "yellow", "blue", "magenta", "cyan", "white"]


@dataclass
class Palette:
    name: str = "AliceNight"
    roles: dict[str, str] = field(default_factory=lambda: dict(STOCK_ROLES))
    ansi: list[str] = field(default_factory=lambda: list(STOCK_ANSI))
    # verbatim snapshot of hand-tuned files of the default theme (qt6ct / KDE scheme)
    extras: dict = field(default_factory=dict)
    # hues that really occur in the wallpaper this palette came from ([] = unrestricted)
    hues: list = field(default_factory=list)
    # wallpaper had no colour at all → the whole rice stays grey
    neutral: bool = False

    def copy(self) -> "Palette":
        return Palette(self.name, dict(self.roles), list(self.ansi), dict(self.extras),
                       list(self.hues), self.neutral)

    def to_dict(self) -> dict:
        d: dict = {"name": self.name, "roles": self.roles, "ansi": self.ansi}
        if self.extras:
            d["extras"] = self.extras
        if self.hues:
            d["hues"] = [round(float(h), 1) for h in self.hues]
        if self.neutral:
            d["neutral"] = True
        return d

    @staticmethod
    def from_dict(d: dict) -> "Palette":
        p = Palette()
        p.name = str(d.get("name", "custom"))
        for k in ROLE_KEYS:
            p.roles[k] = norm_hex(str(d.get("roles", {}).get(k, ""))) or p.roles[k]
        ans = d.get("ansi") or []
        if len(ans) == 16:
            p.ansi = [norm_hex(str(a)) or STOCK_ANSI[i] for i, a in enumerate(ans)]
        if isinstance(d.get("extras"), dict):
            p.extras = {k: v for k, v in d["extras"].items() if isinstance(v, str)}
        if isinstance(d.get("hues"), list):
            p.hues = [float(h) for h in d["hues"] if isinstance(h, (int, float))]
        p.neutral = bool(d.get("neutral", False))
        return p

    def __getitem__(self, k: str) -> str:
        return self.roles[k]

    def shade1(self) -> str:
        return mix(self["bg"], "#000000", 0.57)

    def shade2(self) -> str:
        return mix(self["bg"], "#000000", 0.27)


def derive(p: Palette) -> None:
    r = p.roles
    r["bg_deep"] = mix(r["bg"], r["navy"], 0.30)
    r["surface"] = mix(mix(r["selection"], r["bg"], 0.45), r["fg"], 0.05)
    r["border_soft"] = mix(r["navy"], r["fg"], 0.15)
    r["fg_dim"] = mix(r["fg"], r["bg"], 0.08)


def all_colors(p: Palette) -> list[tuple[str, str]]:
    out = [(k, p.roles[k]) for k in ROLE_KEYS]
    out += [("shade1", p.shade1()), ("shade2", p.shade2())]
    return out


def finalize(p: Palette, rederive: bool = True) -> Palette:
    """Normalise hexes and make every remap-relevant color unique (exact remapping
    works by color match, so two roles sharing one hex would merge irreversibly)."""
    for k in ROLE_KEYS:
        p.roles[k] = norm_hex(p.roles[k]) or STOCK_ROLES[k]
    p.ansi = [norm_hex(a) or STOCK_ANSI[i] for i, a in enumerate(p.ansi)]
    if rederive:
        derive(p)
    seen: set[tuple[int, int, int]] = set()
    for k in ROLE_KEYS:
        rgb = list(h2rgb(p.roles[k]))
        for _ in range(8):
            if tuple(rgb) not in seen:
                break
            rgb[2] = rgb[2] + 1 if rgb[2] < 255 else rgb[2] - 1
        seen.add(tuple(rgb))
        p.roles[k] = rgb2h(rgb)
    return p


def enforce_observed(p: Palette) -> Palette:
    """Hold every role and terminal color to the hues the wallpaper really has."""
    if not p.hues and not p.neutral:
        return p
    for k in ROLE_KEYS:
        p.roles[k] = snap_to_hues(p.roles[k], p.hues, p.neutral)
    p.ansi = [snap_to_hues(c, p.hues, p.neutral) for c in p.ansi]
    return p


def audit_palette(p: Palette) -> list[str]:
    """Plain-language problems with a palette (empty list = healthy)."""
    issues: list[str] = []
    if p.neutral:
        for k in ROLE_KEYS:
            if h2hsl(p.roles[k])[1] > 0.02:
                issues.append(f"{ROLE_LABEL[k][0]} isn't grey")
    elif p.hues:
        for k in ROLE_KEYS:
            h, s, l = h2hsl(p.roles[k])
            tol = HUE_TOL * (2.5 if l < 0.16 else 1.5)   # very dark colors quantise their hue
            if s >= 0.10 and min(hue_dist(h, o) for o in p.hues) > tol:
                issues.append(f"{ROLE_LABEL[k][0]} uses a hue the wallpaper doesn't have")
    bg = p.roles["bg"]
    for k, need in (("fg", 7.0), ("fg_bright", 9.0), ("accent", 4.5), ("fg_dim", 4.5)):
        if contrast(p.roles[k], bg) < need - 0.05:
            issues.append(f"{ROLE_LABEL[k][0]} is hard to read on the background")
    return issues


# ───────────────────────────── default theme / presets ─────────────────────────────

DEFAULT_FILE = "palette.json"
_DEFAULT: Palette | None = None


def default_file_candidates() -> list[Path]:
    here = Path(__file__).resolve()
    c = [CONFIG / "alice-rice" / DEFAULT_FILE]
    if len(here.parents) > 2:
        c.append(here.parents[2] / "alice-rice" / DEFAULT_FILE)
    return c


def default_palette() -> Palette:
    """The rice's own default theme: alice-rice/palette.json (a snapshot of the
    dotfiles repo), falling back to the built-in copy of the same colors."""
    global _DEFAULT
    if _DEFAULT is None:
        _DEFAULT = Palette()
        for f in default_file_candidates():
            try:
                _DEFAULT = Palette.from_dict(json.loads(f.read_text()))
                _DEFAULT.name = "AliceNight"
                _DEFAULT.hues, _DEFAULT.neutral = [], False   # the default isn't wallpaper-bound
                break
            except (OSError, ValueError):
                continue
    return _DEFAULT.copy()


def builtin_presets() -> dict[str, Palette]:
    return {"AliceNight": default_palette()}


def list_presets() -> dict[str, Palette]:
    out = builtin_presets()
    if PRESET_DIR.is_dir():
        for f in sorted(PRESET_DIR.glob("*.json")):
            try:
                p = Palette.from_dict(json.loads(f.read_text()))
                p.name = p.name or f.stem
                out[f.stem] = p
            except (OSError, ValueError):
                continue
    return out


def save_preset(p: Palette, name: str) -> Path:
    name = re.sub(r"[^\w.\- ]", "", name).strip() or "custom"
    PRESET_DIR.mkdir(parents=True, exist_ok=True)
    q = p.copy()
    q.name = name
    q.extras = {}   # presets store the palette only; Qt/KDE shades are re-derived on apply
    f = PRESET_DIR / f"{name}.json"
    f.write_text(json.dumps(q.to_dict(), indent=2))
    return f


# ───────────────────────────── Warp ─────────────────────────────


class Warp:
    """Moves any color the same way the palette's base roles moved (old → new).

    Exact role colors are handled by exact remapping elsewhere; this carries the
    colors in between (qt6ct's dimmed shades, KDE's inactive/alternate variants,
    kitty's tab colors...) along, interpolating hue shift / saturation / lightness
    between the nearest roles — then holds the result to the observed hues.
    """

    def __init__(self, old: Palette, new: Palette):
        self.hues = list(new.hues)
        self.neutral = new.neutral
        rows = []
        for k, _, _ in BASE_ROLES:
            ho, so, lo = h2hsl(old[k])
            hn, sn, ln = h2hsl(new[k])
            if so < 0.08:
                continue
            rows.append((ho, wrap180(hn - ho), max(0.0 if new.neutral else 0.3, min(2.5, sn / so)), ln - lo))
        rows.sort()
        groups: list[list] = []
        for r in rows:
            if groups and abs(r[0] - groups[-1][-1][0]) < 3:
                groups[-1].append(r)
            else:
                groups.append([r])
        self.pts = [tuple(sum(c) / len(g) for c in zip(*g)) for g in groups]
        self.identity = (not self.hues and not self.neutral and
                         all(abs(p[1]) < 0.01 and abs(p[2] - 1) < 0.002 and abs(p[3]) < 0.002 for p in self.pts))

    def __call__(self, hx: str) -> str:
        if self.identity or not self.pts:
            return hx
        h, s, l = h2hsl(hx)
        if s < 0.04:
            return hx
        pts = self.pts
        ext = [(pts[-1][0] - 360, *pts[-1][1:])] + list(pts) + [(pts[0][0] + 360, *pts[0][1:])]
        dh, sr, dl = 0.0, 1.0, 0.0
        for i in range(len(ext) - 1):
            a, b = ext[i], ext[i + 1]
            if a[0] <= h <= b[0]:
                t = (h - a[0]) / max(1e-6, b[0] - a[0])
                dh = a[1] + (b[1] - a[1]) * t
                sr = a[2] + (b[2] - a[2]) * t
                dl = a[3] + (b[3] - a[3]) * t
                break
        f = min(1.0, s / 0.2)   # near-greys follow hue but barely change in sat/light
        out = hsl2h(h + dh, min(1.0, max(0.0, s * (1 + (sr - 1) * f))), min(0.98, max(0.0, l + dl * f)))
        return snap_to_hues(out, self.hues, self.neutral)


QT_ARGB = re.compile(r"#([0-9a-fA-F]{2})([0-9a-fA-F]{6})(?![0-9a-fA-F])")
KDE_RGB = re.compile(r"(?m)^(\s*[A-Za-z]\w*\s*=\s*)(\d{1,3}),(\d{1,3}),(\d{1,3})[ \t]*$")


def warp_qt6ct(text: str, w: Warp) -> str:
    def f(mo):
        lo = mo.group(2) == mo.group(2).lower()
        n = w("#" + mo.group(2)).lstrip("#")
        return "#" + mo.group(1) + (n.lower() if lo else n.upper())

    return QT_ARGB.sub(f, text)


def warp_kde(text: str, w: Warp) -> str:
    def f(mo):
        rgb = (int(mo.group(2)), int(mo.group(3)), int(mo.group(4)))
        if max(rgb) > 255:
            return mo.group(0)
        n = h2rgb(w(rgb2h(rgb)))
        return f"{mo.group(1)}{n[0]},{n[1]},{n[2]}"

    return KDE_RGB.sub(f, text)


# ───────────────────────────── wallpaper → palette ─────────────────────────────


@dataclass
class Cluster:
    h: float
    s: float
    l: float
    w: float
    hex: str
    pop: bool = False        # a small, bright, saturated feature (sun, moon, neon sign)
    corner: float = 0.0
    edge: float = 0.0
    center: float = 0.0


STYLES = ["balanced", "vibrant", "muted"]
SAT_SCALE = {"balanced": 1.0, "vibrant": 1.22, "muted": 0.72}


def _pil():
    try:
        from PIL import Image, ImageOps

        return Image, ImageOps
    except ImportError:
        raise SystemExit("missing Pillow. install it with: sudo pacman -S python-pillow")


def _pixels(im) -> list:
    getter = getattr(im, "get_flattened_data", None) or im.getdata
    return list(getter())


def extract_clusters(path: Path, k: int = 24) -> list[Cluster]:
    """Color clusters of a wallpaper, with where in the picture they live.

    Plain global quantisation is bad for wallpaper theming: a tiny neon sign can
    dominate the accent while black borders become "the background". So each
    cluster keeps its corner/edge/center prevalence, and a second pass keeps small
    bright saturated features that median-cut would bury.
    """
    Image, ImageOps = _pil()
    im = ImageOps.exif_transpose(Image.open(path))
    if "A" in im.getbands():   # transparent pixels behave like the dark background
        rgba = im.convert("RGBA")
        im = Image.alpha_composite(Image.new("RGBA", rgba.size, (0, 0, 0, 255)), rgba).convert("RGB")
    else:
        im = im.convert("RGB")
    im.thumbnail((320, 320), getattr(Image, "Resampling", Image).LANCZOS)
    q = im.quantize(colors=max(8, k), method=Image.Quantize.MEDIANCUT)
    pal = q.getpalette() or []
    qpx = _pixels(q)
    width = q.size[0]
    height = q.size[1]

    stats: dict[int, dict[str, float]] = {i: {"count": 0.0, "corner": 0.0, "edge": 0.0, "center": 0.0}
                                          for i in set(qpx)}
    for pos, idx in enumerate(qpx):
        y, x = divmod(pos, width)
        nx, ny = x / max(1, width - 1), y / max(1, height - 1)
        st = stats[idx]
        st["count"] += 1.0
        if (nx <= 0.28 or nx >= 0.72) and (ny <= 0.28 or ny >= 0.72):
            st["corner"] += 1.0
        if min(nx, ny, 1.0 - nx, 1.0 - ny) <= 0.18:
            st["edge"] += 1.0
        if 0.30 <= nx <= 0.70 and 0.30 <= ny <= 0.70:
            st["center"] += 1.0

    total = float(len(qpx)) or 1.0
    out: list[Cluster] = []
    for idx, st in stats.items():
        rgb = pal[idx * 3: idx * 3 + 3]
        if len(rgb) != 3:
            continue
        hx = rgb2h(rgb)
        h, s, l = h2hsl(hx)
        n = max(1.0, st["count"])
        out.append(Cluster(h, s, l, st["count"] / total, hx, False,
                           st["corner"] / n, st["edge"] / n, st["center"] / n))
    out.sort(key=lambda c: -c.w)

    px = _pixels(im)
    stride = max(1, len(px) // 90000)
    sample = px[::stride]
    bins: dict[tuple[int, int], list] = {}
    for r, g, b in sample:
        hh, ss, vv = colorsys.rgb_to_hsv(r / 255, g / 255, b / 255)
        ll = colorsys.rgb_to_hls(r / 255, g / 255, b / 255)[1]
        if ss >= 0.45 and vv >= 0.58 and ll >= 0.30:
            bins.setdefault((int(hh * 24) % 24, 0 if ll < 0.50 else 1 if ll < 0.72 else 2), []).append((r, g, b))
    for items in bins.values():
        frac = len(items) / max(1, len(sample))
        if frac < 0.0025:
            continue
        hx = rgb2h([sum(c[i] for c in items) / len(items) for i in range(3)])
        h, s, l = h2hsl(hx)
        out.append(Cluster(h, s, l, frac, hx, True))
    return out


def _chroma(clusters: list[Cluster]) -> list[Cluster]:
    return [c for c in clusters if c.s >= 0.16 and 0.06 <= c.l <= 0.95]


def _greenish(c: Cluster) -> bool:
    return c.s >= 0.24 and 75.0 <= c.h <= 170.0 and c.l >= 0.28


def _warm(c: Cluster) -> bool:
    return c.s >= 0.24 and (c.h <= 72.0 or c.h >= 332.0) and c.l >= 0.30


def observed_hues(clusters: list[Cluster], families: list[dict]) -> list[float]:
    """Every hue that genuinely occurs in the picture (nearby hues merged), strongest first."""
    cand = sorted(
        ((c.h, c.w * c.s + (0.004 if c.pop else 0.0)) for c in clusters
         if c.s >= 0.14 and 0.06 <= c.l <= 0.97 and (c.w >= 0.003 or c.pop)),
        key=lambda t: -t[1])
    groups: list[list[tuple[float, float]]] = []
    for h, w in cand:
        for g in groups:
            if hue_dist(h, _circ_mean(g)) <= 8.0:
                g.append((h, w))
                break
        else:
            groups.append([(h, w)])
    hues = [_circ_mean(g) for g in groups][:8]
    for f in families:   # the family means that roles are actually built from
        if f["weight"] >= 0.045 and all(hue_dist(f["h"], h) > 8.0 for h in hues):
            hues.append(f["h"])
    return hues


def _family_representatives(clusters: list[Cluster], max_families: int = 4) -> list[dict]:
    """Group the wallpaper's *actual* colors into hue families (never invents a hue)."""
    chroma = [c for c in clusters if c.s >= 0.18 and 0.12 <= c.l <= 0.96]
    if not chroma:
        return []
    remaining = list(chroma)
    total_weight = sum(c.w * max(c.s, 0.12) for c in remaining) or 1.0
    families: list[dict] = []
    while remaining and len(families) < max_families:
        # prevalence matters far more than brightness: a tiny bright feature must
        # not become the background family
        seed = max(remaining, key=lambda c: c.w * max(c.s, 0.12) * (0.72 + 0.28 * c.s))
        members = [c for c in remaining if hue_dist(c.h, seed.h) <= 26.0] or [seed]
        weight = sum(c.w * max(c.s, 0.12) for c in members)
        hue = _circ_mean([(c.h, c.w * max(c.s, 0.12)) for c in members])
        darkest = min(members, key=lambda c: c.l)
        lightest = max(members, key=lambda c: c.l)
        strongest = max(members, key=lambda c: c.w * c.s * (1.7 if c.pop else 1.0))
        # observed background candidate: spatial coverage beats pure darkness, so a
        # dark foreground object doesn't automatically become the desktop background
        bg_member = max(members, key=lambda c: ((0.52 - c.l) * (0.55 + 1.9 * c.corner + 0.55 * c.edge)
                                                * (0.55 + 1.4 * min(1.0, c.w * 6.0))))
        families.append({"h": hue, "weight": weight / total_weight, "members": members,
                         "dark": darkest.hex, "light": lightest.hex, "strong": strongest.hex,
                         "bg": bg_member.hex})
        remaining = [c for c in remaining if c not in members]
    families.sort(key=lambda f: -f["weight"])
    return families


def _observed_hue_tone(seed: str, lightness: float, sat_scale: float = 1.0) -> str:
    """Change only lightness/saturation of an observed color; the hue stays."""
    h, s, _ = h2hsl(seed)
    return hsl2h(h, _clamp(s * sat_scale, 0.0, 0.95), _clamp(lightness, 0.02, 0.97))


def analyze_wallpaper(clusters: list[Cluster], base: Palette, variant: int = 0) -> dict:
    """Find the wallpaper's real hue families and usable tone anchors.

    Hue is data, not a design suggestion: a one-family wallpaper gives a one-hue
    rice, a two-family wallpaper a two-hue rice, and so on. Variants only choose
    another *observed* family (or, for one-family pictures, another observed tone).
    """
    source = clusters or []
    chroma_mass = sum(c.w * c.s for c in source if c.s >= 0.12)
    has_pop = any(c.pop and c.w >= 0.006 for c in source)
    families = _family_representatives(source, 4)
    if not families or (chroma_mass < 0.03 and not has_pop):
        lights = [c.l for c in source] or [0.1, 0.8]
        return {"mode": "grayscale", "hues": [], "dark_l": min(lights), "light_l": max(lights),
                "chroma_mass": chroma_mass}

    significant = [f for f in families if f["weight"] >= 0.045] or families[:1]
    # a small bright focal feature (sun, moon, neon sign) IS in the picture even if it is
    # tiny: let at most one of them join as its own hue family so it can be the accent
    pops = [c for c in source if c.pop and c.w >= 0.004 and c.s >= 0.45]
    for c in sorted(pops, key=lambda c: -c.w * c.s):
        if all(hue_dist(c.h, f["h"]) > 40.0 for f in significant):
            mem = [x for x in pops if hue_dist(x.h, c.h) <= 26.0]
            fam = {"h": _circ_mean([(x.h, x.w) for x in mem]), "weight": 0.05, "members": mem, "pop": True,
                   "dark": min(mem, key=lambda x: x.l).hex, "light": max(mem, key=lambda x: x.l).hex,
                   "strong": max(mem, key=lambda x: x.w * x.s).hex, "bg": min(mem, key=lambda x: x.l).hex}
            significant.append(fam)
            families.append(fam)
            break
    mode = "monochrome" if len(significant) <= 1 else "two-family" if len(significant) == 2 else "multi-family"
    usable = significant[:1] if mode == "monochrome" else significant[:2] if mode == "two-family" else significant[:4]
    primary = significant[0]

    # the background always comes from the dominant family — a mostly-red picture
    # with a few dark-blue pixels must not turn purple
    bg_seed = primary["bg"]
    bg_h, bg_s, bg_l = h2hsl(bg_seed)

    # focal features lead as accent candidates; variants then walk through the other families
    accent_order = sorted(usable, key=lambda f: not f.get("pop"))
    accent_family = accent_order[variant % len(accent_order)]
    other = [f for f in usable if f is not accent_family]
    secondary_family = other[0] if other else accent_family
    tertiary_family = usable[(usable.index(accent_family) + 1) % len(usable)]

    if mode == "monochrome":
        # one observed hue family → ONE hue everywhere; variants walk through the
        # tones of that family that really exist in the picture
        tones = [primary["light"]]
        for c in sorted(primary["members"], key=lambda c: -(c.w * c.s * (1.7 if c.pop else 1.0))):
            if c.l >= 0.30 and c.hex not in tones:
                tones.append(c.hex)
        accent_seed = tones[variant % len(tones)]
        secondary_seed = tertiary_seed = accent_seed
    else:
        accent_seed = accent_family["strong"]
        secondary_seed = secondary_family["strong"]
        tertiary_seed = tertiary_family["strong"]

    return {
        "mode": mode, "families": families, "usable_families": usable, "primary_family": primary,
        "h_bg": bg_h, "s_bg": _clamp(bg_s, 0.0, 0.82), "l_bg_raw": bg_l,
        "bg_hex": bg_seed, "accent_seed": accent_seed, "secondary_seed": secondary_seed,
        "tertiary_seed": tertiary_seed,
        "green": next((c.hex for f in significant[1:] for c in f["members"] if _greenish(c)), None),
        "warm": next((c.hex for f in significant[1:] for c in f["members"] if _warm(c)), None),
        "chroma_mass": chroma_mass, "family_count": len(significant), "primary_mass": primary["weight"],
        "hues": observed_hues(source, families),
    }


def _neutral_palette(a: dict, style: str, variant: int, name: str) -> Palette:
    """A wallpaper with no colour gets a rice with no colour — greys only."""
    g = lambda l: hsl2h(0.0, 0.0, _clamp(l, 0.0, 1.0))   # noqa: E731
    bg_l = _clamp(a["dark_l"] * 0.5 + 0.045, 0.05, 0.13)
    acc_l = _clamp(a["light_l"] * 0.9, 0.62, 0.86) - (0.12 if variant % 2 else 0.0)
    p = Palette(name=name, neutral=True)
    p.roles.update({
        "bg": g(bg_l), "navy": g(bg_l + 0.045), "selection": g(bg_l + 0.15), "fg": g(0.84),
        "fg_bright": g(0.95), "accent": g(acc_l), "pink": g(0.58), "rose": g(0.50),
        "violet": g(0.32), "purple": g(0.27), "success": g(0.64), "warning": g(0.72),
        "bg_deep": g(bg_l - 0.02), "surface": g(bg_l + 0.10), "border_soft": g(bg_l + 0.11),
        "fg_dim": g(0.70),
    })
    steps = [0.20, 0.46, 0.52, 0.58, 0.40, 0.50, 0.44, 0.84]
    p.ansi = [g(l) for l in steps] + [g(min(0.97, l + 0.10)) for l in steps]
    p.ansi[7], p.ansi[15] = p.roles["fg"], p.roles["fg_bright"]
    return finalize(p, rederive=False)


def _dedupe_ansi(p: Palette) -> None:
    """Chromatic terminal slots must stay tell-apart-able even with few hues:
    when two collapse to the same color, walk their lightness apart."""
    bg = p.roles["bg"]
    for start in (1, 9):
        seen: list[str] = []
        for i in range(start, start + 6):
            c = p.ansi[i]
            for step in range(1, 8):
                if all(sum(abs(a - b) for a, b in zip(h2rgb(c), h2rgb(o))) > 24 for o in seen):
                    break
                h, s, l = h2hsl(p.ansi[i])
                c = hsl2h(h, s, _clamp(l + (0.05 * step) * (1 if step % 2 else -1), 0.2, 0.9))
            if contrast(c, bg) >= 3.0:
                p.ansi[i] = c
            seen.append(p.ansi[i])


def build_palette(clusters: list[Cluster], style: str = "balanced", variant: int = 0,
                  name: str = "wallpaper") -> Palette:
    """Build the rice from observed wallpaper colors only.

    Lightness and saturation are adjusted for readability, but no hue family is
    invented: a monochrome blue wallpaper gives blue tones, not blue + purple +
    pink because the stock rice happened to contain those. Afterwards the whole
    palette is held to the observed hues (enforce_observed) and audited.
    """
    base = default_palette()
    a = analyze_wallpaper(clusters, base, variant)
    if a["mode"] == "grayscale":
        return _neutral_palette(a, style, variant, name)
    sat_scale = SAT_SCALE.get(style, 1.0)
    mode = a["mode"]

    # background family — keep the sampled hue; a washed-out picture gets a washed-out bg
    bg_h, bg_s_seed, bg_l_seed = h2hsl(a["bg_hex"])
    washed = _clamp(a["chroma_mass"] / 0.22, 0.25, 1.0)
    bg = hsl2h(bg_h, _clamp(max(bg_s_seed * (1.05 if style == "vibrant" else 0.94), 0.30) * washed, 0.06, 0.78),
               _clamp(0.055 + bg_l_seed * 0.42, 0.055, 0.24))
    _, bg_s, bg_l = h2hsl(bg)   # hue is NOT recomputed: very dark colors quantise it

    acc_h, acc_s_seed, acc_l_seed = h2hsl(a["accent_seed"])
    sec_h, sec_s_seed, _ = h2hsl(a["secondary_seed"])
    ter_h, ter_s_seed, _ = h2hsl(a["tertiary_seed"])
    if mode == "monochrome":
        sec_h = ter_h = acc_h
        sec_s_seed = ter_s_seed = acc_s_seed

    navy = hsl2h(bg_h, _clamp(bg_s * 0.94, 0.04, 0.70), _clamp(bg_l + 0.048, 0.075, 0.29))
    bg_deep = hsl2h(bg_h, _clamp(bg_s * 0.96, 0.04, 0.72), _clamp(bg_l - 0.022, 0.025, 0.18))

    acc_s = _clamp(acc_s_seed * sat_scale, 0.26, 0.94)
    acc_l = _clamp(max(acc_l_seed, 0.50) + (0.03 if style == "vibrant" else 0.0), 0.46, 0.80)
    accent = ensure_contrast(hsl2h(acc_h, acc_s, acc_l), bg, 4.5)
    selection = hsl2h(acc_h, _clamp(acc_s * 0.36, 0.10, 0.45), _clamp((bg_l + acc_l) * 0.46, bg_l + 0.045, 0.32))

    pink = ensure_contrast(hsl2h(sec_h, _clamp(sec_s_seed * 0.82 * sat_scale, 0.16, 0.84), 0.57), bg, 3.0)
    rose = ensure_contrast(hsl2h(ter_h, _clamp(ter_s_seed * 0.72 * sat_scale, 0.14, 0.78), 0.49), bg, 3.0)
    violet = hsl2h(ter_h, _clamp(ter_s_seed * 0.58 * sat_scale, 0.10, 0.68), _clamp(bg_l + 0.20, 0.20, 0.44))
    purple = hsl2h(sec_h, _clamp(sec_s_seed * 0.46 * sat_scale, 0.08, 0.60), _clamp(bg_l + 0.15, 0.18, 0.38))
    surface = hsl2h(bg_h if mode == "monochrome" else sec_h,
                    _clamp((bg_s if mode == "monochrome" else sec_s_seed) * 0.64, 0.05, 0.44),
                    _clamp(bg_l + 0.10, 0.13, 0.31))

    # semantic colors: only hues the picture has (greens/warms when present, else accent-hue tones)
    if mode != "monochrome" and a["green"]:
        success = ensure_contrast(_observed_hue_tone(a["green"], 0.60, 0.92), bg, 3.0)
    else:
        success = ensure_contrast(hsl2h(acc_h, _clamp(acc_s * 0.78, 0.20, 0.70), 0.62), bg, 3.0)
    if mode != "monochrome" and a["warm"]:
        warning = ensure_contrast(_observed_hue_tone(a["warm"], 0.66, 0.92), bg, 3.0)
    else:
        warning = ensure_contrast(hsl2h(acc_h, _clamp(acc_s * 0.68, 0.18, 0.66), 0.68), bg, 3.0)

    tint = min(1.0, washed + 0.2)
    fg = ensure_contrast(hsl2h(bg_h, min(0.16, bg_s * 0.30) * tint, 0.82), bg, 7.0)
    fg_bright = ensure_contrast(hsl2h(bg_h, min(0.11, bg_s * 0.22) * tint, 0.94), bg, 10.0)
    fg_dim = ensure_contrast(hsl2h(bg_h, min(0.14, bg_s * 0.28) * tint, 0.70), bg, 4.5)
    border_soft = hsl2h(acc_h, _clamp(acc_s * 0.28, 0.06, 0.38), _clamp(bg_l + 0.105, 0.12, 0.34))

    p = Palette(name=name, hues=list(a["hues"]))
    p.roles.update({"bg": bg, "navy": navy, "selection": selection, "fg": fg, "fg_bright": fg_bright,
                    "accent": accent, "pink": pink, "rose": rose, "violet": violet, "purple": purple,
                    "success": success, "warning": warning, "bg_deep": bg_deep, "surface": surface,
                    "border_soft": border_soft, "fg_dim": fg_dim})

    if mode == "monochrome":
        s = acc_s_seed
        normal = [hsl2h(acc_h, _clamp(s * 0.36, 0.06, 0.40), 0.20), hsl2h(acc_h, _clamp(s * 0.66, 0.10, 0.70), 0.52),
                  hsl2h(acc_h, _clamp(s * 0.58, 0.08, 0.64), 0.58), hsl2h(acc_h, _clamp(s * 0.60, 0.08, 0.70), 0.68),
                  hsl2h(acc_h, _clamp(s * 0.44, 0.06, 0.54), 0.40), hsl2h(acc_h, _clamp(s * 0.70, 0.10, 0.74), 0.60),
                  hsl2h(acc_h, _clamp(s * 0.52, 0.08, 0.60), 0.48), fg]
    else:
        normal = [mix(bg, "#000000", 0.25), rose, success, warning,
                  _observed_hue_tone(a["accent_seed"], 0.44, 0.82), pink,
                  _observed_hue_tone(a["tertiary_seed"], 0.58, 0.72), fg]
    p.ansi = normal + [_observed_hue_tone(c, _clamp(h2hsl(c)[2] + 0.10, 0.02, 0.96), 1.02) for c in normal]
    p.ansi[15] = fg_bright

    # hold everything to the wallpaper's hues, keep terminal colors apart, re-check readability
    enforce_observed(p)
    _dedupe_ansi(p)
    finalize(p, rederive=False)
    enforce_observed(p)
    for _ in range(2):
        if not audit_palette(p):
            break
        for k, need in (("fg", 7.0), ("fg_bright", 9.0), ("accent", 4.5), ("fg_dim", 4.5)):
            p.roles[k] = ensure_contrast(p.roles[k], p.roles["bg"], need)
    return p


# ───────────────────────────── wallpaper detection ─────────────────────────────


def _run(cmd: list[str], timeout: float = 3.0) -> str:
    try:
        return subprocess.run(cmd, capture_output=True, text=True, timeout=timeout).stdout
    except (OSError, subprocess.SubprocessError):
        return ""


def video_frame(path: Path) -> Path | None:
    if not shutil.which("ffmpeg"):
        return None
    CACHE.mkdir(parents=True, exist_ok=True)
    out = CACHE / "frame.png"
    subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-ss", "1", "-i", str(path), "-frames:v", "1", str(out)],
                   capture_output=True, timeout=30)
    if not out.exists() or out.stat().st_size == 0:   # very short clip
        subprocess.run(["ffmpeg", "-y", "-loglevel", "error", "-i", str(path), "-frames:v", "1", str(out)],
                       capture_output=True, timeout=30)
    return out if out.exists() else None


def detect_wallpaper() -> tuple[Path | None, str]:
    """Best guess at the wallpaper on screen right now → (image path, source note)."""
    state = {}
    try:
        state = json.loads((CONFIG / "wallfliper" / "state.json").read_text())
    except (OSError, ValueError):
        pass
    sp = Path(str(state.get("path", ""))).expanduser() if state.get("path") else None
    if sp and sp.is_file() and (state.get("kind") == "video" or sp.suffix.lower() in VIDEO_EXT - {".gif"}):
        fr = video_frame(sp)
        if fr:
            return fr, f"frame of video wallpaper {sp.name}"
    for tool in ("awww", "swww"):
        if shutil.which(tool):
            for line in _run([tool, "query"]).splitlines():
                m = re.search(r"image:\s*(\S.*?)\s*$", line)
                if m and Path(m.group(1)).is_file():
                    return Path(m.group(1)), f"{tool} query"
    if sp and sp.is_file() and sp.suffix.lower() in IMAGE_EXT:
        return sp, "wallfliper state"
    wd = HOME / "Wallpapers"
    if wd.is_dir():
        imgs = [f for f in wd.iterdir() if f.suffix.lower() in IMAGE_EXT]
        if imgs:
            return max(imgs, key=lambda x: x.stat().st_mtime), "newest file in ~/Wallpapers (no wallpaper daemon answered)"
    return None, "no wallpaper found"


def list_wallpapers() -> list[Path]:
    wd = HOME / "Wallpapers"
    if not wd.is_dir():
        return []
    return sorted(f for f in wd.iterdir() if f.suffix.lower() in IMAGE_EXT)


# ───────────────────────────── file rewriting ─────────────────────────────

HEX_RE = re.compile(r"#([0-9a-fA-F]{6})([0-9a-fA-F]{2})?(?![0-9a-fA-F])")
RGB_RE = re.compile(r"(rgba?\(\s*)(\d{1,3})(\s*,\s*)(\d{1,3})(\s*,\s*)(\d{1,3})")


def build_map(old: Palette, new: Palette) -> dict[tuple[int, int, int], tuple[int, int, int]]:
    o, n = dict(all_colors(old)), dict(all_colors(new))
    m: dict = {}
    for k, ov in o.items():
        key, val = h2rgb(ov), h2rgb(n[k])
        if key not in m:
            m[key] = val
    for ov, nv in zip(old.ansi, new.ansi):   # terminal colors (roles above win on a tie)
        m.setdefault(h2rgb(ov), h2rgb(nv))
    # NOTE: colors that stay the same are kept (as identities): they must be pinned in
    # place, otherwise the shade-warp fallback would nudge an unchanged role
    return m


def remap_text(text: str, m: dict, warp: "Warp | None" = None,
               extra: dict | None = None) -> tuple[str, int]:
    count = 0

    def target(rgb):
        if rgb in m:
            return m[rgb]
        if extra and rgb in extra:   # a known shade of the default theme: exact, reversible
            return extra[rgb] if extra[rgb] != rgb else None
        if warp is not None:   # a shade between the roles → move it the way its neighbours moved
            w = h2rgb(warp(rgb2h(rgb)))
            return w if w != rgb else None
        return None

    def hexsub(mo):
        nonlocal count
        rgb = h2rgb(mo.group(1))
        tg = target(rgb)
        if tg is None or tg == rgb:
            return mo.group(0)
        count += 1
        new = "{:02x}{:02x}{:02x}".format(*tg)
        if not re.search(r"[a-f]", mo.group(1)):   # digits only — follow the alpha's case
            low = bool(mo.group(2) and re.search(r"[a-f]", mo.group(2)))
        else:
            low = mo.group(1) == mo.group(1).lower()
        return "#" + (new if low else new.upper()) + (mo.group(2) or "")

    def rgbsub(mo):
        nonlocal count
        rgb = (int(mo.group(2)), int(mo.group(4)), int(mo.group(6)))
        if rgb in m and m[rgb] != rgb:
            count += 1
            n = m[rgb]
            return f"{mo.group(1)}{n[0]}{mo.group(3)}{n[1]}{mo.group(5)}{n[2]}"
        return mo.group(0)

    text = HEX_RE.sub(hexsub, text)
    text = RGB_RE.sub(rgbsub, text)
    return text, count


_ANSI_LINE = re.compile(r"(?m)^([ \t]*color(\d{1,2})[ \t]+)(#[0-9a-fA-F]{6})\b")


def protect_ansi(text: str, src: Palette) -> tuple[str, dict[int, str]]:
    """Terminal colors (`colorN #hex`) are mapped by slot number, never by color value —
    in a wallpaper palette a slot can equal a role (green slot == success)."""
    held: dict[int, str] = {}

    def sub(mo):
        i = int(mo.group(2))
        if i < 16 and norm_hex(mo.group(3)) == src.ansi[i]:
            held[i] = mo.group(3)
            return f"{mo.group(1)}@@ANSI{i}@@"
        return mo.group(0)

    return _ANSI_LINE.sub(sub, text), held


def release_ansi(text: str, held: dict[int, str], pal: Palette) -> str:
    for i, orig in held.items():
        c = pal.ansi[i]
        text = text.replace(f"@@ANSI{i}@@", c.lower() if orig == orig.lower() else c.upper())
    return text


def score_palette(text: str, p: Palette) -> int:
    """How many of p's colors appear in text — picks which palette a file is on."""
    found = {h2rgb(mo.group(1)) for mo in HEX_RE.finditer(text)}
    for mo in RGB_RE.finditer(text):
        found.add((int(mo.group(2)), int(mo.group(4)), int(mo.group(6))))
    return sum(1 for _, v in all_colors(p) if h2rgb(v) in found)


def conf_set(text: str, kv: dict[str, str]) -> str:
    lines = text.split("\n")
    done = set()
    for i, ln in enumerate(lines):
        mo = re.match(r"^(\s*)([A-Za-z_][\w]*)(\s+)(\S.*)$", ln)
        if mo and mo.group(2) in kv and not ln.lstrip().startswith("#"):
            k = mo.group(2)
            lines[i] = f"{mo.group(1)}{k}{mo.group(3)}{kv[k]}"
            done.add(k)
    missing = [k for k in kv if k not in done]
    if missing:
        if lines and lines[-1] == "":
            lines.pop()
        lines += ["", "# added by theme-settings"] + [f"{k} {kv[k]}" for k in missing] + [""]
    return "\n".join(lines)


def ini_set(text: str, section: str, kv: dict[str, str], sep: str = "=", uncomment: bool = True) -> str:
    """Set keys inside [section] of an ini-ish file, keeping everything else."""
    lines = text.split("\n")
    start = None
    for i, ln in enumerate(lines):
        if ln.strip() == f"[{section}]":
            start = i
            break
    if start is None:
        if lines and lines[-1].strip() != "":
            lines.append("")
        lines.append(f"[{section}]")
        lines += [f"{k}{sep}{v}" for k, v in kv.items()]
        return "\n".join(lines) + ("" if lines[-1] == "" else "\n")
    end = len(lines)
    for j in range(start + 1, len(lines)):
        if re.match(r"^\s*\[.+\]\s*$", lines[j]):
            end = j
            break
    for k, v in kv.items():
        pat = re.compile(rf"^\s*{'[;#]?' if uncomment else ''}\s*{re.escape(k)}\s*=")
        hit = None
        for j in range(start + 1, end):
            if pat.match(lines[j]):
                hit = j
                if not lines[j].lstrip().startswith((";", "#")):
                    break   # prefer a live line over a commented one
        if hit is not None:
            lines[hit] = f"{k}{sep}{v}"
        else:
            ins = end
            while ins > start + 1 and lines[ins - 1].strip() == "":
                ins -= 1
            lines.insert(ins, f"{k}{sep}{v}")
            end += 1
    return "\n".join(lines)


# ── generators for files that are built from the palette rather than remapped ──


def _rgbs(h: str) -> str:
    return "{},{},{}".format(*h2rgb(h))


def _kde_generated_sections(p: Palette) -> dict[str, dict[str, str]]:
    r = p.roles

    def block(bg, alt, fg=None, active=None):
        fg = fg or r["fg"]
        return {
            "BackgroundAlternate": _rgbs(alt), "BackgroundNormal": _rgbs(bg),
            "DecorationFocus": _rgbs(r["accent"]), "DecorationHover": _rgbs(r["accent"]),
            "ForegroundActive": _rgbs(active or r["fg_bright"]),
            "ForegroundInactive": _rgbs(mix(fg, bg, 0.38)), "ForegroundLink": _rgbs(r["accent"]),
            "ForegroundNegative": _rgbs(r["accent"]), "ForegroundNeutral": _rgbs(r["warning"]),
            "ForegroundNormal": _rgbs(fg), "ForegroundPositive": _rgbs(r["success"]),
            "ForegroundVisited": _rgbs(mix(r["rose"], r["fg"], 0.45)),
        }

    sel = block(r["selection"], mix(r["selection"], r["fg"], 0.10), r["fg_bright"])
    win = block(r["bg"], mix(r["bg"], "#000000", 0.12))
    return {
        "ColorEffects:Disabled": {"Color": "128,128,128"},
        "ColorEffects:Inactive": {"ChangeSelectionColor": "true", "ChangeSelectionColorAmount": "10",
                                  "Color": _rgbs(r["violet"]), "ColorAmount": "10", "ColorEffect": "0",
                                  "ContrastAmount": "0.1", "IntensityAmount": "0.2"},
        "Colors:Button": block(r["navy"], r["bg_deep"]), "Colors:Complementary": block(r["bg_deep"], r["bg"]),
        "Colors:Header": block(r["bg"], mix(r["bg"], "#000000", 0.12)), "Colors:Selection": sel,
        "Colors:Tooltip": block(r["navy"], r["navy"]), "Colors:View": block(r["bg_deep"], r["bg"]),
        "Colors:Window": win,
        "WM": {"activeBackground": _rgbs(r["bg"]), "activeBlend": _rgbs(r["accent"]),
               "activeForeground": _rgbs(r["fg"]), "inactiveBackground": _rgbs(r["bg_deep"]),
               "inactiveBlend": _rgbs(r["violet"]), "inactiveForeground": _rgbs(r["fg_dim"])},
    }


def parse_ini(text: str) -> dict[str, dict[str, str]]:
    d: dict[str, dict[str, str]] = {}
    sec = None
    for ln in text.splitlines():
        mo = re.match(r"^\[(.+)\]\s*$", ln)
        if mo:
            sec = mo.group(1)
            d[sec] = {}
        elif sec is not None and "=" in ln:
            k, v = ln.split("=", 1)
            d[sec][k] = v
    return d


def kde_scheme_sections(p: Palette) -> dict[str, dict[str, str]]:
    base = default_palette()
    if base.extras.get("kde"):
        secs = parse_ini(warp_kde(base.extras["kde"], Warp(base, p)))
        secs.pop("General", None)
        return secs
    return _kde_generated_sections(p)


def kde_scheme_text(p: Palette) -> str:
    base = default_palette()
    if base.extras.get("kde"):
        return warp_kde(base.extras["kde"], Warp(base, p))
    out = []
    secs = _kde_generated_sections(p)
    for name in sorted(secs):
        out.append(f"[{name}]")
        out += [f"{k}={v}" for k, v in sorted(secs[name].items())]
        out.append("")
    out += ["[General]", "ColorScheme=AliceNight", "Name=AliceNight", "shadeSortColumn=true", ""]
    return "\n".join(out)


def kdeglobals_text(text: str, p: Palette) -> str:
    for name, kv in kde_scheme_sections(p).items():
        text = ini_set(text, name, kv, uncomment=False)
    text = ini_set(text, "General", {"ColorScheme": "AliceNight"}, uncomment=False)
    return text if text.endswith("\n") else text + "\n"


def _qt6ct_generated(p: Palette) -> str:
    r = p.roles

    def a(h, alpha="ff"):
        return "#" + alpha + h.lstrip("#").lower()

    def scheme(fg, fg_b, bg, dim=False):
        base = r["bg_deep"]
        if dim:
            fg = fg_b = r["violet"]
        return [a(fg), a(r["navy"]), a(r["surface"]), a(mix(r["navy"], r["fg"], 0.10)), a(p.shade2()),
                a(r["border_soft"]), a(fg), a(fg_b), a(fg), a(base), a(bg), a(p.shade1()),
                a(r["accent"] if not dim else r["violet"]), a(r["bg"]), a(r["accent"]), a(r["rose"]),
                a(r["bg"]), a(bg), a(r["navy"]), a(r["fg"]), "#80" + fg.lstrip("#").lower(), a(r["accent"])]

    active = scheme(r["fg"], r["fg_bright"], r["bg"])
    inactive = scheme(r["fg_dim"], r["fg_bright"], r["bg"])
    disabled = scheme(r["violet"], r["violet"], r["bg_deep"], dim=True)
    return "[ColorScheme]\nactive_colors=%s\n\ninactive_colors=%s\n\ndisabled_colors=%s\n" % (
        ",".join(active), ",".join(inactive), ",".join(disabled))


def qt6ct_text(p: Palette) -> str:
    base = default_palette()
    if base.extras.get("qt6ct"):
        return warp_qt6ct(base.extras["qt6ct"], Warp(base, p))
    return _qt6ct_generated(p)


def btop_theme_text(p: Palette) -> str:
    r = p.roles
    lines = {"main_bg": r["bg"], "main_fg": r["fg"], "title": r["fg_bright"], "hi_fg": r["accent"],
             "selected_bg": r["selection"], "selected_fg": r["accent"], "inactive_fg": r["violet"],
             "graph_text": r["fg_dim"], "meter_bg": r["surface"], "proc_misc": r["pink"],
             "cpu_box": r["violet"], "mem_box": r["violet"], "net_box": r["violet"], "proc_box": r["violet"],
             "div_line": r["border_soft"]}
    grads = {"temp": (r["success"], r["warning"], r["accent"]), "cpu": (r["rose"], r["pink"], r["accent"]),
             "free": (r["violet"], r["purple"], r["pink"]), "cached": (r["violet"], r["rose"], r["pink"]),
             "available": (r["purple"], r["rose"], r["accent"]), "used": (r["rose"], r["pink"], r["accent"]),
             "download": (r["violet"], r["pink"], r["accent"]), "upload": (r["purple"], r["rose"], r["accent"]),
             "process": (r["violet"], r["rose"], r["accent"])}
    out = ["# generated by theme-settings"]
    out += [f'theme[{k}]="{v}"' for k, v in lines.items()]
    for k, (s, m_, e) in grads.items():
        out += [f'theme[{k}_start]="{s}"', f'theme[{k}_mid]="{m_}"', f'theme[{k}_end]="{e}"']
    return "\n".join(out) + "\n"


def kitty_kv(p: Palette) -> dict[str, str]:
    r = p.roles
    kv = {"background": r["bg"], "foreground": r["fg"], "selection_background": r["selection"],
          "selection_foreground": r["accent"], "cursor": r["accent"], "cursor_text_color": r["bg"],
          "cursor_trail_color": r["accent"], "active_border_color": r["accent"],
          "inactive_border_color": r["selection"], "bell_border_color": r["pink"],
          "active_tab_foreground": r["accent"], "active_tab_background": r["bg_deep"],
          "inactive_tab_foreground": r["rose"], "inactive_tab_background": r["bg"], "tab_bar_background": r["bg"]}
    for i, c in enumerate(p.ansi):
        kv[f"color{i}"] = c
    return kv


def cava_kv(p: Palette) -> dict[str, str]:
    r = p.roles
    stops = [r["violet"], r["purple"], r["rose"], r["pink"], r["accent"]]
    cols = []
    for i in range(8):
        t = i / 7 * (len(stops) - 1)
        lo = min(int(t), len(stops) - 2)
        cols.append(mix(stops[lo], stops[lo + 1], t - lo))
    kv = {"gradient": "1"}
    kv.update({f"gradient_color_{i + 1}": f"'{c.lower()}'" for i, c in enumerate(cols)})
    return kv


# ── hyprlock ──
# Each color field of hyprlock.conf gets a role of the palette. The alpha the file
# already has is kept, so the lock screen keeps its look (translucent input box etc.).
HYPRLOCK_ROLES = {
    "outer_color": "accent",       # input-field outline
    "inner_color": "bg_deep",      # input-field fill
    "font_color": "fg_bright",     # typed text / dots
    "check_color": "success",      # while checking the password
    "fail_color": "pink",          # wrong password
    "capslock_color": "warning",
    "numlock_color": "fg_dim",
    "bothlock_color": "warning",
}
_HL_LINE = re.compile(r"(?m)^([ \t]*)(" + "|".join(HYPRLOCK_ROLES) + r")([ \t]*=[ \t]*)(.*?)([ \t]*)$")
_HL_TOKEN = re.compile(r"rgba?\([^)]*\)")


def _hl_token(token: str, hx: str) -> str:
    """Rewrite one hyprlock color token to `hx`, keeping its function and alpha."""
    mo = re.fullmatch(r"(rgba?)\(\s*(.*?)\s*\)", token)
    if not mo:
        return token
    fn, inner = mo.group(1), mo.group(2)
    r, g, b = h2rgb(hx)
    if "," in inner:
        parts = [x.strip() for x in inner.split(",")]
        alpha = parts[3] if len(parts) >= 4 else None
        return f"{fn}({r}, {g}, {b}" + (f", {alpha})" if alpha is not None else ")")
    hexpart = inner.strip().lstrip("#")
    if re.fullmatch(r"[0-9a-fA-F]{6}([0-9a-fA-F]{2})?", hexpart):
        return f"{fn}({hx.lstrip('#').lower()}{hexpart[6:]})"
    return token


def hyprlock_text(text: str, p: Palette) -> str:
    def line(mo):
        key = mo.group(2)
        value = _HL_TOKEN.sub(lambda t: _hl_token(t.group(0), p.roles[HYPRLOCK_ROLES[key]]), mo.group(4))
        return f"{mo.group(1)}{key}{mo.group(3)}{value}{mo.group(5)}"

    return _HL_LINE.sub(line, text)


# ───────────────────────────── targets ─────────────────────────────


@dataclass
class FileSpec:
    live: str            # path relative to $HOME (".config/..." honours XDG)
    repo: str            # path relative to the dotfiles repo root
    kind: str = "remap"  # remap | qt6ct | kde_scheme | kdeglobals | btop_theme | btop_conf | cava | hyprlock
    create: bool = False
    warp: bool = False   # also carry non-role shades along (only for fully rice-colored files)
    canonical_source: bool = True


@dataclass
class Target:
    key: str
    label: str
    files: list[FileSpec]
    hooks: list[str] = field(default_factory=list)
    default: bool = True


GTK_THEME = ".local/share/themes/AliceNight"
TARGETS: list[Target] = [
