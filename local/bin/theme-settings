TARGET_BY_KEY = {t.key: t for t in TARGETS}
GENERATED_KINDS = {"qt6ct", "kde_scheme", "kdeglobals", "btop_theme", "btop_conf", "cava", "hyprlock"}

DISCOVER_EXT = {"", ".css", ".scss", ".qml", ".kdl", ".conf", ".toml", ".ini", ".jsonc", ".json", ".theme",
                ".rasi", ".lua", ".yml", ".yaml", ".colors", ".rc", ".vibe"}
DISCOVER_SKIP = {".git", "wallfliper", "rice-colors", "theme-settings", "gtk-3.0/assets", "gtk-4.0/assets",
                 "node_modules", "__pycache__", "Wallpapers"}


def discover_files(covered: set[Path], pals: list[Palette]) -> list[FileSpec]:
    """Find other files that clearly use the palette (>=3 of its colors), so the
    app keeps working when the dotfiles are reorganised or new apps get riced."""
    roots = [CONFIG, DATA / "themes", DATA / "color-schemes"]
    out: list[FileSpec] = []
    for root in roots:
        if not root.is_dir():
            continue
        for dp, dns, fns in os.walk(root):
            rel_dir = Path(dp).relative_to(root).as_posix()
            dns[:] = [d for d in dns if d not in DISCOVER_SKIP and f"{rel_dir}/{d}".lstrip("./") not in DISCOVER_SKIP]
            for fn in fns:
                f = Path(dp) / fn
                if f.suffix.lower() not in DISCOVER_EXT or f.resolve() in covered or fn == DEFAULT_FILE:
                    continue
                try:
                    if f.stat().st_size > 600_000:
                        continue
                    text = f.read_text(errors="strict")
                except (OSError, UnicodeDecodeError):
                    continue
                if max(score_palette(text, q) for q in pals) >= 3:
                    out.append(FileSpec(str(f.relative_to(HOME)) if f.is_relative_to(HOME) else str(f),
                                        "", "remap", canonical_source=False))
    return out


def repo_rel(live: Path) -> str:
    """Where a live file sits inside the dotfiles repo (mirrors the installer layout)."""
    if live.is_relative_to(CONFIG):
        return live.relative_to(CONFIG).as_posix()
    if live.is_relative_to(DATA):
        return "home/.local/share/" + live.relative_to(DATA).as_posix()
    return live.relative_to(HOME).as_posix()


def find_repo(hint: str | None = None) -> Path | None:
    here = Path(__file__).resolve()
    cands = [hint, os.environ.get("RICE_REPO"), str(here.parents[2]) if len(here.parents) > 2 else None,
             os.popen("git -C %s rev-parse --show-toplevel 2>/dev/null" % str(here.parent)).read().strip() or None,
             str(HOME / "Projects/niri-dots-clean"), str(HOME / "niri-dots-clean"), str(HOME / "dotfiles"),
             str(HOME / ".dotfiles")]
    for c in cands:
        if c:
            p = Path(c).expanduser()
            if (p / "install.sh").is_file() and (p / "niri").is_dir():
                return p
    return None


# ───────────────────────────── state / backup / tracking ─────────────────────────────


def load_state() -> dict:
    try:
        return json.loads(STATE_FILE.read_text())
    except (OSError, ValueError):
        return {}


def save_state(st: dict) -> None:
    STATE.mkdir(parents=True, exist_ok=True)
    tmp = STATE_FILE.with_suffix(".tmp")
    tmp.write_text(json.dumps(st, indent=2))
    os.replace(tmp, STATE_FILE)


def palette_signature(p: Palette) -> dict:
    """The palette actually used to render a particular file."""
    return {"name": p.name, "roles": dict(p.roles), "ansi": list(p.ansi)}


def text_hash(text: str) -> str:
    """Content hash that tells an untouched tracked file from a manual edit."""
    return hashlib.sha256(text.encode("utf-8", errors="replace")).hexdigest()


def file_palette_record(p: Palette, text: str) -> dict:
    return {"sha256": text_hash(text), "palette": palette_signature(p)}


def palette_from_signature(d: dict) -> Palette | None:
    try:
        if not isinstance(d, dict):
            return None
        payload = d.get("palette", d)   # accept the old flat format too
        if not isinstance(payload, dict):
            return None
        return finalize(Palette.from_dict({"name": payload.get("name", "tracked"),
                                           "roles": payload.get("roles", {}),
                                           "ansi": payload.get("ansi", [])}), rederive=False)
    except Exception:
        return None


def known_palettes(st: dict) -> list[Palette]:
    out = [default_palette()]
    for d in st.get("history", []):
        try:
            out.append(Palette.from_dict(d))
        except Exception:
            pass
    if st.get("applied"):
        out.append(Palette.from_dict(st["applied"]))
    tracked = st.get("file_palettes", {})
    if isinstance(tracked, dict):   # per-file palettes are real candidates after a partial apply
        for d in tracked.values():
            p = palette_from_signature(d)
            if p is not None:
                out.append(p)
    return out


def atomic_write(path: Path, text: str) -> None:
    real = path.resolve() if path.is_symlink() else path
    real.parent.mkdir(parents=True, exist_ok=True)
    mode = real.stat().st_mode & 0o7777 if real.exists() else 0o644
    tmp = real.with_name(f".{real.name}.rice-tmp")
    tmp.write_text(text)
    os.chmod(tmp, mode)
    os.replace(tmp, real)


@dataclass
class Result:
    target: str
    path: str
    status: str   # ok | unchanged | missing | error
    detail: str = ""


def render_file(spec: FileSpec, text: str | None, pal: Palette, st_pals: list[Palette],
                known_source: Palette | None = None, tracked_hash: str | None = None
                ) -> tuple[str | None, str, Palette | None]:
    """Return (new text | None, note, source palette used for remapping)."""
    k = spec.kind
    if k == "qt6ct":
        return qt6ct_text(pal), "generated", pal
    if k == "kde_scheme":
        return kde_scheme_text(pal), "generated", pal
    if k == "btop_theme":
        return btop_theme_text(pal), "generated", pal
    if text is None:
        return None, "missing", None
    if k == "kdeglobals":
        return kdeglobals_text(text, pal), "merged", pal
    if k == "hyprlock":
        return hyprlock_text(text, pal), "color fields themed", pal
    if k == "btop_conf":
        return re.sub(r'(?m)^(\s*color_theme\s*=\s*).*$', r'\1"alice-rice"', text), "color_theme = alice-rice", pal
    if k == "cava":
        return ini_set(text, "color", cava_kv(pal)), "gradient set", pal

    def remap(src: Palette, label: str):
        extra = None
        if spec.warp:
            # the default theme's in-between shades (kitty's dimmed tab colors...) are
            # tracked individually: wherever they currently sit (src's version of them),
            # they go to exactly where `pal` wants them — so palettes chain and come
            # back to the default without drift
            base = default_palette()
            w_src, w_new = Warp(base, src), Warp(base, pal)
            extra = {h2rgb(w_src(c0)): h2rgb(w_new(c0)) for c0 in base.extras.get("shades", "").split()}
        held: dict[int, str] = {}
        body = text
        if spec.warp:
            body, held = protect_ansi(text, src)
        new, n = remap_text(body, build_map(src, pal), Warp(src, pal) if spec.warp else None, extra)
        new = release_ansi(new, held, pal)
        return new, f"{n + sum(1 for i, o in held.items() if norm_hex(o) != pal.ansi[i])} colors ({label})", src

    # a content hash is stronger than color scoring: untouched since our last write →
    # the recorded source palette is authoritative even with only one or two role colors
    if known_source is not None and tracked_hash and tracked_hash == text_hash(text):
        return remap(known_source, f"tracked {known_source.name}")
    if known_source is not None and score_palette(text, known_source) >= 3:
        return remap(known_source, f"tracked {known_source.name}")   # pre-hash state format
    # explicit rice files were authored against the default palette: prefer it on first
    # application instead of guessing between several historical wallpaper palettes
    if spec.canonical_source:
        canonical = default_palette()
        if score_palette(text, canonical) > 0:
            return remap(canonical, "default source")
    # hand-edited or auto-discovered file: detect its palette (ties prefer newer candidates)
    scored = [(score_palette(text, q), i, q) for i, q in enumerate(st_pals)]
    if not scored:
        return text, "no known palettes", None
    score, _, best = max(scored, key=lambda item: (item[0], item[1]))
    if score == 0:
        return text, "no known palette colors found", None
    return remap(best, f"detected {best.name}")


def run_hooks(keys: set[str], log) -> None:
    def sh(cmd: list[str], note: str) -> None:
        if not shutil.which(cmd[0]):
            log(f"reload skipped: {note} ({cmd[0]} not found)")
            return
        try:
            r = subprocess.run(cmd, capture_output=True, text=True, timeout=8, check=False)
        except (OSError, subprocess.SubprocessError) as exc:
            log(f"reload failed: {note}: {exc}")
            return
        if r.returncode == 0:
            log(f"reload: {note}")
        else:
            log(f"reload failed: {note}: {(r.stderr or r.stdout or 'command failed').strip()[:80]}")

    if "waybar" in keys:
        sh(["pkill", "-SIGUSR2", "-x", "waybar"], "waybar")
    if "swaync" in keys:
        sh(["swaync-client", "-rs"], "swaync css")
    if "kitty" in keys:
        sh(["pkill", "-SIGUSR1", "-x", "kitty"], "kitty (all windows)")
    if "cava" in keys:
        sh(["pkill", "-SIGUSR2", "-x", "cava"], "cava")
    if "btop" in keys:
        sh(["pkill", "-SIGUSR2", "-x", "btop"], "btop")
    if "niri" in keys:
        sh(["niri", "msg", "action", "load-config-file"], "niri config")
    if "gtk" in keys and shutil.which("gsettings"):
        cur = _run(["gsettings", "get", "org.gnome.desktop.interface", "gtk-theme"]).strip().strip("'")
        if cur:
            other = "Adwaita" if cur != "Adwaita" else "AliceNight"
            a = subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", other],
                               capture_output=True, text=True, check=False)
            time.sleep(0.25)
            b = subprocess.run(["gsettings", "set", "org.gnome.desktop.interface", "gtk-theme", cur],
                               capture_output=True, text=True, check=False)
            if a.returncode == 0 and b.returncode == 0:
                log("reload: GTK theme re-set (open GTK apps refresh)")
            else:
                log(f"reload failed: GTK theme re-set: {(a.stderr or b.stderr or 'gsettings failed').strip()[:80]}")


def apply_palette(pal: Palette, target_keys: list[str], repo: Path | None = None, dry_run: bool = False,
                  reload: bool = True, log=print) -> list[Result]:
    pal = finalize(pal.copy(), rederive=False)
    st = load_state()
    st_pals = known_palettes(st)
    file_palettes = st.get("file_palettes", {})
    if not isinstance(file_palettes, dict):
        file_palettes = {}
    prev_file_palettes = json.loads(json.dumps(file_palettes))

    roots: list[tuple[str, Path | None]] = [("live", None)]
    if repo:
        roots.append(("repo", repo))
    stamp = time.strftime("%Y%m%d-%H%M%S")
    bdir = BACKUPS / stamp
    manifest = {"files": [], "prev_applied": st.get("applied"), "prev_file_palettes": prev_file_palettes}
    results: list[Result] = []
    seen: set[Path] = set()
    touched: set[str] = set()
    tracking_changed = False

    if "auto" in target_keys:
        covered = {live_path(sp.live).resolve() for t in TARGETS for sp in t.files}
        TARGET_BY_KEY["auto"].files = discover_files(covered, st_pals)
        for sp in TARGET_BY_KEY["auto"].files:
            sp.repo = repo_rel(live_path(sp.live))

    for key in target_keys:
        tgt = TARGET_BY_KEY.get(key)
        if not tgt:
            continue
        for _root_name, root in roots:
            for spec in tgt.files:
                path = live_path(spec.live) if root is None else root / spec.repo
                shown = ("~/" + str(path.relative_to(HOME))) if path.is_relative_to(HOME) else str(path)
                if root is not None:
                    shown = f"[repo] {spec.repo}"
                real = path.resolve()
                if real in seen:   # e.g. live file is a symlink into the repo
                    continue
                exists = path.is_file()
                text = path.read_text(errors="replace") if exists else None
                if not exists and not spec.create:
                    results.append(Result(key, shown, "missing"))
                    if str(real) in file_palettes:
                        del file_palettes[str(real)]
                        tracking_changed = True
                    continue
                record = file_palettes.get(str(real))
                known_source = palette_from_signature(record) if isinstance(record, dict) else None
                tracked_hash = record.get("sha256") if isinstance(record, dict) else None
                try:
                    new, note, source_used = render_file(spec, text, pal, st_pals, known_source, tracked_hash)
                except Exception as exc:   # noqa: BLE001
                    results.append(Result(key, shown, "error", str(exc)))
                    continue
                if new is None:
                    results.append(Result(key, shown, "unchanged", note))
                    seen.add(real)
                    continue
                if new == text:
                    if source_used is not None or spec.kind in GENERATED_KINDS:
                        rec = file_palette_record(pal, new)
                        if file_palettes.get(str(real)) != rec:
                            file_palettes[str(real)] = rec
                            tracking_changed = True
                    elif spec.kind == "remap" and str(real) in file_palettes:
                        del file_palettes[str(real)]
                        tracking_changed = True
                    results.append(Result(key, shown, "unchanged", note))
                    seen.add(real)
                    continue
                if not dry_run:
                    if exists:
                        bpath = bdir / str(real).lstrip("/")
                        bpath.parent.mkdir(parents=True, exist_ok=True)
                        shutil.copy2(real, bpath)
                        manifest["files"].append({"path": str(real), "backup": str(bpath)})
                    else:
                        manifest["files"].append({"path": str(real), "backup": None})
                    atomic_write(path, new)
                    try:   # verify, and record the exact resulting content for future remaps
                        written = path.read_text(errors="replace")
                    except OSError as exc:
                        results.append(Result(key, shown, "error", f"write verification failed: {exc}"))
                        continue
                    if text_hash(written) != text_hash(new):
                        results.append(Result(key, shown, "error", "write verification failed: content differs"))
                        continue
                    file_palettes[str(real)] = file_palette_record(pal, written)
                    tracking_changed = True
                    touched.add(key)
                seen.add(real)
                results.append(Result(key, shown, "ok", note))

    if not dry_run:
        st["file_palettes"] = file_palettes
        errors = [r for r in results if r.status == "error"]
        if touched:
            bdir.mkdir(parents=True, exist_ok=True)
            (bdir / "manifest.json").write_text(json.dumps(manifest, indent=2))
            hist = st.get("history", [])
            if not isinstance(hist, list):
                hist = []
            if st.get("applied"):
                hist.append(st["applied"])
            hist.append(pal.to_dict())
            uniq, sig = [], set()
            for d in hist[-30:]:
                s = json.dumps(d.get("roles", {}), sort_keys=True)
                if s not in sig:
                    sig.add(s)
                    uniq.append(d)
            st["history"] = uniq[-12:]
            if not errors:   # `applied` = last fully successful application
                st["applied"] = pal.to_dict()
            dirs = sorted(d for d in BACKUPS.iterdir() if d.is_dir()) if BACKUPS.is_dir() else []
            for d in dirs[:-15]:
                shutil.rmtree(d, ignore_errors=True)
            if reload:
                run_hooks({h for k in touched for h in TARGET_BY_KEY[k].hooks}, log)
        if touched or tracking_changed:
            save_state(st)
    return results


def restore_last(reload: bool = True, log=print) -> str:
    dirs = sorted(d for d in BACKUPS.iterdir() if d.is_dir() and (d / "manifest.json").exists()) \
        if BACKUPS.is_dir() else []
    if not dirs:
        return "nothing to restore"
    d = dirs[-1]
    man = json.loads((d / "manifest.json").read_text())
    n = 0
    for f in man["files"]:
        p = Path(f["path"])
        if f["backup"] and Path(f["backup"]).exists():
            p.parent.mkdir(parents=True, exist_ok=True)
            shutil.copy2(f["backup"], p)
            n += 1
        elif f["backup"] is None and p.exists():
            p.unlink()
            n += 1
    st = load_state()
    if man.get("prev_applied"):
        st["applied"] = man["prev_applied"]
    else:
        st.pop("applied", None)
    if "prev_file_palettes" in man:
        st["file_palettes"] = man["prev_file_palettes"]
    save_state(st)
    shutil.rmtree(d, ignore_errors=True)
    if reload:
        run_hooks({"waybar", "swaync", "kitty", "cava", "btop", "niri", "gtk"}, log)
    return f"restored {n} files from {d.name}"


# ───────────────────────────── default theme snapshot ─────────────────────────────


def save_default(repo: Path) -> tuple[Path, list[str]]:
    """Snapshot the rice as it is in the dotfiles repo right now → alice-rice/palette.json."""
    notes: list[str] = []
    p = Palette()
    kitty = repo / "alice-rice" / "kitty.conf"
    if kitty.is_file():
        kt = kitty.read_text()

        def kget(key: str) -> str | None:
            mo = re.search(rf"(?m)^{key}\s+(#[0-9a-fA-F]{{6}})\b", kt)
            return norm_hex(mo.group(1)) if mo else None

        for role, key in (("bg", "background"), ("fg", "foreground"), ("selection", "selection_background"),
                          ("accent", "cursor")):
            v = kget(key)
            if v:
                if v != p.roles[role]:
                    notes.append(f"{role} changed in kitty.conf: {p.roles[role]} → {v}")
                p.roles[role] = v
        for i in range(16):
            v = kget(f"color{i}")
            if v:
                p.ansi[i] = v
    blob = ""
    for f in repo.rglob("*"):
        if f.is_file() and ".git" not in f.parts and f.name not in (DEFAULT_FILE, "rice-colors", "theme-settings") \
                and f.suffix.lower() in DISCOVER_EXT and f.stat().st_size < 3_000_000:
            try:
                blob += f.read_text(errors="ignore").lower() + "\n"
            except OSError:
                pass
    rgbs = set(re.findall(r"#([0-9a-f]{6})", blob))
    trip = {tuple(map(int, m)) for m in re.findall(r"(\d{1,3})\s*,\s*(\d{1,3})\s*,\s*(\d{1,3})", blob)}
    for k, v in all_colors(p):
        if v.lstrip("#").lower() not in rgbs and h2rgb(v) not in trip:
            notes.append(f"role '{k}' ({v}) isn't used anywhere in the repo any more")
    # in-between shades of fully rice-colored files (kitty): remembered one by one so that
    # switching palettes and coming back to the default is exact
    known = {h2rgb(v) for _, v in all_colors(p)} | {h2rgb(c) for c in p.ansi}
    shades: list[str] = []
    for t in TARGETS:
        for spec in t.files:
            f = repo / spec.repo
            if spec.warp and f.is_file():
                for mo in HEX_RE.finditer(f.read_text(errors="ignore")):
                    hx = "#" + mo.group(1).upper()
                    if h2rgb(hx) not in known and h2hsl(hx)[1] >= 0.04 and hx not in shades:
                        shades.append(hx)
    if shades:
        p.extras["shades"] = " ".join(shades)
    qt = repo / "qt6ct" / "colors" / "AliceNight.conf"
    kde = repo / "home" / ".local" / "share" / "color-schemes" / "AliceNight.colors"
    if qt.is_file():
        p.extras["qt6ct"] = qt.read_text()
    else:
        notes.append("qt6ct/colors/AliceNight.conf not found — Qt colors will be generated instead")
    if kde.is_file():
        p.extras["kde"] = kde.read_text()
    else:
        notes.append("home/.local/share/color-schemes/AliceNight.colors not found — KDE colors will be generated")
    out = repo / "alice-rice" / DEFAULT_FILE
    out.parent.mkdir(parents=True, exist_ok=True)
    d = p.to_dict()
    d["_comment"] = "default theme of the rice — written by `theme-settings --save-default`"
    out.write_text(json.dumps(d, indent=2) + "\n")
    return out, notes


# ───────────────────────────── CLI ─────────────────────────────


def cli_palette(args) -> Palette | None:
    if args.preset:
        pres = list_presets()
        if args.preset not in pres:
            raise SystemExit(f"no preset '{args.preset}'. have: {', '.join(pres)}")
        return finalize(pres[args.preset].copy(), rederive=False)
    if args.wallpaper or args.image:
        if args.image:
            img, note = Path(args.image).expanduser(), "given image"
        else:
            img, note = detect_wallpaper()
        if not img or not img.is_file():
            raise SystemExit(f"could not find a wallpaper ({note})")
        if img.suffix.lower() in VIDEO_EXT - {".gif"}:
            img = video_frame(img) or img
        print(f"wallpaper: {img}  ({note})")
        return build_palette(extract_clusters(img), args.style, args.variant, name=img.stem)
    return None


def main_cli(args) -> int:
    if args.list_targets:
        for t in TARGETS:
            print(f"{t.key:11} {'on ' if t.default else 'off'} {t.label}")
        return 0
    if args.restore:
        print(restore_last(not args.no_reload))
        return 0
    if args.show_default:
        d = default_palette()
        src = next((str(f) for f in default_file_candidates() if f.is_file()), "built-in")
        print(f"default theme from {src}")
        for k, lbl, _ in BASE_ROLES + DERIVED_ROLES:
            print(f"  {lbl:12} {d[k]}")
        print("  ansi        ", " ".join(d.ansi))
        print("  verbatim files:", ", ".join(d.extras) or "none (qt/KDE are generated)")
        return 0
    if args.save_default:
        repo = find_repo(args.repo)
        if not repo:
            raise SystemExit("dotfiles repo not found (use --repo PATH)")
        out, notes = save_default(repo)
        print(f"wrote {out}")
        for n in notes:
            print(f"  note: {n}")
        return 0
    pal = cli_palette(args)
    if pal is None:
        return 1
    for k, lbl, _ in BASE_ROLES + DERIVED_ROLES:
        print(f"  {lbl:12} {pal[k]}")
    if pal.hues:
        print("  hues in wallpaper:", " ".join(f"{h:.0f}°" for h in pal.hues))
    for issue in audit_palette(pal):
        print(f"  ! {issue}")
    if args.apply:
        keys = args.targets.split(",") if args.targets else [t.key for t in TARGETS if t.default]
        bad = [k for k in keys if k not in TARGET_BY_KEY]
        if bad:
            raise SystemExit(f"unknown target(s): {', '.join(bad)}  (see --list-targets)")
        repo = find_repo(args.repo) if (args.repo or args.with_repo) else None
        if (args.repo or args.with_repo) and not repo:
            print("warning: dotfiles repo not found; only updating live files")
        for r in apply_palette(pal, keys, repo, args.dry_run, not args.no_reload):
            print(f"  {r.status:9} {r.target:10} {r.path}  {r.detail}")
        if args.dry_run:
            print("(dry run — nothing written)")
    return 0


# ───────────────────────────── TUI ─────────────────────────────


def hue_summary(p: Palette) -> tuple[str, str]:
    """(text, kind) describing how the palette relates to its wallpaper; kind: ok | warn | dim"""
    if p.neutral:
        return "grey wallpaper → grey rice", "ok"
    if p.hues:
        issues = audit_palette(p)
        if issues:
            return f"{len(p.hues)} hues · ! {issues[0]}", "warn"
        return f"{len(p.hues)} observed hues · rice stays on them ✓", "ok"
    return "default theme", "dim"


def run_tui(args) -> int:
    try:
        from rich.text import Text
        from textual import on, work
        from textual.app import App, ComposeResult
        from textual.binding import Binding
        from textual.containers import Horizontal, Vertical
        from textual.message import Message
        from textual.theme import Theme
        from textual.widgets import DataTable, Input, RichLog, Static
    except ImportError:
        print("missing textual. install it with: sudo pacman -S python-textual python-pillow")
        return 1

    def sw(h: str, n: int = 3) -> Text:
        return Text("█" * n, style=h)

    def theme_for(pal: Palette, name: str) -> "Theme":
        r = pal.roles
        return Theme(
            name=name, dark=True, primary=r["accent"], secondary=r["pink"], accent=r["accent"],
            warning=r["warning"], error=r["accent"], success=r["success"], foreground=r["fg"],
            background=r["bg"], surface=r["bg_deep"], panel=r["navy"],
            variables={
                "acc": r["accent"], "box": mix(r["violet"], r["fg_dim"], 0.30), "boxhi": r["accent"],
                "dim": mix(r["fg_dim"], r["bg"], 0.25), "sel": r["selection"], "ok": r["success"],
                "warn": r["warning"], "fgb": r["fg_bright"], "bgc": r["bg"],
            })

    # ── flat, text-only "button": the hotkey letter is lit, hover/focus tints the row ──
    class Act(Static, can_focus=True):
        class Pressed(Message):
            def __init__(self, act: "Act") -> None:
                super().__init__()
                self.act = act

        BINDINGS = [Binding("enter", "press", show=False), Binding("space", "press", show=False)]

        def __init__(self, label: str, hot: str = "", id: str | None = None, primary: bool = False) -> None:
            super().__init__("", id=id)
            self.label, self.hot, self.primary = label, hot, primary

        def set_label(self, label: str) -> None:
            self.label = label
            self.redraw()

        def redraw(self) -> None:
            r = self.app.pal.roles
            if self.primary:
                self.update(Text(f"▌{self.label}▐", style=f"bold {r['accent']}"))
                return
            t = Text()
            lit = False
            for ch in self.label:
                if not lit and self.hot and ch.lower() == self.hot.lower():
                    t.append(ch, style=f"bold {r['accent']}")
                    lit = True
                else:
                    t.append(ch, style=r["fg"])
            self.update(t)

        def on_mount(self) -> None:
            self.redraw()

        def on_click(self) -> None:
            self.post_message(self.Pressed(self))

        def action_press(self) -> None:
            self.post_message(self.Pressed(self))

    class RoleTable(DataTable):
        BINDINGS = [
            Binding("j", "cursor_down", "down", show=False), Binding("k", "cursor_up", "up", show=False),
            Binding("h", "nudge('h',-6)", "hue−", show=False), Binding("H", "nudge('h',6)", "hue+", show=False),
            Binding("s", "nudge('s',-0.04)", "sat−", show=False), Binding("S", "nudge('s',0.04)", "sat+", show=False),
            Binding("l", "nudge('l',-0.02)", "light−", show=False), Binding("L", "nudge('l',0.02)", "light+", show=False),
            Binding("e", "edit", "edit hex", show=False), Binding("x", "reset_role", "reset role", show=False),
        ]

        def action_nudge(self, ch: str, amt: float) -> None:
            self.app.nudge(ch, amt)

        def action_edit(self) -> None:
            self.app.query_one("#hex", Input).focus()

        def action_reset_role(self) -> None:
            self.app.reset_role()

    class TargetTable(DataTable):
        BINDINGS = [Binding("space", "toggle", show=False), Binding("j", "cursor_down", show=False),
                    Binding("k", "cursor_up", show=False)]

        def action_toggle(self) -> None:
            self.app.toggle_target(self.app.cur_target())

    class ThemeSettings(App):
        TITLE = APP_NAME
        ansi_color = True   # keeps the terminal's own background (and transparency) under everything
        CSS = """
        Screen { background: ansi_default; color: $foreground; layout: vertical; }
        #top { height: 1; background: ansi_default; padding: 0; }
        #main { height: 1fr; background: ansi_default; }
        #left { width: 50; background: ansi_default; }
        #right { width: 1fr; background: ansi_default; }
        #lower { height: 1fr; background: ansi_default; }
        #status { height: 1; padding: 0 1; color: $dim; background: ansi_default; }
        #keys { height: 1; padding: 0 1; color: $dim; background: ansi_default; }

        .box { border: solid $box; border-title-color: $dim; border-title-style: bold;
               background: ansi_default; padding: 0 1; }
        .box:focus-within { border: solid $boxhi; border-title-color: $acc; }
        #roles-box { height: 1fr; }
        #preview { height: 9; }
        #wall-box { height: auto; }
        #targets-box { width: 44; }
        #log-box { width: 1fr; }
        Screen.-narrow #targets-box { width: 1fr; }
        Screen.-narrow #log-box { display: none; }

        #roles { height: 1fr; }
        #targets { height: 1fr; }
        #hexrow, #presets, #acts1, #acts2, #tacts1, #tacts2 { height: 1; background: ansi_default; }
        #info { width: 1fr; height: 1; color: $dim; background: ansi_default; padding: 0 1; }
        #wp-info, #clusters { height: auto; background: ansi_default; color: $dim; }

        DataTable { background: ansi_default; color: $foreground; border: none; padding: 0;
                    scrollbar-size-vertical: 1; scrollbar-background: ansi_default;
                    scrollbar-background-hover: ansi_default; scrollbar-background-active: ansi_default;
                    scrollbar-color: $box; scrollbar-color-hover: $acc; scrollbar-color-active: $acc; }
        DataTable > .datatable--header { background: ansi_default; color: $dim; text-style: bold; }
        DataTable > .datatable--cursor { background: $sel; color: $fgb; text-style: bold; }
        DataTable > .datatable--hover { background: $sel; }
        DataTable > .datatable--odd-row { background: ansi_default; }
        DataTable > .datatable--even-row { background: ansi_default; }
        DataTable:focus > .datatable--cursor { background: $sel; color: $acc; }

        Input { background: ansi_default; border: none; height: 1; padding: 0 1; color: $foreground; }
        Input:focus { background: $sel; border: none; }
        Input > .input--placeholder { color: $dim; }
        Input > .input--cursor { background: $acc; color: $bgc; }
        Input > .input--selection { background: $sel; }
        #hex { width: 10; }
        #preset-name { width: 14; }

        RichLog { background: ansi_default; color: $foreground; padding: 0; border: none;
                  scrollbar-size-vertical: 1; scrollbar-background: ansi_default;
                  scrollbar-color: $box; scrollbar-color-hover: $acc; }

        Act { width: auto; height: 1; padding: 0 1; margin-right: 1; background: ansi_default; }
        Act:hover { background: $sel; }
        Act:focus { background: $sel; text-style: underline; }
        """
        BINDINGS = [
            Binding("q", "quit", "quit"),
            Binding("g", "generate", "generate"), Binding("w", "use_current_key", "current wallpaper"),
            Binding("n", "next_variant", "variant"), Binding("y", "cycle_style", "style"),
            Binding("[", "wall_prev", "prev wallpaper"), Binding("]", "wall_next", "next wallpaper"),
            Binding("A", "apply_now", "apply"), Binding("a", "apply_now", "apply", show=False),
            Binding("d", "dry_run", "dry run"), Binding("u", "undo", "undo"),
            Binding("r", "toggle_repo", "repo"), Binding("R", "toggle_reload", "reload"),
            Binding("p", "next_preset", "preset"), Binding("ctrl+s", "save_preset", "save preset"),
            Binding("0", "reset_all", "default theme"),
        ]

        # ── setup ──
        def __init__(self) -> None:
            super().__init__()
            st = load_state()
            base = Palette.from_dict(st["applied"]) if st.get("applied") else default_palette()
            self.pal: Palette = finalize(base.copy(), rederive=False)
            self.applied: Palette = self.pal.copy()
            self.style_i = 0
            self.variant = 0
            self.img: Path | None = None
            self.repo = find_repo(args.repo)
            self.busy = False
            self.do_reload = True
            self.use_repo = False
            self.sel_targets = {t.key for t in TARGETS if t.default}
            self._theme_flip = False
            try:
                self._state_mtime = STATE_FILE.stat().st_mtime
            except OSError:
                self._state_mtime = 0.0
            self.wear_theme()   # the stylesheet needs the theme's variables before it parses

        def wear_theme(self) -> None:
            """The app itself is dressed in the palette being edited — live."""
            self._theme_flip = not self._theme_flip
            name = "rice-a" if self._theme_flip else "rice-b"
            self.register_theme(theme_for(self.pal, name))
            self.theme = name

        def compose(self) -> ComposeResult:
            yield Static(id="top")
            with Horizontal(id="main"):
                with Vertical(id="left"):
                    with Vertical(id="roles-box", classes="box") as rb:
                        rb.border_title = "PALETTE"
                        yield RoleTable(id="roles", cursor_type="row")
                        with Horizontal(id="hexrow"):
                            yield Input(placeholder="#RRGGBB", id="hex", max_length=7)
                            yield Static(id="info")
                        with Horizontal(id="presets"):
                            yield Input(placeholder="preset", id="preset-name")
                            yield Act("save", "s", id="ps-save")
                            yield Act("next", "n", id="ps-next")
                            yield Act("default", "d", id="ps-reset")
                with Vertical(id="right"):
                    pv = Static(id="preview", classes="box")
                    pv.border_title = "PREVIEW"
                    yield pv
                    with Vertical(id="wall-box", classes="box") as wb:
                        wb.border_title = "WALLPAPER"
                        yield Static(id="wp-info")
                        yield Input(placeholder="image path — enter to load", id="wp-path")
                        yield Static(id="clusters")
                        with Horizontal(id="acts1"):
                            yield Act("current", "c", id="wp-current")
                            yield Act("‹ prev", "p", id="wp-prev")
                            yield Act("next ›", "x", id="wp-next")
                            yield Act("generate", "g", id="wp-gen")
                        with Horizontal(id="acts2"):
                            yield Act("variant", "v", id="wp-variant")
                            yield Act("style: balanced", "s", id="wp-style")
                            yield Act("apply to rice", "a", id="wp-apply", primary=True)
                    with Horizontal(id="lower"):
                        with Vertical(id="targets-box", classes="box") as tb:
                            tb.border_title = "TARGETS"
                            yield TargetTable(id="targets", cursor_type="row", show_header=False)
                            with Horizontal(id="tacts1"):
                                yield Act("apply", "a", id="do-apply", primary=True)
                                yield Act("dry run", "d", id="do-dry")
                                yield Act("undo", "u", id="do-undo")
                            with Horizontal(id="tacts2"):
                                yield Act("repo: off", "r", id="tog-repo")
                                yield Act("reload: on", "R", id="tog-reload")
                        with Vertical(id="log-box", classes="box") as lb:
                            lb.border_title = "LOG"
                            yield RichLog(id="log", wrap=False, markup=False, highlight=False)
            yield Static(id="status")
            yield Static(id="keys")

        def on_mount(self) -> None:
            t = self.query_one("#roles", RoleTable)
            t.add_column("role", key="role", width=16)
            t.add_column("", key="sw", width=3)
            t.add_column("hex", key="hex", width=9)
            t.add_column("cr", key="cr", width=4)
            for k in self.row_keys():
                c = self.get_color(k)
                t.add_row(self.label_for(k), sw(c), c, f"{contrast(c, self.pal['bg']):.1f}", key=k)
            tt = self.query_one("#targets", TargetTable)
            tt.add_column("", key="mark", width=2)
            tt.add_column("", key="label")
            for tg in TARGETS:
                tt.add_row(self.mark(tg.key), tg.label, key=tg.key)
            self.refresh_all()
            self.set_interval(1.5, self.check_external)
            self.status("ready — h/s/l nudge the selected color · e types a hex · g builds a palette from your wallpaper")
            t.focus()
            self.query_one("#log", RichLog).write("nothing applied this session yet")

        def on_resize(self) -> None:
            self.screen.set_class(self.size.width < 120, "-narrow")   # too tight for a log column
            self.refresh_top()
            self.refresh_keys()
            if self.is_mounted:
                self.refresh_preview()

        # ── small helpers ──
        def status(self, msg: str) -> None:
            self.query_one("#status", Static).update(msg)

        def mark(self, key: str) -> Text:
            r = self.pal.roles
            return Text("■", style=r["accent"]) if key in self.sel_targets else Text("□", style=r["fg_dim"])

        def cur_target(self) -> str | None:
            t = self.query_one("#targets", TargetTable)
            if t.row_count == 0:
                return None
            try:
                return t.coordinate_to_cell_key(t.cursor_coordinate).row_key.value
            except Exception:   # noqa: BLE001
                return None

        def toggle_target(self, key: str | None) -> None:
            if not key:
                return
            self.sel_targets.symmetric_difference_update({key})
            self.query_one("#targets", TargetTable).update_cell(key, "mark", self.mark(key))

        def row_keys(self) -> list[str]:
            return ROLE_KEYS + [f"ansi:{i}" for i in range(16)]

        def get_color(self, key: str) -> str:
            return self.pal.ansi[int(key[5:])] if key.startswith("ansi:") else self.pal.roles[key]

        def set_color(self, key: str, val: str) -> None:
            if key.startswith("ansi:"):
                self.pal.ansi[int(key[5:])] = val
            else:
                self.pal.roles[key] = val
                if key in BASE_KEYS:
                    derive(self.pal)

        def label_for(self, key: str) -> str:
            if key.startswith("ansi:"):
                i = int(key[5:])
                return f"ansi {i:>2} {'bright ' if i >= 8 else ''}{ANSI_NAMES[i % 8]}"
            lbl = ROLE_LABEL[key][0]
            return lbl if key in BASE_KEYS else f"· {lbl}"

        def cur_key(self) -> str | None:
            t = self.query_one("#roles", RoleTable)
            if t.row_count == 0:
                return None
            try:
                return t.coordinate_to_cell_key(t.cursor_coordinate).row_key.value
            except Exception:   # noqa: BLE001
                return None

        def dirty(self) -> bool:
            return self.pal.roles != self.applied.roles or self.pal.ansi != self.applied.ansi

        # ── drawing ──
        def refresh_all(self) -> None:
            self.wear_theme()
            t = self.query_one("#roles", RoleTable)
            for k in self.row_keys():
                c = self.get_color(k)
                t.update_cell(k, "sw", sw(c))
                t.update_cell(k, "hex", c)
                t.update_cell(k, "cr", f"{contrast(c, self.pal['bg']):.1f}")
            tt = self.query_one("#targets", TargetTable)
            for tg in TARGETS:
                tt.update_cell(tg.key, "mark", self.mark(tg.key))
            for act in self.query(Act):
                act.redraw()
            self.refresh_preview()
            self.refresh_info()
            self.refresh_top()
            self.refresh_keys()

        def refresh_top(self) -> None:
            r = self.pal.roles
            width = max(40, self.size.width)
            left = Text()
            left.append(f" {APP_NAME.upper()} ", style=f"bold {r['bg']} on {r['accent']}")
            left.append(f"  {self.pal.name}", style=f"bold {r['fg_bright']}")
            if self.dirty():
                left.append(" ●", style=r["warning"])
            msg, kind = hue_summary(self.pal)
            col = {"ok": r["success"], "warn": r["warning"], "dim": r["fg_dim"]}[kind]
            right = Text()
            right.append(msg + "  ", style=col)
            right.append("q", style=f"bold {r['accent']}")
            right.append(" quit ", style=r["fg_dim"])
            gap = max(1, width - left.cell_len - right.cell_len)
            line = Text()
            line.append_text(left)
            line.append(" " * gap)
            line.append_text(right)
            line.no_wrap = True
            line.overflow = "ellipsis"
            self.query_one("#top", Static).update(line)

        def refresh_keys(self) -> None:
            r = self.pal.roles
            hints = [("h s l", "adjust"), ("e", "hex"), ("x", "reset"), ("g", "generate"), ("n", "variant"),
                     ("y", "style"), ("A", "apply"), ("u", "undo"), ("tab", "move")]
            t = Text(no_wrap=True, overflow="ellipsis")
            for k, v in hints:
                t.append(k, style=f"bold {r['accent']}")
                t.append(f" {v}   ", style=r["fg_dim"])
            self.query_one("#keys", Static).update(t)

        def refresh_info(self) -> None:
            k = self.cur_key()
            if not k:
                return
            c = self.get_color(k)
            h, s, l = h2hsl(c)
            self.query_one("#info", Static).update(f"H{h:4.0f}° S{s * 100:3.0f} L{l * 100:3.0f} · {contrast(c, self.pal['bg']):.1f}:1")
            inp = self.query_one("#hex", Input)
            if not inp.has_focus:
                inp.value = c

        def refresh_preview(self) -> None:
            r = self.pal.roles
            pw = self.query_one("#preview", Static).size.width
            W = max(44, min(64, pw - 4)) if pw else 52
            T = Text()

            def line(segs, bg):
                used = 0
                for txt, fg, *rest in segs:
                    T.append(txt, style=f"{fg} on {rest[0] if rest else bg}" + (" bold" if len(rest) > 1 else ""))
                    used += len(txt)
                T.append(" " * max(0, W - used), style=f"on {bg}")
                T.append("\n")

            line([("  ", r["fg"]), (" 1 ", r["accent"], r["selection"]), (" 2 ", r["fg_dim"]), (" 3 ", r["fg_dim"]),
                  ("   theme settings   ", r["fg"]), (" 100% ", r["success"]), (" 12:30 ", r["fg_bright"])], r["navy"])
            line([(" ~/rice ", r["pink"]), ("❯ ", r["accent"]), ("theme-settings --wallpaper", r["fg"])], r["bg"])
            line([(" selected line looks like this        ", r["fg_bright"], r["selection"])], r["bg"])
            line([(" ok ", r["success"]), ("all good   ", r["fg"]), (" warn ", r["warning"]), ("careful   ", r["fg"]),
                  (" err ", r["pink"]), ("uh oh", r["fg"])], r["bg"])
            line([(" dim text · ", r["fg_dim"]), ("violet", r["violet"]), (" purple", r["purple"]),
                  (" rose", r["rose"]), (" pink", r["pink"])], r["bg"])
            ans = [(" ", r["fg"])] + [("██", self.pal.ansi[i]) for i in range(8)] + [("  ", r["fg"])] + \
                  [("██", self.pal.ansi[i]) for i in range(8, 16)]
            line(ans, r["bg"])
            T.append(" " * 0)
            line([(" ", r["fg"]), (" Notification ", r["fg_bright"], r["surface"], 1), ("  ", r["fg"]),
                  (" Accent ", r["bg"], r["accent"], 1), (" ", r["fg"]), (" Pink ", r["fg_bright"], r["pink"], 1)],
                 r["bg_deep"])
            T.rstrip()
            self.query_one("#preview", Static).update(T)

        def refresh_wall_info(self, cl=None) -> None:
            r = self.pal.roles
            msg, kind = hue_summary(self.pal)
            col = {"ok": r["success"], "warn": r["warning"], "dim": r["fg_dim"]}[kind]
            t = Text(no_wrap=True, overflow="ellipsis")
            if cl:
                t.append("colors ", style=r["fg_dim"])
                for c in cl[:14]:
                    t.append("██", style=c.hex)
                t.append("\n")
            t.append("hues   ", style=r["fg_dim"])
            if self.pal.neutral:
                t.append("██", style="#808080")
            for h in self.pal.hues:
                t.append("██", style=hsl2h(h, 0.6, 0.55))
            if self.pal.hues:
                t.append("  " + " ".join(f"{h:.0f}°" for h in self.pal.hues[:6]), style=r["fg_dim"])
            t.append(f"\n{msg}", style=col)
            self.query_one("#clusters", Static).update(t)

        # ── events ──
        @on(DataTable.RowHighlighted, "#roles")
        def _hl(self, _e) -> None:
            self.refresh_info()

        @on(DataTable.RowSelected, "#targets")
        def _target_pick(self, e: DataTable.RowSelected) -> None:
            self.toggle_target(e.row_key.value)

        @on(Input.Submitted, "#hex")
        def _hex_submit(self, e: Input.Submitted) -> None:
            k = self.cur_key()
            v = norm_hex(e.value)
            if not k or not v:
                self.status(f"'{e.value}' isn't a hex color — try #RRGGBB")
                return
            self.set_color(k, v)
            self.refresh_all()
            self.query_one("#roles", RoleTable).focus()
            self.status(f"{self.label_for(k)} → {v}")

        @on(Input.Submitted, "#wp-path")
        def _wp_path(self, e: Input.Submitted) -> None:
            self.load_image(Path(e.value).expanduser())

        @on(Input.Submitted, "#preset-name")
        def _preset_enter(self, _e) -> None:
            self.action_save_preset()

        @on(Act.Pressed)
        def _act(self, e: Act.Pressed) -> None:
            i = e.act.id
            if i == "ps-save":
                self.action_save_preset()
            elif i == "ps-next":
                self.action_next_preset()
            elif i == "ps-reset":
                self.action_reset_all()
            elif i == "wp-current":
                self.action_use_current_key()
            elif i == "wp-prev":
                self.action_wall_prev()
            elif i == "wp-next":
                self.action_wall_next()
            elif i == "wp-gen":
                self.action_generate()
            elif i == "wp-variant":
                self.action_next_variant()
            elif i == "wp-style":
                self.action_cycle_style()
            elif i in ("wp-apply", "do-apply"):
                self.action_apply_now()
            elif i == "do-dry":
                self.action_dry_run()
            elif i == "do-undo":
                self.action_undo()
            elif i == "tog-repo":
                self.action_toggle_repo()
            elif i == "tog-reload":
                self.action_toggle_reload()

        # ── palette editing ──
        def nudge(self, ch: str, amt: float) -> None:
            k = self.cur_key()
            if not k:
                return
            h, s, l = h2hsl(self.get_color(k))
            if ch == "h":
                h += amt
            elif ch == "s":
                s = _clamp(s + amt, 0.0, 1.0)
            else:
                l = _clamp(l + amt, 0.0, 1.0)
            self.set_color(k, hsl2h(h, s, l))
            self.refresh_all()

        def reset_role(self) -> None:
            k = self.cur_key()
            if not k:
                return
            if k.startswith("ansi:"):
                self.set_color(k, self.applied.ansi[int(k[5:])])
            else:
                self.set_color(k, self.applied.roles[k])
            self.refresh_all()
            self.status(f"{self.label_for(k)} reset to the last applied value")

        def action_save_preset(self) -> None:
            nm = self.query_one("#preset-name", Input).value.strip() or self.pal.name
            f = save_preset(self.pal, nm)
            self.pal.name = f.stem
            self.refresh_all()
            self.status(f"saved preset → {f}")

        def action_next_preset(self) -> None:
            pres = list(list_presets().items())
            names = [n for n, _ in pres]
            i = (names.index(self.pal.name) + 1) % len(names) if self.pal.name in names else 0
            self.pal = finalize(pres[i][1].copy(), rederive=False)
            self.pal.name = names[i]
            self.refresh_all()
            self.status(f"loaded preset {names[i]}")

        def action_reset_all(self) -> None:
            self.pal = default_palette()
            self.refresh_all()
            self.refresh_wall_info()
            self.status("back to the rice's default theme")

        # ── wallpaper ──
        def action_use_current_key(self) -> None:
            img, note = detect_wallpaper()
            if not img:
                self.status("couldn't find your wallpaper — type a path in the wallpaper box")
                return
            self.load_image(img, note)
            self.generate()

        def load_image(self, p: Path, note: str = "") -> None:
            if not p.is_file():
                self.status(f"not a file: {p}")
                return
            if p.suffix.lower() in VIDEO_EXT - {".gif"}:
                fr = video_frame(p)
                if not fr:
                    self.status("video wallpaper but ffmpeg couldn't grab a frame")
                    return
                note = note or f"frame of {p.name}"
                p = fr
            self.img = p
            self.query_one("#wp-path", Input).value = str(p)
            r = self.pal.roles
            t = Text(no_wrap=True, overflow="ellipsis")
            t.append("image  ", style=r["fg_dim"])
            t.append(p.name, style=r["fg_bright"])
            if note:
                t.append(f"   {note}", style=r["fg_dim"])
            self.query_one("#wp-info", Static).update(t)

        def step_wallpaper(self, delta: int) -> None:
            files = list_wallpapers()
            if not files:
                self.status("no images in ~/Wallpapers")
                return
            try:
                i = (files.index(self.img) + delta) % len(files) if self.img in files else 0
            except ValueError:
                i = 0
            self.load_image(files[i], f"{i + 1}/{len(files)} in ~/Wallpapers")
            self.variant = 0
            self.generate()

        def action_wall_prev(self) -> None:
            self.step_wallpaper(-1)

        def action_wall_next(self) -> None:
            self.step_wallpaper(1)

        def action_generate(self) -> None:
            if self.img is None:
                self.action_use_current_key()
            else:
                self.generate()

        def action_next_variant(self) -> None:
            self.variant += 1
            if self.img:
                self.generate()
            else:
                self.action_use_current_key()

        def action_cycle_style(self) -> None:
            self.style_i = (self.style_i + 1) % len(STYLES)
            self.query_one("#wp-style", Act).set_label(f"style: {STYLES[self.style_i]}")
            if self.img:
                self.generate()

        def generate(self) -> None:
            if self.img is None or self.busy:
                return
            self.busy = True
            self.status("reading colors from the image…")
            self.gen_worker(self.img, STYLES[self.style_i], self.variant)

        @work(thread=True, exclusive=True)
        def gen_worker(self, img: Path, style: str, variant: int) -> None:
            try:
                cl = extract_clusters(img)
                pal = build_palette(cl, style, variant, name=img.stem)
                self.call_from_thread(self.gen_done, cl, pal, style, variant)
            except Exception as exc:   # noqa: BLE001
                self.call_from_thread(self.gen_fail, str(exc))

        def gen_fail(self, msg: str) -> None:
            self.busy = False
            self.status(f"couldn't read image: {msg}")

        def gen_done(self, cl, pal, style, variant) -> None:
            self.busy = False
            self.pal = pal
            self.refresh_all()
            self.refresh_wall_info(cl)
            self.status(f"{pal.name} · {style} · variant {variant} — a applies it, n tries another take")

        # ── apply / undo ──
        def action_apply_now(self) -> None:
            self.run_apply(dry=False)

        def action_dry_run(self) -> None:
            self.run_apply(dry=True)

        def action_toggle_repo(self) -> None:
            if not self.repo:
                self.status("no dotfiles repo found — start with --repo PATH or set RICE_REPO")
                return
            self.use_repo = not self.use_repo
            self.query_one("#tog-repo", Act).set_label(f"repo: {'ON' if self.use_repo else 'off'}")

        def action_toggle_reload(self) -> None:
            self.do_reload = not self.do_reload
            self.query_one("#tog-reload", Act).set_label(f"reload: {'on' if self.do_reload else 'OFF'}")

        def run_apply(self, dry: bool) -> None:
            if self.busy:
                self.status("still reading the wallpaper…")
                return
            keys = [t.key for t in TARGETS if t.key in self.sel_targets]
            if not keys:
                self.status("no targets selected")
                return
            log = self.query_one("#log", RichLog)
            log.clear()
            hook_msgs: list[str] = []
            results = apply_palette(self.pal, keys, self.repo if self.use_repo else None, dry,
                                    self.do_reload, hook_msgs.append)
            c = self.pal.roles
            glyph = {"ok": ("✓", c["success"]), "unchanged": ("·", c["fg_dim"]), "missing": ("–", c["fg_dim"]),
                     "error": ("✗", c["warning"])}
            for r in results:
                g, col = glyph.get(r.status, ("?", c["fg"]))
                short = r.path.replace("~/.config/", "").replace("~/.local/share/", "").replace("[repo] ", "repo:")
                row = Text(no_wrap=True, overflow="ellipsis")
                row.append(f"{g} ", style=f"bold {col}")
                row.append(f"{r.target:<10} ", style=c["fg"])
                row.append(short, style=c["fg_bright"] if r.status == "ok" else c["fg_dim"])
                if r.status in ("ok", "error") and r.detail:
                    row.append("  " + r.detail.split(" (")[0], style=c["fg_dim"])
                log.write(row)
            for m in hook_msgs:
                bad = "failed" in m
                log.write(Text(("! " if bad else "↻ ") + m.replace("reload: ", "").replace("reload ", ""),
                               style=c["warning"] if bad else c["fg_dim"], no_wrap=True, overflow="ellipsis"))
            ok = sum(1 for r in results if r.status == "ok")
            errors = sum(1 for r in results if r.status == "error")
            if dry:
                log.write("— dry run, nothing written —")
            else:
                if errors == 0 and any(r.status in {"ok", "unchanged"} for r in results):
                    self.applied = self.pal.copy()
                self.refresh_all()
                try:
                    self._state_mtime = STATE_FILE.stat().st_mtime
                except OSError:
                    pass
            self.status(f"{'would change' if dry else 'changed'} {ok} files" + (f" · {errors} failed" if errors else ""))

        def action_undo(self) -> None:
            log = self.query_one("#log", RichLog)
            msg = restore_last(self.do_reload, lambda m: log.write(m))
            log.write(msg)
            st = load_state()
            self.pal = finalize(Palette.from_dict(st["applied"]) if st.get("applied") else default_palette(), rederive=False)
            self.applied = self.pal.copy()
            self.refresh_all()
            self.refresh_wall_info()
            try:
                self._state_mtime = STATE_FILE.stat().st_mtime
            except OSError:
                pass
            self.status(msg)

        def check_external(self) -> None:
            """Another tool (CLI apply, undo, a second window) changed the rice → follow it."""
            try:
                m = STATE_FILE.stat().st_mtime
            except OSError:
                return
            if m == self._state_mtime:
                return
            self._state_mtime = m
            st = load_state()
            if not st.get("applied"):
                return
            new = finalize(Palette.from_dict(st["applied"]), rederive=False)
            if new.roles == self.applied.roles and new.ansi == self.applied.ansi:
                return
            was_dirty = self.dirty()
            self.applied = new.copy()
            if not was_dirty:
                self.pal = new
                self.refresh_all()
                self.refresh_wall_info()
                self.status("the rice changed outside the app — following it")
            else:
                self.status("the rice changed outside the app (your unsaved edits are kept)")

    ThemeSettings().run()
    return 0


def main() -> int:
    ap = argparse.ArgumentParser(prog="theme-settings", description="palette editor + wallpaper color generator")
    ap.add_argument("--wallpaper", action="store_true", help="build a palette from the current wallpaper")
    ap.add_argument("--image", metavar="FILE", help="build a palette from this image")
    ap.add_argument("--preset", metavar="NAME", help="use a saved preset (AliceNight = default theme)")
    ap.add_argument("--style", choices=STYLES, default="balanced")
    ap.add_argument("--variant", type=int, default=0, help="alternate take on the same image (0,1,2…)")
    ap.add_argument("--apply", action="store_true", help="write the palette into the rice")
    ap.add_argument("--targets", metavar="a,b,c", help="only these targets (see --list-targets)")
    ap.add_argument("--repo", metavar="PATH", help="dotfiles repo checkout; also updates it")
    ap.add_argument("--with-repo", action="store_true", help="also update the auto-detected dotfiles repo")
    ap.add_argument("--dry-run", action="store_true")
    ap.add_argument("--no-reload", action="store_true", help="don't signal running apps to reload")
    ap.add_argument("--restore", action="store_true", help="undo the last apply")
    ap.add_argument("--list-targets", action="store_true")
    ap.add_argument("--save-default", action="store_true",
                    help="snapshot the repo's current rice as the default theme (alice-rice/palette.json)")
    ap.add_argument("--show-default", action="store_true", help="print the default theme")
    args = ap.parse_args()
    if args.wallpaper or args.image or args.preset or args.restore or args.list_targets \
            or args.save_default or args.show_default:
        return main_cli(args)
    return run_tui(args)


if __name__ == "__main__":
    sys.exit(main())
