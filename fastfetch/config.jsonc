{
    "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

    "logo": {
    "type": "small",
    "source": "arch",
    "height": 3
    },

    "display": {
        "separator": "  "
    },

    "modules": [
        "title",
        "separator",
        {
            "type": "os",
            "key": "OS",
            "format": "{name}"
        },
        {
            "type": "host",
            "key": "Host"
        },
        {
            "type": "kernel",
            "key": "Kernel"
        },
        {
            "type": "uptime",
            "key": "Uptime"
        },
        {
            "type": "cpu",
            "key": "CPU"
        },
        {
            "type": "memory",
            "key": "RAM"
        },
        {
            "type": "gpu",
            "key": "GPU"
        },
        "separator",
        "break",
        "colors"
    ]
}
